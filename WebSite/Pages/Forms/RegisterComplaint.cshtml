<script src="~/plugins/jquery-validate/jquery.validate-1.19.5.min.js" asp-append-version="true"></script>
<script src="~/plugins/jquery-validate/jquery.validate.unobtrusive.min.js" asp-append-version="true"></script>
<script src="~/Sweetalert2/sweetalert2.js" asp-append-version="true"></script>
<script>

    var complaintSubmitted = $("#ComplaintSubmitted").val();

    // Display SweetAlert if the form was successfully submitted
    if (complaintSubmitted==1) {
        Swal.fire({
            icon: 'success',
            title: 'Your Complaint has been forwarded to CVO/MDL',
            allowEscapeKey: false,
            allowOutsideClick: false,
            text: 'Very shortly you will receive a “Complaint Tracking No.” on your E-mail ID. You can use the “Complaint Tracking No.” to check the status of your complaint on MDL Website.',
            didClose: (e) => {
                window.location.href = '/English/Forms/RegisterComplaint';
            },
            showClass: {
                popup: 'animate__animated animate__fadeInDown'
            },
            hideClass: {
                popup: 'animate__animated animate__fadeOutUp'
            }
        });
    }

    // Reset the TempData flag to avoid showing the alert on page refresh
    @(TempData["ComplaintSubmitted"] = null)

    $("#img-captcha,#captchaRefresh").click(function () {
        resetCaptchaImage();
            // setTimeout(() => speakCaptcha(), 300);
    });
    function resetCaptchaImage() {
        var d = new Date();
        $("#img-captcha").attr("src", "../Home/GetCaptchaImage?" + d.getTime());
    }

    $("#inlineCheckbox1").change(function () {
        if (this.checked) {
            $("#vigi_ShipBuildRelated").val(1);
        }
        else {
            $("#vigi_ShipBuildRelated").val(0);
        }
    });


    $("#inlineCheckbox2").change(function () {
        if (this.checked) {
            $("#vigi_SubHeavyRelated").val(1);
        }
        else {
            $("#vigi_SubHeavyRelated").val(0);
        }
    });

    $.validator.setDefaults({
        onkeyup: false
    })

    $('#vigi_UploadFile').on('change', function () {
        var fileUpload = $("#vigi_UploadFile").get(0);
        var files = fileUpload.files;
        var path = $("#vigi_UploadFile").val();
        var Filename = path.split('/').pop()
        var valid_extensions = /(\.pdf|\.PDF)$/i;

        if (valid_extensions.test(Filename)) {
            const size = (this.files[0].size / 1024 / 1024).toFixed(2);

            if (size > 1) {
                $('#vigi_UploadFile').val(null);
                alert("File size must be less than 3 MB");
            }
        }
        else {
            $('#vigi_UploadFile').val(null);
            alert("Please Upload a Valid File PDF Only");
        }
    });

    $('.vic').keyup(function (e) {
        var strg = this.value;
        var firstChar = strg.charAt(0);
        if ((firstChar == " ") || (firstChar == "&nbsp;") || (strg == "")) {
            this.value = this.value.replace(/\s/g, '');
        }
    });

    $("#btn_reset").click(function () {
        $("#vigi_Name").val("");
        $("#vigi_Designation").val("");
        $("#vigi_Organization").val("");
        $("#vigi_Email").val("");
        $("#vigi_Contact").val("");
        $("#vigi_Fax").val("");
        $("#vigi_PostalAddress").val("");
        $("#vigi_ComplaintDetails").val("");
        $("#vigi_CaptchaCode").val("");
        $("html, body").animate({ scrollTop: 0 }, "fast");
    });

    $('#vigi_CaptchaCode').on('blur', function () {
            var capcha = $(this).val();
            if (capcha.length > 0) {
                $.get("/English/Forms/Vigilance?handler=Validatecapcha", { CaptchaCode: capcha })
                    .done(function (data) {

                        if (data != capcha) {
                            $("#captchavalid").html("Please Enter Valid Captcha")
                            $("#vigi_CaptchaCode").val("");
                            resetCaptchaImage();
                        }
                    });
            }
        });

        
</script>