    }
    @(TempData["ComplaintSubmitted"] = null)

    // ═══════════════════════════════════════════════════════════
    //  STEP NAVIGATION
    // ═══════════════════════════════════════════════════════════
    function showStep(step) {
        $('#step1, #step2, #step3').hide();
        $('#step' + step).show();
        $('.step-item').removeClass('active completed');
        for (var i = 1; i <= 3; i++) {
            var $item = $('.step-item[data-step="' + i + '"]');
            if (i < step) $item.addClass('completed');
            else if (i == step) $item.addClass('active');
        }
        $("html, body").animate({ scrollTop: 0 }, "fast");
    }

    function showMsg(selector, message, type) {
        var cls = type === 'success' ? 'alert alert-success' : 'alert alert-danger';
        $(selector).html('<div class="' + cls + ' py-2 mb-0">' + message + '</div>');
    }

    // ═══════════════════════════════════════════════════════════
    //  STEP 1: SEND OTP
    // ═══════════════════════════════════════════════════════════
    $('#btnSendOtp').on('click', function () {
        var email = $('#step1Email').val().trim();
        if (!email) { showMsg('#step1Msg', IS_ENGLISH ? 'Please enter email.' : 'कृपया ई-मेल दर्ज करें।', 'danger'); return; }

        var emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
        if (!emailRegex.test(email)) {
            showMsg('#step1Msg', IS_ENGLISH ? 'Invalid email format.' : 'अमान्य ई-मेल प्रारूप।', 'danger');
            return;
        }

        var token = $('input[name="__RequestVerificationToken"]').val();
        var $btn = $(this).prop('disabled', true).text(IS_ENGLISH ? 'Sending...' : 'भेज रहे हैं...');

        $.ajax({
            type: "POST",
            url: window.location.pathname + "?handler=SendOtp",
            data: { email: email, __RequestVerificationToken: token },
            success: function (res) {
                if (res && res.message === "ALREADY_SUBMITTED") {
                    Swal.fire({
                        icon: 'info',
                        title: IS_ENGLISH ? 'Complaint Already Submitted' : 'शिकायत पहले ही जमा की जा चुकी है',
                        text: IS_ENGLISH
                            ? 'Your complaint has been submitted successfully from this email. Please wait 24 hours before submitting a new complaint.'
                            : 'इस ई-मेल से आपकी शिकायत सफलतापूर्वक जमा की जा चुकी है। कृपया नई शिकायत जमा करने से पहले 24 घंटे प्रतीक्षा करें।'
                    });
                    $btn.prop('disabled', false).text(IS_ENGLISH ? 'Send OTP' : 'OTP भेजें');
                    return;
                }

                if (res && res.success) {
                    showMsg('#step1Msg', res.message || 'OTP sent.', 'success');
                    $('#step2EmailLabel').text(email);
                    $('#step2Email').val(email);
                    $('#step2Otp').val('');
                    $('#step2Msg').html('');
                    resendUsed = 0;
                    updateResendInfo();
                    showStep(2);
                } else {
                    showMsg('#step1Msg', (res && res.message) || (IS_ENGLISH ? 'Failed to send OTP.' : 'OTP भेजने में विफल।'), 'danger');
                }
            },
            error: function (xhr) {
                var msg = IS_ENGLISH ? 'Failed to send OTP.' : 'OTP भेजने में विफल।';
                try {
                    var p = JSON.parse(xhr.responseText);
                    if (p && p.message) {
                        if (p.message === "ALREADY_SUBMITTED") {
                            Swal.fire({
                                icon: 'info',
                                title: IS_ENGLISH ? 'Complaint Already Submitted' : 'शिकायत पहले ही जमा की जा चुकी है',
                                text: IS_ENGLISH
                                    ? 'Your complaint has been submitted successfully from this email. Please wait 24 hours before submitting a new complaint.'
                                    : 'इस ई-मेल से आपकी शिकायत सफलतापूर्वक जमा की जा चुकी है।'
                            });
                            $btn.prop('disabled', false).text(IS_ENGLISH ? 'Send OTP' : 'OTP भेजें');
                            return;
                        }
                        msg = p.message;
                    }
                } catch (e) {}
                showMsg('#step1Msg', msg, 'danger');
            },
            complete: function () {
                $btn.prop('disabled', false).text(IS_ENGLISH ? 'Send OTP' : 'OTP भेजें');
            }
        });
    });

    $('#step1Email').on('keypress', function (e) {
        if (e.which === 13) { e.preventDefault(); $('#btnSendOtp').click(); }
    });

    // ═══════════════════════════════════════════════════════════
    //  STEP 2: VERIFY OTP
    // ═══════════════════════════════════════════════════════════
    $('#btnVerifyOtp').on('click', function () {
        var email = $('#step2Email').val();
        var otp = $('#step2Otp').val().trim();

        if (!otp || otp.length !== 6 || !/^\d+$/.test(otp)) {
            showMsg('#step2Msg', IS_ENGLISH ? 'Please enter a valid 6-digit OTP.' : 'कृपया 6 अंकों का OTP दर्ज करें।', 'danger');
            return;
        }

        var token = $('input[name="__RequestVerificationToken"]').val();
        var $btn = $(this).prop('disabled', true).text(IS_ENGLISH ? 'Verifying...' : 'सत्यापित...');

        $.ajax({
            type: "POST",
            url: window.location.pathname + "?handler=VerifyOtp",
            data: { email: email, otp: otp, __RequestVerificationToken: token },
            success: function (res) {
                if (res && res.success) {
                    showMsg('#step2Msg', res.message || 'Verified.', 'success');
                    setTimeout(function () {
                        $('#step3EmailInput').val(email);
                        showStep(3);
                    }, 400);
                } else {
                    showMsg('#step2Msg', (res && res.message) || (IS_ENGLISH ? 'Invalid OTP.' : 'अमान्य OTP।'), 'danger');
                }
            },
            error: function (xhr) {
                var msg = IS_ENGLISH ? 'Verification failed.' : 'सत्यापन विफल।';
                try { var p = JSON.parse(xhr.responseText); if (p && p.message) msg = p.message; } catch (e) {}
                showMsg('#step2Msg', msg, 'danger');
            },
            complete: function () {
                $btn.prop('disabled', false).text(IS_ENGLISH ? 'Verify OTP' : 'OTP सत्यापित करें');
            }
        });
    });

    $('#step2Otp').on('keypress', function (e) {
        if (e.which === 13) { e.preventDefault(); $('#btnVerifyOtp').click(); }
    });

    $('#step2Otp').on('input', function () {
        this.value = this.value.replace(/[^0-9]/g, '');
    });

    // ═══════════════════════════════════════════════════════════
    //  STEP 2: RESEND OTP
    // ═══════════════════════════════════════════════════════════
    $('#btnResendOtp').on('click', function () {
        var email = $('#step2Email').val();
        if (!email) return;

        var token = $('input[name="__RequestVerificationToken"]').val();
        var $btn = $(this).prop('disabled', true).text(IS_ENGLISH ? 'Sending...' : 'भेज रहे हैं...');

        $.ajax({
            type: "POST",
            url: window.location.pathname + "?handler=ResendOtp",
            data: { email: email, __RequestVerificationToken: token },
            success: function (res) {
                if (res && res.success) {
                    resendUsed++;
                    showMsg('#step2Msg', res.message || 'OTP resent.', 'success');
                    $('#step2Otp').val('');
                    updateResendInfo();
                } else {
                    showMsg('#step2Msg', (res && res.message) || (IS_ENGLISH ? 'Resend failed.' : 'पुनः भेजना विफल।'), 'danger');
                }
            },
            error: function (xhr) {
                var msg = IS_ENGLISH ? 'Resend failed.' : 'पुनः भेजना विफल।';
                try { var p = JSON.parse(xhr.responseText); if (p && p.message) msg = p.message; } catch (e) {}
                showMsg('#step2Msg', msg, 'danger');
            },
            complete: function () {
                $btn.prop('disabled', false).text(IS_ENGLISH ? 'Resend OTP' : 'OTP पुनः भेजें');
            }
        });
    });

    function updateResendInfo() {
        var left = RESEND_LIMIT - resendUsed;
        if (left <= 0) {
            $('#btnResendOtp').prop('disabled', true);
            $('#resendInfo').text(IS_ENGLISH ? 'Resend limit reached.' : 'पुनः भेजने की सीमा समाप्त।');
        } else {
            $('#resendInfo').text(IS_ENGLISH ? '(' + left + ' resend(s) left)' : '(' + left + ' पुनः भेजना शेष)');
        }
    }
    updateResendInfo();

    // ═══════════════════════════════════════════════════════════
    //  CAPTCHA
    // ═══════════════════════════════════════════════════════════
    $("#img-captcha, #captchaRefresh").click(function () {
        var d = new Date();
        $("#img-captcha").attr("src", "../Home/GetCaptchaImage?" + d.getTime());
    });

    $('#vigi_CaptchaCode').on('blur', function () {
        var capcha = $(this).val();
        if (capcha.length > 0) {
            $.get("?handler=Validatecapcha", { CaptchaCode: capcha })
                .done(function (data) {
                    if (data != capcha) {
                        $("#captchavalid").html(IS_ENGLISH ? "Please Enter Valid Captcha" : "कृपया वैध कैप्चा दर्ज करें");
                        $("#vigi_CaptchaCode").val("");
                        var d = new Date();
                        $("#img-captcha").attr("src", "../Home/GetCaptchaImage?" + d.getTime());
                    } else {
                        $("#captchavalid").html("");
                    }
                });
        }
    });

    // ═══════════════════════════════════════════════════════════
    //  RESET
    // ═══════════════════════════════════════════════════════════
    $("#btn_reset").click(function () {
        $("#vigi_Name").val("");
        $("#vigi_Designation").val("");
        $("#vigi_Organization").val("");
        $("#vigi_Contact").val("");
        $("#vigi_Fax").val("");
        $("#vigi_PostalAddress").val("");
        $("#vigi_ComplaintDetails").val("");
        $("#vigi_CaptchaCode").val("");
        $('.char-counter').each(function () {
            var id = $(this).data('for');
            var el = document.getElementById(id);
            if (el) updateCharCounter(el);
        });
        $('.field-error').text('');
        $('.is-invalid-custom').removeClass('is-invalid-custom');
        $("html, body").animate({ scrollTop: 0 }, "fast");
    });

    $.validator.setDefaults({ onkeyup: false });
</script>