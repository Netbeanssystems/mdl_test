@page "/{lang}/Forms/RegisterComplaint"
@using Microsoft.AspNetCore.Http;
@model WebSite.Pages.Forms.RegisterComplaintModel
@{
    Layout = "_InternalPagesLayout";
    bool isEnglish = HttpContext.Session.GetString("Lang") == null
                     || HttpContext.Session.GetString("Lang") == "English";
    ViewData["Title"] = isEnglish ? "Register Complaint" : "शिकायत दर्ज करें";
    var verifiedEmail = Model.VerifiedEmail;
    bool isVerified = !string.IsNullOrEmpty(verifiedEmail);
}
<link href="~/Sweetalert2/sweetalert2.css" rel="stylesheet" />
<link href="~/Sweetalert2/animate.css" rel="stylesheet" />
<input type="hidden" id="ComplaintSubmitted" value="@Model.ComplaintSubmitted" />
@Html.AntiForgeryToken()

@* ═══════════════ HERO ═══════════════ *@
@if (isEnglish)
{
    <div class="hero" style="position: relative;">
        <div class="item"><div class="heading">Register Complaint</div><img src="/assets/images/rti-banner.jpg" alt="" class="image1"></div>
        <div class="strip"><span><a href="/">Home</a> > About Us > <a href="/English/vigilance">Vigilance</a> > Register Complaint</span></div>
    </div>
}
else
{
    <div class="hero" style="position: relative;">
        <div class="item"><div class="heading">शिकायत दर्ज करना</div><img src="/assets/images/rti-banner.jpg" alt="" class="image1"></div>
        <div class="strip"><span><a href="/">मुख्य पृष्ठ</a> > हमारे बारे में > <a href="/English/vigilance">सतर्कता</a> > शिकायत दर्ज करना</span></div>
    </div>
}

<div class="mid-content">
    <div class="container">

        @* ═══════════════ INFO ═══════════════ *@
        @if (isEnglish)
        {
            <h5 class="main-head"><b>Register a Complaint Online</b></h5>
            <hr>
            <p>A complaint can be registered online on this website by filling up the details given in the form below. A complaint registered online herewith must contain name, postal address and contact details (phone no.) of the complainant as requested in the form.</p>
            <p>The complaint should be specific, brief and factual with verifiable facts supported by documentary evidences wherever possible.</p>
            <p>Complaints with irrelevant, vague, absurd or generalised allegations will be disposed at the discretion of the CVO.</p>
            <p>Anonymous / Pseudonymous complaints will not be considered for any action.</p>
            <p>(Ref. CVC Circular No.03/03/16 dated 07.03.2016)</p>
            <p>The complaint can be registered online by filling and submitting the following form.</p>
            <p>(Kindly fill all details)</p>
        }
        else
        {
            <h5 class="main-head"><b>शिकायत दर्ज करना</b></h5>
            <hr>
            <p>शिकायत इस वेबसाइट पर निम्नलिखित फॉर्म में दिए गए विवरण भरकर ऑनलाइन दर्ज की जा सकती है। ऑनलाइन शिकायत दर्ज करते समय, फॉर्म में मांगी गई जानकारी के अनुसार शिकायतकर्ता का नाम, पोस्टल पता और संपर्क विवरण (फोन नंबर) होना आवश्यक है।</p>
            <p>शिकायत विशिष्ट, संक्षिप्त और तथ्यों पर आधारित होनी चाहिए।</p>
            <p>निराधार, अस्पष्ट या सामान्य आरोपों वाली शिकायतों का सीवीओ के विवेक पर निपटारा किया जाएगा।</p>
            <p>गुमनाम / उपनाम वाली शिकायतों पर कोई कार्रवाई नहीं की जाएगी।</p>
            <p>(संदर्भ: सीवीसी परिपत्र संख्या 03/03/16 दिनांक 07.03.2016)</p>
            <p>(कृपया सभी विवरण भरें)</p>
        }

        @* ═══════════════ STEP INDICATOR ═══════════════ *@
        <div class="step-wrapper mb-4">
            <div class="step-item @(isVerified ? "completed" : "active")" data-step="1">
                <span class="step-circle">1</span>
                <span class="step-label">@(isEnglish ? "Verify Email" : "ई-मेल सत्यापित करें")</span>
            </div>
            <div class="step-item @(isVerified ? "completed" : "")" data-step="2">
                <span class="step-circle">2</span>
                <span class="step-label">@(isEnglish ? "Enter OTP" : "OTP दर्ज करें")</span>
            </div>
            <div class="step-item @(isVerified ? "active" : "")" data-step="3">
                <span class="step-circle">3</span>
                <span class="step-label">@(isEnglish ? "Fill Form" : "फॉर्म भरें")</span>
            </div>
        </div>

        @* ═══════════════ STEP 1: EMAIL ═══════════════ *@
        <div id="step1" class="wizard-step" style="@(isVerified ? "display:none;" : "")">
            <div class="row">
                <div class="col-md-12 mb-4">
                    <div class="card p-4">
                        <h5>@(isEnglish ? "Step 1: Verify your Email" : "चरण 1: अपना ई-मेल सत्यापित करें")</h5>
                        <p class="text-muted">
                            @(isEnglish
                                ? "Enter your email ID. We will send a 6-digit OTP to verify your email."
                                : "अपनी ई-मेल आईडी दर्ज करें। हम सत्यापन के लिए 6 अंकों का OTP भेजेंगे।")
                        </p>
                        <div class="row g-3">
                            <div class="col-md-8">
                                <label class="form-label">@(isEnglish ? "E-Mail" : "ई-मेल") <span class="astricks">*</span></label>
                                <input type="email" id="step1Email" class="form-control"
                                       placeholder="you@example.com" autocomplete="off" maxlength="100" />
                            </div>
                            <div class="col-md-4 d-flex align-items-end">
                                <button type="button" id="btnSendOtp" class="btn btn-primary w-100">
                                    @(isEnglish ? "Send OTP" : "OTP भेजें")
                                </button>
                            </div>
                        </div>
                        <div id="step1Msg" class="mt-3"></div>
                    </div>
                </div>
            </div>
        </div>

        @* ═══════════════ STEP 2: OTP ═══════════════ *@
        <div id="step2" class="wizard-step" style="display:none;">
            <div class="row">
                <div class="col-md-12 mb-4">
                    <div class="card p-4">
                        <h5>@(isEnglish ? "Step 2: Enter OTP" : "चरण 2: OTP दर्ज करें")</h5>
                        <p class="text-muted">
                            @(isEnglish
                                ? "Enter the 6-digit OTP sent to your email. It is valid for 10 minutes."
                                : "अपनी ई-मेल पर भेजा गया 6 अंकों का OTP दर्ज करें। यह 10 मिनट के लिए मान्य है।")
                        </p>
                        <p><b>@(isEnglish ? "Email:" : "ई-मेल:")</b> <span id="step2EmailLabel"></span></p>
                        <input type="hidden" id="step2Email" />

                        <div class="row g-3">
                            <div class="col-md-8">
                                <label class="form-label">OTP <span class="astricks">*</span></label>
                                <input type="text" id="step2Otp" class="form-control" maxlength="6"
                                       placeholder="123456" autocomplete="off" inputmode="numeric" />
                            </div>
                            <div class="col-md-4 d-flex align-items-end">
                                <button type="button" id="btnVerifyOtp" class="btn btn-success w-100">
                                    @(isEnglish ? "Verify OTP" : "OTP सत्यापित करें")
                                </button>
                            </div>
                        </div>

                        <div class="mt-3">
                            <button type="button" id="btnResendOtp" class="btn btn-outline-secondary btn-sm">
                                @(isEnglish ? "Resend OTP" : "OTP पुनः भेजें")
                            </button>
                            <span id="resendInfo" class="ms-2 text-muted"></span>
                        </div>

                        <div id="step2Msg" class="mt-3"></div>
                    </div>
                </div>
            </div>
        </div>

        @* ═══════════════ STEP 3: FULL FORM ═══════════════ *@
        <div id="step3" class="wizard-step" style="@(isVerified ? "" : "display:none;")">
            <div class="row">
                <div class="col-md-12 mb-4">
                    <form method="post" class="row g-3" asp-page-handler="Complaint"
                          enctype="multipart/form-data" id="complaintForm" novalidate>

                        <span style="font-size:medium;">
                            <b>@(isEnglish ? "NOTE :" : "नोट :")</b>
                            @(isEnglish
                                ? "All special characters like (>, <, =, $, ;, %, ^, :, &, *, ',' , [, ], {, }, +, -, _ ) etc. are not allowed. Multiple spaces, repeated characters (aaa, bbb) and gibberish words (test, asdf, dummy) are not allowed."
                                : "सभी विशिष्ट चिह्न जैसे (>,=,$,;,%,^,:,&,*,\",[,],{,},+,-,_) आदि की अनुमति नहीं है। कई स्पेस, दोहराए गए अक्षर (aaa, bbb) और अर्थहीन शब्द (test, asdf, dummy) की अनुमति नहीं है।")
                        </span>
                        <p>(<span class="astricks">*</span>) @(isEnglish ? "Information Required" : "आवश्यक जानकारी")</p>

                        <input type="hidden" asp-for="vigi.ShipBuildRelated" value="0" />
                        <input type="hidden" asp-for="vigi.SubHeavyRelated" value="0" />

                        @* ── Verified Email (readonly) ── *@
                        <div class="col-md-4">
                            <label asp-for="vigi.Email" class="form-label">
                                @(isEnglish ? "E-Mail (Verified)" : "ई-मेल (सत्यापित)") <span class="astricks">*</span>
                            </label>
                            <input asp-for="vigi.Email" id="step3EmailInput" class="form-control"
                                   value="@verifiedEmail" readonly
                                   style="background-color:#e9ecef; cursor:not-allowed;" />
                            <span asp-validation-for="vigi.Email" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="vigi.Name" class="form-label">@(isEnglish ? "Name" : "नाम")<span class="astricks">*</span></label>
                            <input asp-for="vigi.Name" id="vigi_Name" autocomplete="off"
                                   placeholder="@(isEnglish ? "Enter your full name" : "अपना पूरा नाम दर्ज करें")"
                                   data-rule="name"
                                   data-min="2"
                                   class="form-control vic" maxlength="50"
                                   oninput="cleanInput(this, 'alphanumeric')" />
                            <small class="text-muted char-counter" data-for="vigi_Name" data-max="50" data-min="2">0 / 50 (min 2)</small>
                            <span asp-validation-for="vigi.Name" class="text-danger field-error"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="vigi.Designation" class="form-label">@(isEnglish ? "Designation" : "पदनाम")<span class="astricks">*</span></label>
                            <input asp-for="vigi.Designation" id="vigi_Designation" autocomplete="off"
                                   placeholder="@(isEnglish ? "Enter your designation" : "अपना पदनाम दर्ज करें")"
                                   data-rule="designation"
                                   data-min="2"
                                   class="form-control vic" maxlength="50"
                                   oninput="cleanInput(this, 'alphanumeric')" />
                            <small class="text-muted char-counter" data-for="vigi_Designation" data-max="50" data-min="2">0 / 50 (min 2)</small>
                            <span asp-validation-for="vigi.Designation" class="text-danger field-error"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="vigi.Organization" class="form-label">@(isEnglish ? "Organization" : "संगठन")<span class="astricks">*</span></label>
                            <input asp-for="vigi.Organization" id="vigi_Organization" autocomplete="off"
                                   placeholder="@(isEnglish ? "Enter full form of organization (e.g., Mazagon Dock Shipbuilders Limited) — not abbreviation like MDL" : "संगठन का पूरा नाम दर्ज करें (जैसे माझगांव डॉक शिपबिल्डर्स लिमिटेड) — संक्षेप नहीं जैसे MDL")"
                                   data-rule="organization"
                                   data-min="2"
                                   class="form-control vic" maxlength="100"
                                   oninput="cleanInput(this, 'alphanumeric')" />
                            <small class="text-muted char-counter" data-for="vigi_Organization" data-max="100" data-min="2">0 / 100 (min 2)</small>
                            <span asp-validation-for="vigi.Organization" class="text-danger field-error"></span>
                        </div>

                        <div class="col-4">
                            <label asp-for="vigi.Contact" class="form-label">@(isEnglish ? "Mobile No" : "मोबाइल नं")<span class="astricks">*</span></label>
                            <input asp-for="vigi.Contact" id="vigi_Contact" autocomplete="off"
                                   placeholder="9342397423"
                                   data-rule="contact"
                                   data-min="10"
                                   class="form-control vic" maxlength="15"
                                   oninput="cleanInput(this, 'mobile')" />
                            <small class="text-muted char-counter" data-for="vigi_Contact" data-max="15" data-min="10">0 / 15 (min 10)</small>
                            <span asp-validation-for="vigi.Contact" class="text-danger field-error"></span>
                        </div>
                        <div class="col-4">
                            <label asp-for="vigi.Fax" class="form-label">@(isEnglish ? "Fax No (Optional)" : "फैक्स नं (वैकल्पिक)")</label>
                            <input asp-for="vigi.Fax" id="vigi_Fax" autocomplete="off"
                                   class="form-control vic"
                                   placeholder="@(isEnglish ? "Fax No" : "फैक्स नं")" maxlength="15"
                                   data-rule="fax"
                                   data-min="7"
                                   oninput="cleanInput(this, 'fax')" />
                            <small class="text-muted char-counter" data-for="vigi_Fax" data-max="15" data-min="7">0 / 15 (min 7)</small>
                            <span asp-validation-for="vigi.Fax" class="text-danger field-error"></span>
                        </div>

                        <div class="col-6">
                            <label asp-for="vigi.PostalAddress" class="form-label">@(isEnglish ? "Postal Address" : "पता")<span class="astricks">*</span></label>
                            <textarea class="form-control vic" autocomplete="off"
                                      id="vigi_PostalAddress"
                                      placeholder="@(isEnglish ? "Postal Address" : "पता")"
                                      data-rule="address"
                                      data-min="10"
                                      oninput="cleanInput(this, 'alphanumeric')"
                                      asp-for="vigi.PostalAddress" maxlength="200" rows="3"></textarea>
                            <small class="text-muted char-counter" data-for="vigi_PostalAddress" data-max="200" data-min="10">0 / 200 (min 10)</small>
                            <span asp-validation-for="vigi.PostalAddress" class="text-danger field-error"></span>
                        </div>
                        <div class="col-6">
                            <label asp-for="vigi.ComplaintDetails" class="form-label">@(isEnglish ? "Complaint details" : "शिकायत")<span class="astricks">*</span></label>
                            <textarea class="form-control vic" autocomplete="off"
                                      id="vigi_ComplaintDetails"
                                      placeholder="@(isEnglish ? "Complaint details" : "शिकायत")"
                                      data-rule="complaint"
                                      data-min="100"
                                      oninput="cleanInput(this, 'alphanumeric')"
                                      asp-for="vigi.ComplaintDetails" maxlength="1000" rows="3"></textarea>
                            <small class="text-muted char-counter" data-for="vigi_ComplaintDetails" data-max="1000" data-min="100">0 / 1000 (min 100)</small>
                            <span asp-validation-for="vigi.ComplaintDetails" class="text-danger field-error"></span>
                        </div>

                        <div class="col-4">
                            <label>@(isEnglish ? "Captcha" : "कैप्चा") <span class="astricks">*</span></label>
                            <div class="form-group mt-3">
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <img id="img-captcha" src="../Home/GetCaptchaImage" alt="captcha" />
                                    </div>
                                    <button type="button" onclick="speakCaptcha()">🔊</button>
                                    <input type="text" class="form-control"
                                           placeholder="@(isEnglish ? "Captcha Code" : "कैप्चा कोड")"
                                           asp-for="vigi.CaptchaCode" />
                                    <div class="input-group-append" title="Refresh Captcha">
                                        <div class="input-group-text" tabindex="0">
                                            <button id="captchaRefresh" class="fa fa-refresh" type="button"></button>
                                        </div>
                                    </div>
                                </div>
                                <span id="captchavalid" asp-validation-for="vigi.CaptchaCode" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-12">
                            <button type="submit" class="btn btn-primary">@(isEnglish ? "Submit" : "जमा करें")</button>
                            <button type="button" id="btn_reset" class="btn btn-secondary">@(isEnglish ? "Reset" : "रीसेट करें")</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

    </div>
</div>

@* ═══════════════ STYLES ═══════════════ *@
<style>
    .step-wrapper {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px 0;
        border-bottom: 1px solid #dee2e6;
    }

    .step-item {
        text-align: center;
        flex: 1;
        opacity: 0.45;
        transition: opacity 0.3s;
    }

        .step-item.active {
            opacity: 1;
        }

        .step-item.completed {
            opacity: 0.85;
        }

            .step-item.completed .step-circle {
                background: #28a745;
            }

        .step-item.active .step-circle {
            background: #0d6efd;
            box-shadow: 0 0 0 4px rgba(13,110,253,0.15);
        }

    .step-circle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 42px;
        height: 42px;
        line-height: 1;
        border-radius: 50%;
        background: #adb5bd;
        color: #fff;
        font-weight: bold;
        font-size: 18px;
        margin-bottom: 6px;
    }

    .step-label {
        display: block;
        font-size: 14px;
        font-weight: 500;
        color: #333;
    }

    .wizard-step {
        animation: fadeIn 0.3s ease-in;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    @@media (max-width: 576px) {
        .step-label {
            font-size: 11px;
        }

        .step-circle {
            width: 34px;
            height: 34px;
            font-size: 14px;
        }
    }

    .field-error {
        font-size: 13px;
        display: block;
        margin-top: 3px;
    }

    .form-control.is-invalid-custom {
        border-color: #dc3545;
    }

    .char-counter {
        display: block;
        font-size: 11px;
        color: #6c757d;
        text-align: right;
        margin-top: 2px;
    }

        .char-counter.warn {
            color: #fd7e14;
        }

        .char-counter.danger {
            color: #dc3545;
        }
</style>

@* ═══════════════ SCRIPTS ═══════════════ *@
<script src="~/js/jquery-3.6.4.min.js" asp-append-version="true"></script>
<script src="~/plugins/jquery-validate/jquery.validate-1.19.5.min.js" asp-append-version="true"></script>
<script src="~/plugins/jquery-validate/jquery.validate.unobtrusive.min.js" asp-append-version="true"></script>
<script src="~/Sweetalert2/sweetalert2.js" asp-append-version="true"></script>

<script>
    // ═══════════════════════════════════════════════════════════
    //  CONFIG
    // ═══════════════════════════════════════════════════════════
    var IS_ENGLISH = @(isEnglish.ToString().ToLower());
    var RESEND_LIMIT = 3;
    var resendUsed = 0;

    // ═══════════════════════════════════════════════════════════
    //  ANTIFORGERY TOKEN
    // ═══════════════════════════════════════════════════════════
    var ANTI_FORGERY_TOKEN = $('input[name="__RequestVerificationToken"]').val();

    // ═══════════════════════════════════════════════════════════
    //  CHARACTER COUNTER — current / max (min N)
    // ═══════════════════════════════════════════════════════════
    function updateCharCounter(el) {
        var id = el.id;
        var max = parseInt(el.getAttribute('maxlength')) || 0;
        var min = parseInt(el.getAttribute('data-min')) || 0;
        var len = el.value ? el.value.length : 0;

        var $counter = $('.char-counter[data-for="' + id + '"]');
        if ($counter.length === 0) return;

        var text = len + ' / ' + max;
        if (min > 0) text += ' (min ' + min + ')';

        $counter.text(text);
        $counter.removeClass('warn danger');

        if (min > 0 && len > 0 && len < min) {
            $counter.addClass('danger');
            return;
        }

        if (max > 0) {
            var ratio = len / max;
            if (ratio >= 1) $counter.addClass('danger');
            else if (ratio >= 0.8) $counter.addClass('warn');
        }
    }

    $(document).ready(function () {
        $('.char-counter').each(function () {
            var id = $(this).data('for');
            var el = document.getElementById(id);
            if (el) updateCharCounter(el);
        });
    });

    // ═══════════════════════════════════════════════════════════
    //  GIBBERISH DETECTION — v3.0 (No bypass, pure algorithmic)
    // ═══════════════════════════════════════════════════════════
    var BASE_VOWELS = 'aeiou';
    var CONSONANTS_REGEX = /[bcdfghjklmnpqrstvwxyz]/i;

    // ─── Keyboard rows (for walk detection) ───
    var KBD_ROWS = ['qwertyuiop', 'asdfghjkl', 'zxcvbnm'];
    var KBD_ROWS_REV = KBD_ROWS.map(function (r) {
        return r.split('').reverse().join('');
    });

    // Longest contiguous substring of `s` that appears (fwd or rev) on a keyboard row
    function maxKeyboardRowWalk(s) {
        if (!s || s.length < 3) return 0;
        var maxWalk = 0;
        for (var r = 0; r < KBD_ROWS.length; r++) {
            var fwd = KBD_ROWS[r];
            var rev = KBD_ROWS_REV[r];
            for (var i = 0; i < s.length; i++) {
                for (var j = i + 3; j <= s.length; j++) {
                    var sub = s.substring(i, j);
                    if (fwd.indexOf(sub) !== -1 || rev.indexOf(sub) !== -1) {
                        if (sub.length > maxWalk) maxWalk = sub.length;
                    }
                }
            }
        }
        return maxWalk;
    }

    // Smart Y — context-aware vowel detection
    function isVowelAt(s, i) {
        var ch = s[i].toLowerCase();
        if (BASE_VOWELS.indexOf(ch) !== -1) return true;

        if (ch === 'y') {
            if (i === 0) return false;  // yes, Yamuna, Yogesh
            var prev = s[i - 1];
            var next = i < s.length - 1 ? s[i + 1] : null;
            if (next === null) return true;  // baby, happy, sky
            if (CONSONANTS_REGEX.test(prev) && CONSONANTS_REGEX.test(next)) return true;  // rhythm, myth
            return false;
        }
        return false;
    }

    function countVowels(s) {
        var count = 0;
        for (var i = 0; i < s.length; i++) {
            if (isVowelAt(s, i)) count++;
        }
        return count;
    }

    function maxConsecutiveConsonants(s) {
        var maxRun = 0, currentRun = 0;
        for (var i = 0; i < s.length; i++) {
            if (/[a-z]/i.test(s[i]) && !isVowelAt(s, i)) {
                currentRun++;
                if (currentRun > maxRun) maxRun = currentRun;
            } else {
                currentRun = 0;
            }
        }
        return maxRun;
    }

    function maxConsecutiveVowels(s) {
        var maxRun = 0, currentRun = 0;
        for (var i = 0; i < s.length; i++) {
            if (isVowelAt(s, i)) {
                currentRun++;
                if (currentRun > maxRun) maxRun = currentRun;
            } else {
                currentRun = 0;
            }
        }
        return maxRun;
    }

    // ═══════════════════════════════════════════════════════════
    //  GIBBERISH ENGINE — every word goes through this. No bypass.
    // ═══════════════════════════════════════════════════════════
    function analyzeWord(word, fieldConfig) {
        fieldConfig = fieldConfig || { threshold: 3 };

        var letters = (word || '').replace(/[^a-z]/gi, '').toLowerCase();
        var len = letters.length;

        if (len < 3) {
            return { gibberish: false, score: 0, reason: 'too-short' };
        }

        var vowels = countVowels(letters);
        var consonants = len - vowels;
        var score = 0;
        var reasons = [];

        // Rule 1: Zero vowels + long consonant run (real acronyms like NTPC/HPCL avoided)
        if (vowels === 0 && len >= 4 && maxConsecutiveConsonants(letters) >= 5) {
            score += 3;
            reasons.push('no-vowels-long-cons');
        }

        // Rule 2: Consonant/Vowel ratio
        if (vowels > 0) {
            var ratio = consonants / vowels;
            if (len <= 5 && ratio > 4) { score += 2; reasons.push('ratio-high'); }
            else if (len <= 8 && ratio > 3.5) { score += 2; reasons.push('ratio-mid'); }
            else if (len > 8 && ratio > 3) { score += 1; reasons.push('ratio-long'); }
        }

        // Rule 3: Consecutive consonants
        var maxConsRun = maxConsecutiveConsonants(letters);
        if (maxConsRun >= 7) { score += 3; reasons.push('cons-run-7plus'); }
        else if (maxConsRun >= 6) { score += 2; reasons.push('cons-run-6'); }
        else if (maxConsRun >= 5 && len <= 6) { score += 1; reasons.push('cons-run-5-short'); }

        // Rule 4: Consecutive vowels
        var maxVowRun = maxConsecutiveVowels(letters);
        if (maxVowRun >= 4 && len <= 8) { score += 2; reasons.push('vow-run-4'); }

        // Rule 5: Keyboard-row walk penalty (SDFGHJ, QWERT, LKJHGF, ZXCVB, ...)
        var kbdWalk = maxKeyboardRowWalk(letters);
        if (kbdWalk >= 5) { score += 4; reasons.push('kbd-walk-' + kbdWalk); }
        else if (kbdWalk >= 4) { score += 3; reasons.push('kbd-walk-' + kbdWalk); }
        else if (kbdWalk >= 3) { score += 1; reasons.push('kbd-walk-' + kbdWalk); }

        var threshold = fieldConfig.threshold || 3;
        return {
            gibberish: score >= threshold,
            score: score,
            reason: reasons.join(' + ') || 'clean'
        };
    }

    function isGibberishText(text, fieldConfig) {
        if (!text) return false;
        var words = text.trim().split(/\s+/).filter(Boolean);
        for (var i = 0; i < words.length; i++) {
            if (analyzeWord(words[i], fieldConfig).gibberish) return true;
        }
        return false;
    }

    var FIELD_CONFIGS = {
        name:         { threshold: 3 },
        designation:  { threshold: 3 },
        organization: { threshold: 3 },
        address:      { threshold: 4 },  // Lenient
        complaint:    { threshold: 4 }   // Lenient
    };

    // ═══════════════════════════════════════════════════════════
    //  BUSINESS VALIDATION HELPERS
    // ═══════════════════════════════════════════════════════════
    var PLACEHOLDER_WORDS = [
        'test', 'testing', 'asdf', 'asdfasdf', 'none', 'na', 'n/a',
        'admin', 'dummy', 'sample', 'demo', 'xyz', 'abc', 'abcd',
        'user', 'guest', 'fake', 'null', 'undefined',
        'aaa', 'bbb', 'ccc', 'ddd', 'eee', 'fff'
    ];
    var KEYBOARD_WALKS = ['qwerty', 'qwertyuiop', 'asdf', 'asdfgh', 'zxcv', 'zxcvbn', 'qaz', 'wsx', 'edc'];

    // ─── Valid repeat acronyms (3+ identical letters allowed) ───
    var VALID_REPEAT_ACRONYMS = [
        'WWW',   // World Wide Web
        'BBB',   // Better Business Bureau
        'CCC',   // Civilian Conservation Corps
        'MMM',   // 3M / Minnesota Mining & Manufacturing
        'HHH',   // Person name / sound
        'TTT',   // Rare but valid
        'III'    // Roman numeral — Phase III, Sector III
    ];

    function hasConsecutiveRepeats(s, maxRepeat) {
        if (!s) return false;
        maxRepeat = maxRepeat || 2;
        var re = new RegExp('(.)\\1{' + maxRepeat + ',}', 'i');
        return re.test(s);
    }

    function isAllowedRepeatAcronym(word) {
        if (!word) return false;
        var alpha = word.replace(/[^a-zA-Z]/g, '');
        if (alpha.length < 2 || alpha.length > 6) return false;
        if (alpha !== alpha.toUpperCase()) return false;
        return VALID_REPEAT_ACRONYMS.indexOf(alpha) !== -1;
    }

    function hasBlockedRepeats(s) {
        if (!s) return false;
        var words = s.split(/\s+/).filter(Boolean);
        for (var i = 0; i < words.length; i++) {
            var alpha = words[i].replace(/[^a-zA-Z]/g, '');
            if (!/([a-zA-Z])\1{2,}/.test(alpha)) continue;
            if (isAllowedRepeatAcronym(alpha)) continue;
            return true;
        }
        return false;
    }

    function hasMultipleSpaces(s) { return /\s{2,}/.test(s); }

    function isPlaceholderWord(s) {
        if (!s) return false;
        return PLACEHOLDER_WORDS.indexOf(s.trim().toLowerCase()) !== -1;
    }

    function containsPlaceholderWord(s) {
        if (!s) return false;
        var words = s.trim().toLowerCase().split(/\s+/);
        for (var i = 0; i < words.length; i++) {
            if (PLACEHOLDER_WORDS.indexOf(words[i]) !== -1) return true;
        }
        return false;
    }

    function isKeyboardWalk(s) {
        if (!s) return false;
        var lower = s.trim().toLowerCase().replace(/\s+/g, '');
        for (var i = 0; i < KEYBOARD_WALKS.length; i++) {
            if (lower.indexOf(KEYBOARD_WALKS[i]) !== -1) return true;
        }
        return false;
    }

    function isPureNumeric(s) {
        if (!s) return false;
        return /^\d+$/.test(s.trim());
    }

    function uniqueWordPercent(s) {
        if (!s) return 0;
        var words = s.trim().toLowerCase().split(/\s+/).filter(Boolean);
        if (words.length < 3) return 100;
        var uniq = {};
        for (var i = 0; i < words.length; i++) uniq[words[i]] = true;
        return (Object.keys(uniq).length / words.length) * 100;
    }

    function isRepeatingOrSequential(digits) {
        if (!digits || digits.length < 4) return false;
        if (/^(\d)\1+$/.test(digits)) return true;

        var known = ['1234567890','0123456789','9876543210','0987654321',
                     '123456789','987654321','12345678','23456789'];
        if (known.indexOf(digits) !== -1) return true;

        var seqIncWrap = true, seqDecWrap = true;
        for (var i = 1; i < digits.length; i++) {
            var d1 = parseInt(digits[i-1], 10);
            var d2 = parseInt(digits[i], 10);
            if ((d2 - d1 + 10) % 10 !== 1) seqIncWrap = false;
            if ((d1 - d2 + 10) % 10 !== 1) seqDecWrap = false;
        }
        if (seqIncWrap || seqDecWrap) return true;

        var half = Math.floor(digits.length / 2);
        for (var len = 1; len <= half; len++) {
            var block = digits.substring(0, len);
            var repeated = '';
            while (repeated.length < digits.length) repeated += block;
            repeated = repeated.substring(0, digits.length);
            if (repeated === digits) return true;
        }

        if (digits.length >= 6) {
            var alt = true;
            for (var k = 2; k < digits.length; k++) {
                if (digits[k] !== digits[k-2]) { alt = false; break; }
            }
            if (alt) return true;
        }

        return false;
    }

    // ═══════════════════════════════════════════════════════════
    //  FIELD VALIDATOR — regex first, gibberish LAST
    // ═══════════════════════════════════════════════════════════
    function validateField(rule, value) {
        var v = (value || '').trim();
        var t = IS_ENGLISH;

        if (rule !== 'fax' && !v) {
            return { valid: false, msg: t ? 'This field is required.' : 'यह फ़ील्ड आवश्यक है।' };
        }

        switch (rule) {

            case 'name':
                if (v.length < 2) return { valid: false, msg: t ? 'Name must be at least 2 characters.' : 'नाम कम से कम 2 अक्षरों का होना चाहिए।' };
                if (v.length > 50) return { valid: false, msg: t ? 'Name must be at most 50 characters.' : 'नाम अधिकतम 50 अक्षरों का हो सकता है।' };
                if (!/^[a-zA-Z][a-zA-Z\s.'-]*$/.test(v)) return { valid: false, msg: t ? 'Only letters, spaces, dot, apostrophe, hyphen allowed.' : 'केवल अक्षर, स्पेस, डॉट, अपॉस्ट्रॉफी, हाइफ़न की अनुमति है।' };
                if (hasBlockedRepeats(v)) return { valid: false, msg: t ? 'Repeated characters like "aaa", "bbb" are not allowed.' : '"aaa", "bbb" जैसे दोहराए गए अक्षर की अनुमति नहीं है।' };
                if (isPlaceholderWord(v) || containsPlaceholderWord(v)) return { valid: false, msg: t ? 'Placeholder words like "test", "dummy" are not allowed.' : '"test", "dummy" जैसे प्लेसहोल्डर शब्द की अनुमति नहीं है।' };
                if (isKeyboardWalk(v)) return { valid: false, msg: t ? 'Keyboard patterns like "qwerty" are not allowed.' : '"qwerty" जैसे कीबोर्ड पैटर्न की अनुमति नहीं है।' };
                if (isGibberishText(v, FIELD_CONFIGS.name)) return { valid: false, msg: t ? 'Name looks like gibberish. Please enter a valid name.' : 'नाम अर्थहीन लग रहा है। कृपया वैध नाम दर्ज करें।' };
                return { valid: true, msg: '' };

            case 'designation':
                if (v.length < 2) return { valid: false, msg: t ? 'Designation must be at least 2 characters.' : 'पदनाम कम से कम 2 अक्षरों का होना चाहिए।' };
                if (v.length > 50) return { valid: false, msg: t ? 'Designation must be at most 50 characters.' : 'पदनाम अधिकतम 50 अक्षरों का हो सकता है।' };
                if (isPureNumeric(v)) return { valid: false, msg: t ? 'Designation cannot be pure numeric.' : 'पदनाम केवल संख्याओं का नहीं हो सकता।' };
                if (hasBlockedRepeats(v)) return { valid: false, msg: t ? 'Repeated characters are not allowed.' : 'दोहराए गए अक्षर की अनुमति नहीं है।' };
                if (isKeyboardWalk(v)) return { valid: false, msg: t ? 'Keyboard walks like "qwerty" are not allowed.' : '"qwerty" जैसे कीबोर्ड वॉक की अनुमति नहीं है।' };
                if (isPlaceholderWord(v) || containsPlaceholderWord(v)) return { valid: false, msg: t ? 'Placeholder words are not allowed.' : 'प्लेसहोल्डर शब्द की अनुमति नहीं है।' };
                if (isGibberishText(v, FIELD_CONFIGS.designation)) return { valid: false, msg: t ? 'Designation looks like gibberish.' : 'पदनाम अर्थहीन लग रहा है।' };
                return { valid: true, msg: '' };

            case 'organization':
                if (v.length < 2) return { valid: false, msg: t ? 'Organization must be at least 2 characters.' : 'संगठन कम से कम 2 अक्षरों का होना चाहिए।' };
                if (v.length > 100) return { valid: false, msg: t ? 'Organization must be at most 100 characters.' : 'संगठन अधिकतम 100 अक्षरों का हो सकता है।' };
                if (hasBlockedRepeats(v)) return { valid: false, msg: t ? 'Repeated characters are not allowed.' : 'दोहराए गए अक्षर की अनुमति नहीं है।' };
                if (isPlaceholderWord(v) || containsPlaceholderWord(v)) return { valid: false, msg: t ? 'Placeholder words like "test", "xyz" are not allowed.' : '"test", "xyz" जैसे प्लेसहोल्डर शब्द की अनुमति नहीं है।' };
                if (isKeyboardWalk(v)) return { valid: false, msg: t ? 'Keyboard patterns are not allowed.' : 'कीबोर्ड पैटर्न की अनुमति नहीं है।' };
                var lowerOrg = v.toLowerCase();
                if (lowerOrg === 'test corp' || lowerOrg === 'xyz inc') return { valid: false, msg: t ? 'Test organization names are not allowed.' : 'टेस्ट संगठन नाम की अनुमति नहीं है।' };
                if (isGibberishText(v, FIELD_CONFIGS.organization)) return { valid: false, msg: t ? 'Organization name looks like gibberish. Please enter the full organization name.' : 'संगठन का नाम अर्थहीन लग रहा है। कृपया पूरा नाम दर्ज करें।' };
                return { valid: true, msg: '' };

            case 'contact':
                var contactDigits = v.replace(/\D/g, '');
                if (contactDigits.length < 10) return { valid: false, msg: t ? 'Mobile number must have at least 10 digits.' : 'मोबाइल नंबर में कम से कम 10 अंक होने चाहिए।' };
                if (contactDigits.length > 15) return { valid: false, msg: t ? 'Mobile number must have at most 15 digits.' : 'मोबाइल नंबर में अधिकतम 15 अंक हो सकते हैं।' };
                if (isRepeatingOrSequential(contactDigits)) return { valid: false, msg: t ? 'Invalid mobile number (all-same, sequential, or repeating digits are not allowed).' : 'अमान्य मोबाइल नंबर।' };
                if (hasMultipleSpaces(v)) return { valid: false, msg: t ? 'Only single space allowed.' : 'केवल एकल स्पेस की अनुमति है।' };
                return { valid: true, msg: '' };

            case 'fax':
                if (!v) return { valid: true, msg: '' };
                if (!/^[0-9+\-. ()]+$/.test(v)) return { valid: false, msg: t ? 'Fax can only contain digits, +, -, ., (, ) and space.' : 'फैक्स में केवल अंक, +, -, ., (, ) और स्पेस हो सकते हैं।' };
                var faxDigits = v.replace(/\D/g, '');
                if (faxDigits.length < 7) return { valid: false, msg: t ? 'Fax must have at least 7 digits.' : 'फैक्स में कम से कम 7 अंक होने चाहिए।' };
                if (faxDigits.length > 15) return { valid: false, msg: t ? 'Fax must have at most 15 digits.' : 'फैक्स में अधिकतम 15 अंक हो सकते हैं।' };
                if (isRepeatingOrSequential(faxDigits)) return { valid: false, msg: t ? 'Invalid fax number.' : 'अमान्य फैक्स नंबर।' };
                return { valid: true, msg: '' };

            case 'address':
                if (v.length < 10) return { valid: false, msg: t ? 'Address must be at least 10 characters.' : 'पता कम से कम 10 अक्षरों का होना चाहिए।' };
                if (v.length > 200) return { valid: false, msg: t ? 'Address too long (max 200).' : 'पता बहुत लंबा है (अधिकतम 200)।' };
                if (hasBlockedRepeats(v)) return { valid: false, msg: t ? 'Repeated characters are not allowed.' : 'दोहराए गए अक्षर की अनुमति नहीं है।' };
                if (uniqueWordPercent(v) < 40) return { valid: false, msg: t ? 'Address looks repetitive.' : 'पता दोहराव वाला लग रहा है।' };
                if (isGibberishText(v, FIELD_CONFIGS.address)) return { valid: false, msg: t ? 'Address looks like gibberish.' : 'पता अर्थहीन लग रहा है।' };
                return { valid: true, msg: '' };

            case 'complaint':
                if (v.length < 100) return { valid: false, msg: t ? 'Complaint details must be at least 100 characters.' : 'शिकायत विवरण कम से कम 100 अक्षरों का होना चाहिए।' };
                if (v.length > 1000) return { valid: false, msg: t ? 'Complaint details too long (max 1000).' : 'शिकायत विवरण बहुत लंबा है।' };
                if (hasBlockedRepeats(v)) return { valid: false, msg: t ? 'Repeated characters are not allowed.' : 'दोहराए गए अक्षर की अनुमति नहीं है।' };
                if (uniqueWordPercent(v) < 40) return { valid: false, msg: t ? 'Complaint details look repetitive.' : 'शिकायत विवरण दोहराव वाला लग रहा है।' };
                if (isGibberishText(v, FIELD_CONFIGS.complaint)) return { valid: false, msg: t ? 'Complaint details look like gibberish.' : 'शिकायत विवरण अर्थहीन लग रहा है।' };
                return { valid: true, msg: '' };

            default:
                return { valid: true, msg: '' };
        }
    }

    // ═══════════════════════════════════════════════════════════
    //  INPUT SANITIZER
    // ═══════════════════════════════════════════════════════════
    function cleanInput(el, mode) {
        var v = el.value;

        if (mode === 'digits') {
            v = v.replace(/[^0-9]/g, '');
        } else if (mode === 'mobile') {
            v = v.replace(/[^0-9+ ]/g, '');
            v = v.replace(/(?!^)\+/g, '');
            v = v.replace(/\s{2,}/g, ' ');
            v = v.replace(/^\s+/, '');
        } else if (mode === 'fax') {
            v = v.replace(/[^0-9+\-. ()]/g, '');
            v = v.replace(/(?!^)\+/g, '');
            v = v.replace(/\s{2,}/g, ' ');
            v = v.replace(/^\s+/, '');
        } else {
            v = v.replace(/[^a-zA-Z0-9 ,.\/'-]/g, '');
            v = v.replace(/\s{2,}/g, ' ');
            v = v.replace(/^\s+/, '');
        }

        el.value = v;
        updateCharCounter(el);

        var rule = el.getAttribute('data-rule');
        if (rule) validateAndShow(el, rule);
    }

    function validateAndShow(el, rule) {
        var res = validateField(rule, el.value);
        var $el = $(el);
        var $err = $el.closest('.col-md-4, .col-4, .col-6, .col-12').find('.field-error').first();

        if (res.valid) {
            $el.removeClass('is-invalid-custom');
            $err.text('');
        } else {
            $el.addClass('is-invalid-custom');
            $err.text(res.msg);
        }
        return res.valid;
    }

    $(document).on('blur', '[data-rule]', function () {
        validateAndShow(this, this.getAttribute('data-rule'));
    });

    // ═══════════════════════════════════════════════════════════
    //  FORM SUBMIT — STRONG VALIDATION
    // ═══════════════════════════════════════════════════════════
    $('#complaintForm').on('submit', function (e) {
        var allValid = true;
        var firstInvalid = null;
        var errorMessages = [];

        $('#complaintForm [data-rule]').each(function () {
            var rule = this.getAttribute('data-rule');
            var res = validateField(rule, this.value);
            var $el = $(this);
            var $err = $el.closest('.col-md-4, .col-4, .col-6, .col-12').find('.field-error').first();

            if (res.valid) {
                $el.removeClass('is-invalid-custom');
                $err.text('');
            } else {
                $el.addClass('is-invalid-custom');
                $err.text(res.msg);
                allValid = false;
                if (!firstInvalid) firstInvalid = this;
                errorMessages.push(res.msg);
            }
        });

        var captcha = $('#vigi_CaptchaCode').val().trim();
        if (!captcha) {
            allValid = false;
            if (!firstInvalid) firstInvalid = $('#vigi_CaptchaCode')[0];
            $('#captchavalid').text(IS_ENGLISH ? 'Captcha is required.' : 'कैप्चा आवश्यक है।');
            errorMessages.push(IS_ENGLISH ? 'Captcha is required.' : 'कैप्चा आवश्यक है।');
        }

        if (!allValid) {
            e.preventDefault();
            if (firstInvalid) {
                firstInvalid.focus();
                $('html, body').animate({ scrollTop: $(firstInvalid).offset().top - 120 }, 400);
            }
            if (errorMessages.length > 0) {
                Swal.fire({
                    icon: 'warning',
                    title: IS_ENGLISH ? 'Please fix the following:' : 'कृपया इन्हें ठीक करें:',
                    html: '<ul style="text-align:left; padding-left:20px;">' +
                          errorMessages.map(function (m) { return '<li>' + m + '</li>'; }).join('') +
                          '</ul>',
                    confirmButtonText: IS_ENGLISH ? 'OK' : 'ठीक है'
                });
            }
            return false;
        }
    });

    // ═══════════════════════════════════════════════════════════
