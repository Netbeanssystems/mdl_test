    <script>


        function refreshCaptcha() {
            $("#img-captcha").attr("src", "../Home/GetCaptchaImage?" + new Date().getTime());
        }

        $("#captchaInput").on("blur", function () {
            var captcha = $(this).val();

            if (captcha.length > 0) {
                $.get("/Forms/FooterEnquiry?handler=Validatecapcha",
                    { CaptchaCode: captcha },
                    function (res) {
                        if (res !== captcha) {
                            alert("Invalid captcha");
                            $("#captchaInput").val("");
                            refreshCaptcha();
                        }
                    });
            }
        });
    </script>





