@page "/{lang}/Forms/Vigilance"
@using Microsoft.AspNetCore.Http;
@model WebSite.Pages.Forms.VigilanceModel
@{
    Layout = "_InternalPagesLayout";
    @if (HttpContext.Session.GetString("Lang") == null || HttpContext.Session.GetString("Lang") == "English")
    {
        ViewData["Title"] = "Vigilance";

    }
    else
    {

        ViewData["Title"] = "सतर्कता";
    }
}

@if (HttpContext.Session.GetString("Lang") == null || HttpContext.Session.GetString("Lang") == "English")   
{
    <div class="hero" style="position: relative;">
        <div class="item"><div class="heading">Vigilance</div><img src="/assets/images/rti-banner.jpg" alt="" class="image1"></div>
        <div class="strip"><span><a href="/">Home</a> > Vigilance</span></div>
    </div>
}
else
{
    <div class="hero" style="position: relative;">
        <div class="item"><div class="heading">सतर्कता</div><img src="/assets/images/rti-banner.jpg" alt="" class="image1"></div>
        <div class="strip"><span><a href="/">मुख्य पृष्ठ</a> > सतर्कता</span></div>
    </div>
}

@{
    @if (HttpContext.Session.GetString("Lang") == null || HttpContext.Session.GetString("Lang") == "English")
    {
        <div class="mid-content">
            <div class="container">
                <div class="row">
                    <h3 class="inner-heading">Vigilance</h3>
                    <div class="card border-0">
                        <div class="card-body">

                            <div class="col-md-12 d-flex">
                                <a href="/English/Forms/RegisterComplaint" class="btn btn-btn btn-primary">Register a Complaint</a>
                                @*  <a href="#" class="btn btn-btn btn-primary">Track Your Complaint</a>*@
                            </div>
                            

                        </div>
                    </div>
                    @*<div class="row">

            <div class="col-md-6">
            <a href="/English/Forms/RegisterComplaint" class="btn btn-btn btn-primary pull-right">Register a Complaint</a>
            </div>
            <div class="col-md-6">
            <a href="/English/Forms/TrackComplaint" class="btn btn-btn btn-primary">Track Your Complaint</a>
            </div>
            </div>*@
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="mid-content">
            <div class="container">
                <div class="row">
                    <h3 class="inner-heading">
                        सतर्कता
                    </h3>
                    <div class="card border-0">
