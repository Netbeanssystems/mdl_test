@page "/{lang}/Career/Career-Apprentice"
@using Microsoft.AspNetCore.Http;
@model WebSite.Pages.Career.Career_ApprenticeModel
@{
    Layout = "_InternalPagesLayout";
     @if (HttpContext.Session.GetString("Lang") == null || HttpContext.Session.GetString("Lang") == "English")
    {
        ViewData["Title"] = "Career - Apprentice";
    }
    else
    {

        ViewData["Title"] = "करियर प्रशिक्षु";
    }

}

<style>
    .hero img {
        width: 100% !important;
    }

    ul.pdf li {
        background: url('/img/icon-pdf.png') no-repeat;
        padding-left: 22px;
    }
</style>
<link rel="stylesheet" href="/css/jquery.datatables.min.css" />

@if (HttpContext.Session.GetString("Lang") == null || HttpContext.Session.GetString("Lang") == "English")
{
    <div class="hero" style="position: relative;">
        <div class="item"><div class="heading">Career Apprentice</div><img src="/assets/images/rti-banner.jpg" alt="" class="image1"></div>
        <div class="strip"><span><a href="/">Home</a> > Careers > Career Apprentice</span></div>
    </div>
}
else
{
    <div class="hero" style="position: relative;">
        <div class="item"><div class="heading"> </div><img src="/assets/images/rti-banner.jpg" alt="" class="image1"></div>
        <div class="strip"><span><a href="/">मुख्य पृष्ठ</a> > कैरियर > कैरियर अपरेंटिस</span></div>
    </div>
}

<div class="mid-content">
    <div class="container">
        <div class="row">
            @if (HttpContext.Session.GetString("Lang") == null || HttpContext.Session.GetString("Lang") == "English")
            {
                <h3 class="inner-heading">Career - Apprentice</h3>
            }
            else
            {
                <h3 class="inner-heading">कैरियर- अप्रेंटिस</h3>
            }
            <div class="card border-0">
                <div class="card-body p-0">
                    <div class="text-danger text-center mb-2">
                    @if (HttpContext.Session.GetString("Lang") == null || HttpContext.Session.GetString("Lang") == "English")
                    {
                        @*<h2>दूरभाष सं. / Contact No: 022-2376 4108 / 4174</h2>*@
                        <h2>Contact No: +91-22-2376 4151 / 4155</h2>
                    }
                    else
                    {
                        <h2>दूरभाष सं.: +91-22-2376 4151 / 4155</h2>
                    }
                    </div>
                    <div class="theinformatoryinfos">
                        @if (HttpContext.Session.GetString("Lang") == null || HttpContext.Session.GetString("Lang") == "English")
                        {
                            <p>
                                <strong>Important Information:</strong> All the advertisement Documents, are in PDF format. To view and print the same you need to have Adobe Acrobat Reader which can be freely downloaded from <a href="http://www.adobe.com/" target="_blank">www.adobe.com</a>
                            </p>
                        }
                        else
                        {
                            <p>
                                <strong>महत्वपूर्ण सूचना:</strong> सभी विज्ञापन दस्तावेज़ पीडीएफ प्रारूप में हैं। इसे देखने और प्रिंट करने के लिए आपके पास Adobe Acrobat Reader होना चाहिए जिसे आसानी से डाउनलोड किया जा सकता है <a href="http://www.adobe.com/" onclick="return confirm('बाहरी वेबसाइट जो एर् नई विंडो में खुलती है');" target="_blank">www.adobe.com</a>
                            </p>
                        }

                        <div class="adobeholds text-center">
                            <a onclick="return confirm('External site that opens in a new window');" href="https://get.adobe.com/reader/" target="_blank">Get Adobe Reader </a>
                            <div class="abds">
                                <a onclick="return confirm('External site that opens in a new window');" href="https://get.adobe.com/reader/" target="_blank">
                                    <img src="/img/holdadbicon.jpg">
                                </a>
                            </div>
                        </div>
                    </div>
                    @if (HttpContext.Session.GetString("Lang") == null || HttpContext.Session.GetString("Lang") == "English")
                    {
                        <div class="form-group text-right">
                            <button id="btnSave" onclick="GetArchieved();" type="button" class="btn btn-primary">Click here for Archive</button>
                        </div>
                    }
                    else
                    {
                        <div class="form-group text-right">
                            <button id="btnSave" onclick="GetArchievedHindi();" type="button" class="btn btn-primary">पुरालेख के लिए यहां क्लिक करें</button>
                        </div>
                    }
                    @if (HttpContext.Session.GetString("Lang") == null || HttpContext.Session.GetString("Lang") == "English") //AkashS
                    {
                        <div id="tbl_partial">
                            <partial name="_NonCareerPartial" model="@Model.cont" />
                        </div>
                    }
                    else
                    {
                        <div id="tbl_partial">
                            <partial name="_NonCareerPartialHindi" model="@Model.cont" />
                        </div>
                    }
                   

                    <ul class="listStyle mt-2">
                        <li>
                             @if (HttpContext.Session.GetString("Lang") == null || HttpContext.Session.GetString("Lang") == "English")
                        {
                            <a href="/writereaddata/pdfs/career_march10/24032010/Attestation_Form_Executive_pvr.pdf" target="_blank">
                                    <img src="/assets/images/pdf.png" title="Click here to view or download">  Attestation Form - For Police Verification (Size: 570 KB, Language: English)
                                </a>
                            }
                            else
                            {
                                 <a href="/writereaddata/pdfs/career_march10/24032010/Attestation_Form_Executive_pvr.pdf" target="_blank">
                                    <img src="/assets/images/pdf.png" title="देखने / डाउनलोड करने के ललए यहाीं क्ललक करें">   साक्षीकरण रूप -पुलीसों के लिए प्रमाणिकरण (आकार: 570 KB, भाषा: अंग्रेजी)
                                </a>
                            }
                        </li>
                    </ul>
                </div>

            </div>

        </div>
    </div>
</div>

@section Scripts{
    <script>
        // Get lists on dropdown change
        function GetArchieved() {
            ShowLoader();
            var status = "";

            if ($("#btnSave").text() == "Click here for Archive") {
                status = "archive";
                $("#btnSave").text("Back to current")
            }
            else {
                status = "current";
                $("#btnSave").text("Click here for Archive")
            }
            $.get('../Career/Career-Apprentice?handler=BindSelectdata', { Status: status })
                .done(function (data) {
                    if (data) {
                        $("#tbl_partial").html('').html(data);
                        BindDatatable();
                        HideLoader();
                    }
                });
        }
        function GetArchievedHindi() {
            ShowLoader();
            var status = "";

            if ($("#btnSave").text() == "पुरालेख के लिए यहां क्लिक करें") {
                status = "archive";
                $("#btnSave").text("वर्तमान पर वापस जाएँ")
            }
            else {
                status = "current";
                $("#btnSave").text("पुरालेख के लिए यहां क्लिक करें")
            }
            $.get('../Career/Career-Apprentice?handler=BindSelectdata', { Status: status })
                .done(function (data) {
                    if (data) {
                        $("#tbl_partial").html('').html(data);
                        BindDatatable();
                        HideLoader();
                    }
                });
        }

        function BindDatatable() {
            $("#tbl-career").DataTable({
                "pageLength": 50,
                "searching": false,
                initComplete: function () {
                    var r = $("#tbl-career tfoot tr");
                    r.find("th").each(function () {
                        if ($(this).hasClass("search")) {
                            $(this).css("padding", 5);
                            var title = $(this).text();
                            $(this).html('<input type="text" class="form-control" placeholder="' + title + '" />');
                        } else {
                            $(this).html("");
                        }
                    });
                    $("#tbl-career thead").prepend(r);
                    this.api().columns().every(function () {
                        var that = this;
                        $("input", this.footer()).on("keyup change clear",
                            function () {
                                if (that.search() !== this.value) {
                                    that.search(this.value).draw();
                                }
                            });
                    });
                }
            });
        }

        $("#tbl-career").DataTable({
            "pageLength": 50,
            "searching": false,
            initComplete: function () {
                var r = $("#tbl-career tfoot tr");
                r.find("th").each(function () {
                    if ($(this).hasClass("search")) {
                        $(this).css("padding", 5);
                        var title = $(this).text();
                        $(this).html('<input type="text" class="form-control" placeholder="' + title + '" />');
                    } else {
                        $(this).html("");
                    }
                });
                $("#tbl-career thead").prepend(r);
                this.api().columns().every(function () {
                    var that = this;
                    $("input", this.footer()).on("keyup change clear",
                        function () {
                            if (that.search() !== this.value) {
                                that.search(this.value).draw();
                            }
                        });
                });
            }
        });
    </script>
}