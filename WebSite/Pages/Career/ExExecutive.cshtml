@page "/{lang}/Career/Ex-Executives"
@using Microsoft.AspNetCore.Http;
@model WebSite.Pages.Career.ExExecutiveModel
@{
    Layout = "_InternalPagesLayout";
    ViewData["Title"] = "Ex Executives";
        @if (HttpContext.Session.GetString("Lang") == null || HttpContext.Session.GetString("Lang") == "English")
    {
        ViewData["Title"] = "Ex Executives";
    }
    else
    {

        ViewData["Title"] = "पूर्व कार्यकारी";
    }
}

<style>
    .hero img {
        width: 100% !important;
    }

    ul.pdf li {
        background: url('/img/icon-pdf.png') no-repeat;
        padding-left: 22px;
    }
</style>
<link rel="stylesheet" href="/css/jquery.datatables.min.css" />

@if (HttpContext.Session.GetString("Lang") == null || HttpContext.Session.GetString("Lang") == "English")
{
    <div class="hero" style="position: relative;">
        <div class="item"><div class="heading">Ex Executives</div><img src="/assets/images/rti-banner.jpg" alt=""></div>
        <div class="strip"><span><a href="/">Home</a> > Employee Corner > Retired Employees > Ex Executives</span></div>
    </div>
}
else
{
    <div class="hero" style="position: relative;">
        <div class="item"><div class="heading">पूर्व अधिकारी</div><img src="/assets/images/rti-banner.jpg" alt=""></div>
        <div class="strip"><span><a href="/">मुख्य पृष्ठ</a> > कर्मचारी कॉर्नर > सेवानिवृत्त कर्मचारी > पूर्व अधिकारी</span></div>
    </div>
}

<div class="mid-content">
    <div class="container">
        <div class="row">
            @if (HttpContext.Session.GetString("Lang") == null || HttpContext.Session.GetString("Lang") == "English")
            {
                <h3 class="inner-heading">Ex - Executives</h3>
            }
            else
            {
                <h3 class="inner-heading">पूर्व-कार्यकारी</h3>
            }

            <div class="card border-0">
                <div class="card-body p-0">

                    <div class="theinformatoryinfos">
                        @if (HttpContext.Session.GetString("Lang") == null || HttpContext.Session.GetString("Lang") == "English")
                        {
                            <p>
                                <strong>Contact No:</strong> +91-22-2376-4124
                            </p>
                            <p>
                                <strong>Important Information:</strong> All the advertisement Documents, are in PDF format. To view and print the same you need to have Adobe Acrobat Reader which can be freely downloaded from <a onclick="return confirm('External site that opens in a new window.');" href="http://www.adobe.com/" target="_blank">www.adobe.com</a>
                            </p>
                        }
                        else
                        {
                            <p>
                                <strong>दूरभाष सं.</strong> +91-22-2376-4124
                            </p>
                            <p>
                                <strong>महत्वपूर्ण सूचना:</strong> सभी विज्ञापन दस्तावेज़ पीडीएफ प्रारूप में हैं। इसे देखने और प्रिंट करने के लिए आपके पास Adobe Acrobat Reader होना चाहिए जिसे आसानी से डाउनलोड किया जा सकता है <a href="http://www.adobe.com/" onclick="return confirm('बाहरी वेबसाइट जो एर् नई विंडो में खुलती है');" target="_blank">www.adobe.com</a>
                            </p>
                        }

                        <div class="adobeholds text-center">
                            <a onclick="return confirm('External site that opens in a new window.');" href="https://get.adobe.com/reader/" target="_blank">Get Adobe Reader </a>
                            <div class="abds">
                                <a onclick="return confirm('External site that opens in a new window.');" href="https://get.adobe.com/reader/" target="_blank">
                                    <img src="/img/holdadbicon.jpg">
                                </a>
                            </div>
                        </div>
                    </div>
                   @* <div class="form-group text-right">
                        <button id="btnSave" onclick="GetArchieved();" type="button" class="btn btn-primary">Click for Archived Notification</button>
                    </div>*@
                    @if (HttpContext.Session.GetString("Lang") == null || HttpContext.Session.GetString("Lang") == "English")
                    {
                        <div class="form-group text-right">
                            <button id="btnSave" onclick="GetArchieved();" type="button" class="btn btn-primary">Click here for Archive</button>
                        </div>
                    }
                    else
                    {
                        <div class="form-group text-right">
                            <button id="btnSave" onclick="GetArchievedHindi();" type="button" class="btn btn-primary">पुरालेख के लिए यहां क्लिक करें</button>
                        </div>
                    }
                    @if (HttpContext.Session.GetString("Lang") == null || HttpContext.Session.GetString("Lang") == "English") //AkashS
                    {
                        <div id="tbl_partial">
                            <partial name="_RetireCareerPartial" model="@Model.cont" />
                        </div>
                    }
                    else
                    {
                        <div id="tbl_partial">
                            <partial name="_RetireCareerPartialHindi" model="@Model.cont" />
                        </div>
                    }
                    @*<div id="tbl_partial">
                        <partial name="_RetireCareerPartial" model="@Model.cont" />
                    </div>*@
                </div>

            </div>

        </div>
    </div>
</div>

@section Scripts{
    <script>
        // Get lists on dropdown change
        function GetArchieved() {
            ShowLoader();
            var status = "";

            if ($("#btnSave").text() == "Click here for Archive") {
                status = "archive";
                $("#btnSave").text("Back to Current")
            }
            else {
                status = "current";
                $("#btnSave").text("Click here for Archive")
            }
            $.get('../Career/Ex-Executives?handler=BindSelectdata', { Status: status })
                .done(function (data) {
                    if (data) {
                        $("#tbl_partial").html('').html(data);
                        BindDatatable();
                        HideLoader();
                    }
                });
        }
        function GetArchievedHindi() {
            ShowLoader();
            var status = "";

            if ($("#btnSave").text() == "पुरालेख के लिए यहां क्लिक करें") {
                status = "archive";
                $("#btnSave").text("वर्तमान पर वापस जाएँ")
            }
            else {
                status = "current";
                $("#btnSave").text("पुरालेख के लिए यहां क्लिक करें")
            }
            $.get('../Career/Ex-Executives?handler=BindSelectdata', { Status: status })
                .done(function (data) {
                    if (data) {
                        $("#tbl_partial").html('').html(data);
                        BindDatatable();
                        HideLoader();
                    }
                });
        }
        function BindDatatable() {
            $("#tbl-career").DataTable({
                "pageLength": 50,
                "searching": false,
                initComplete: function () {
                    var r = $("#tbl-career tfoot tr");
                    r.find("th").each(function () {
                        if ($(this).hasClass("search")) {
                            $(this).css("padding", 5);
                            var title = $(this).text();
                            $(this).html('<input type="text" class="form-control" placeholder="' + title + '" />');
                        } else {
                            $(this).html("");
                        }
                    });
                    $("#tbl-career thead").prepend(r);
                    this.api().columns().every(function () {
                        var that = this;
                        $("input", this.footer()).on("keyup change clear",
                            function () {
                                if (that.search() !== this.value) {
                                    that.search(this.value).draw();
                                }
                            });
                    });
                }
            });
        }

        $("#tbl-career").DataTable({
            "pageLength": 50,
            "searching": false,
            initComplete: function () {
                var r = $("#tbl-career tfoot tr");
                r.find("th").each(function () {
                    if ($(this).hasClass("search")) {
                        $(this).css("padding", 5);
                        var title = $(this).text();
                        $(this).html('<input type="text" class="form-control" placeholder="' + title + '" />');
                    } else {
                        $(this).html("");
                    }
                });
                $("#tbl-career thead").prepend(r);
                this.api().columns().every(function () {
                    var that = this;
                    $("input", this.footer()).on("keyup change clear",
                        function () {
                            if (that.search() !== this.value) {
                                that.search(this.value).draw();
                            }
                        });
                });
            }
        });
    </script>
}
