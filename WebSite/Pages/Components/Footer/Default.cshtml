@using Microsoft.AspNetCore.Http;
@model Application.Dtos.WebsiteCounterDTO

@if (Context.Session.GetString("Lang") == null || Context.Session.GetString("Lang") == "English")
{
    <footer class="site-footer">
        <div class="footer-top">
            <div class="container">
                <div class="row">
                    <div class="col-lg-6">
                        <div class="row">
                            <div class="col-lg-12">
                            </div>
                            <div class="col-lg-6">
                                <div class="footer-single">

                                    <ul>
                                        <li><a title="Copyright Policy" href="/English/pages/Copyright-Policy">Copyright Policy</a></li>
                                        @*<li><a title="Disclaimer" href="/English/pages/Disclaimer">Disclaimer</a></li>*@
                                        <li><a title="Sitemap" href="/English/pages/Site-Map">Sitemap</a></li>
                                        <li><a title="Feedback" href="/English/Forms/Feedback">Feedback</a></li>
                                        <li><a title="Accessibility Statement" href="/English/pages/Accessibility-Statement">Accessibility Statement</a> </li>  <!--Changes-->
                                    </ul>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="footer-single">

                                    <ul>
                                        <li><a title="Hyperlinking Policy" href="/English/pages/Hyperlinking-Policy">Hyperlink Policy</a></li>
                                        <li><a title="Privacy Policy" href="/English/pages/Privacy-Policy">Privacy Policy</a></li>
                                        <li><a title="Terms & Conditions" href="/English/pages/Terms-&-Conditions">Terms & Conditions</a></li>
                                        @*<li><a title="Terms & Conditions" href="/English/pages/#">Terms of Use</a></li>*@
                                        <li><a title="Website Policy" href="/English/pages/Website-Policies">Website Policy</a></li>
                                        <li><a title="Security Policy" href="/English/pages/Security-Policy">Security Policy</a></li>
                                        <li><a title="Help" href="/English/pages/help">Help</a></li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                    </div>
                    <div class="col-lg-6">
                        <div class="footer-single">
                            @{
                                var lastDateStr = Context.Session.GetString("LastDate");
                                var dateToDisplay = DateTime.Now;

                                if (!string.IsNullOrEmpty(lastDateStr) && DateTime.TryParse(lastDateStr, out var parsedDate))
                                {
                                    dateToDisplay = parsedDate;
                                }
                            }
                            <h5 style="color: #eaecf1;">Last Updated Date @dateToDisplay.ToString("dd/MM/yyyy hh:mm tt")</h5>
                            <div class="footer-update"></div>
                            @* <p>Official Website of Mazagon Dock Shipbuilders Ltd. Content on this website is published and managed by Mazagon Dock Shipbuilders Ltd. Best viewed on "Google chrome v80+,  Firefox v 80+ and Microsoft edge".</p> *@

                            <p>
                                Copyright © 2025 - All Rights Reserved – Official Website of Mazagon Dock Shipbuilders Limited, Ministry of Defence, Government of India<br /> Content on this website is published and managed by Mazagon Dock Shipbuilders Limited, Ministry of Defence<br /> For any query regarding this website, please contact the web information manager – Mr. P Kumaresan, Deputy General Manager, cit-support[dot]mdl[at]mazdock[dot]com, +91-22-2376-2202/2203
                            </p>
                        </div>
                        <div class="footer-single">
                            <a href="https://jigsaw.w3.org/css-validator/check/referer" target="_blank" onclick="return confirm('External site that opens in a new window.');" title="W3C CSS Validator"><img style="border:0;width:88px;height:31px" src="https://jigsaw.w3.org/css-validator/images/vcss-blue" alt="Valid CSS!"></a>
                            <a href="~/Assets/Doc/ITQCR-GIGW-N.pdf" target="_blank" title="STQC"><img style="border:0;width:88px;height:31px" src="~/Assets/img/STQC.png" alt="STQC"></a>
                            <a href="~/Assets/Doc/ITQCR-GIGW-N-3.pdf" target="_blank" title="GIGW3"><img style="border:0;width:88px;height:31px" src="~/Assets/img/itqcr-gigw3.png" alt="GIGW3"></a>
                            <a href="~/Assets/Doc/CQW-GIGW-3.pdf" target="_blank" title="STQC"><img style="border:0;width:80px;height:80px" src="~/Assets/img/CQW-STQC-Logo.png" alt="STQC"></a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <div class="container">
                <div class="footer-bottom-main">
                    <div class="row">
                        <div class="col-lg-2">
                            <p>Site Visitors: @Model.NoofCount</p>
                        </div>
                        <div class="col-lg-6"><p>Supports: Google Chrome 138+ | Firefox 140+ | Microsoft Edge 138+ | Safari 18+</p></div>
                        <div class="col-lg-4">
                            <p class="text-end">@* Copyright © 2024 MDL. All Rights Reserved.  *@Designed & Developed by <a style="text-decoration:underline;" title="Netbeans" href="https://netbeanssystems.com/" onclick="return confirm('External site that opens in a new window.');" target="_blank">Netbeans Systems</a></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </footer>
}
else
