@model Application.Dtos.NotificationDTO
@using Microsoft.Extensions.Configuration
@using Microsoft.AspNetCore.Http;
@inject IConfiguration config

<!-- Added style="width: 100%;" to both wrapper div and table -->
<div style="width: 100%; overflow-x: auto;">
    <table id="tbl-ind-notification" class="table table-bordered table-striped w-100" style="width: 100% !important;">
        <thead style="background-color: #192c64; color: white;">
            <tr>
                <th style="width: 5%;">Sr.No.</th>
                <th class="search" style="width: 20%;">Tender No.</th>
                <th style="width: 45%;">Work Description</th>
                <th class="search" style="width: 15%;">Tender Date</th>
                <th class="search" style="width: 15%;">Tender Closing date & time</th>
            </tr>
        </thead>
        <tbody>
            @{
                int i = 0;
            }
            @if (Model != null && Model.ind != null)
            {
                @foreach (var item in Model.ind)
                {
                    <tr>
                        <td>
                            @{
                                i++;
                            }
                            @i
                        </td>
                        <td>
                            @Html.Raw(item.EOINo)
                            @if (!string.IsNullOrEmpty(item.TenderNumberMoreInfo))
                            {
                                <br />
                                <span class="text-danger">@Html.Raw(item.TenderNumberMoreInfo)</span>
                            }
                        </td>
                        <td>
                            @Html.Raw(item.Description)
                            @if (!string.IsNullOrEmpty(item.Updated_Work_Description))
                            {
                                <br />
                                <span class="text-danger">@Html.Raw(item.Updated_Work_Description)</span>
                            }
                            @if (Model.docs != null)
                            {
                                @foreach (var d in Model.docs)
                                {
                                    @if (d.Tender_id == item.Tender_Id.ToString())
                                    {
                                        var lang = Context.Session.GetString("Lang");
                                        var tooltip = (lang == null || lang == "English") ? "Click here to view or download" : "देखने / डाउनलोड करने के लिए यहाँ क्लिक करें";

                                        <div>
                                            <a href="@config["FileBaseUrl"]/writereaddata/tenders/@d.Document_PDF" target="_blank">
                                                <i class="fa fa-file-pdf-o text-dark" data-toggle="tooltip" data-placement="top" title="@tooltip"></i>
                                                @d.Document_Name
                                            </a>
                                        </div>
                                    }
                                }
                            }
                        </td>
                        <td>
                            @item.EOIDate
                        </td>
                        <td>
                            @item.EOICloseDate
                            @if (item.TenderClosingTime != null)
                            {
                                <span> @item.TenderClosingTime</span>
                            }
                            @if (item.UpdatedTenderClosingDate != null)
                            {
                                <br />
                                <span class="text-danger">@Html.Raw(item.UpdatedTenderClosingDate)</span>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@if (Model?.ind != null && Model.ind.Count > 0)
{
    <div class="clearfix mt-2">
        <span style="float: right; color: #00008B;">
            <strong>Last Updated Date:</strong> @Model.ind.FirstOrDefault()?.Added_on
        </span>
    </div>
}