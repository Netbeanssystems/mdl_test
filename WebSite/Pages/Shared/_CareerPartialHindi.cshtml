@model List<Application.Dtos.CareerDTO>
@using Microsoft.Extensions.Configuration
@using Microsoft.AspNetCore.Http;
@inject IConfiguration config

<div class="table-responsive">
    <table id="tbl-career" class="table table-bordered table-striped">
        <thead style="background-color: #192c64;color: white;">
            <tr>
                <th>क्रमांक</th>
                       <th class="search">दिनांक पोस्टिंग</th>
                <th class="search">विज्ञापन संदर्भ संख्या</th>
                <th class="search">पद</th>
                <th>
                    विवरण
                </th>
                <th class="search">अंतिम तिथि</th>
                <th>लिंक</th>
            </tr>
        </thead>
        <tbody>
            @{
                int i = 0;
            }
            @if (Model != null)
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @{
                                i++;
                            }
                            @i
                        </td>
                        <td>
                            @Html.Raw(item.DatePosting)
                        </td>
                        <td>
                            @Html.Raw(item.AdvRefNumberHindi)
                        </td>
                        <td>
                            @Html.Raw(item.PostHindi)
                        </td>
                        <td>
                            @Html.Raw(item.DetailsHindi)
                        </td>
                         <td>
                            @Html.Raw(item.ClosingDate)
                        </td>
                        <td>
                          @*  @if (Context.Session.GetString("Lang") == null || Context.Session.GetString("Lang") == "English")
                            { 
                                 <a href="@config["FileBaseUrl"]/writereaddata/career/@item.FileName" target="_blank">
                                 <img src="/assets/images/pdf.png" title="Click here to view or download">
                                अधिक विवरण के लिए यहा क्लिक करे / CLICK HERE FOR MORE DETAILS
                            </a>
                            }
                            else{*@
                             <a href="@config["FileBaseUrl"]/writereaddata/career/@item.FileName" target="_blank">
                                 <img src="/assets/images/pdf.png" title="देखने / डाउनलोड करने के ललए यहाीं क्ललक करें">
                                अधिक विवरण के लिए यहा क्लिक करे
                            </a>
                            @*}*@
                           
                        </td>
                    </tr>
                }
            }

        </tbody>
       @* <tfoot>
            <tr>
                <th>Sr.No.</th>
                <th class="search">DATE OF POSTING</th>
                <th class="search">ADVERTISEMENT REFERENCE NO</th>
                <th class="search">POST</th>
                <th>DETAILS</th>
                <th>LINK</th>
            </tr>
        </tfoot>*@
    </table>
</div>
@{

    @if (Model.Count > 0)
    {
        <span style="float: right; color: #00008B;">Last Updated Date:@Model.FirstOrDefault().Added_on.ToString("dd/MM/yyyy hh:mm tt")</span>

    }
}
