@model List<Application.Dtos.NonCareerDTO>
@using Microsoft.Extensions.Configuration
@inject IConfiguration config

<div class="table-responsive">

    <table id="tbl-career" class="table table-bordered table-striped">
        <thead style="background-color: #192c64;color: white;">
            <tr>
                <th>क्रमांक</th>
                <th class="search">पोस्टिंग की तारीख</th>
                <th class="search">विज्ञापन संदर्भ एनO</th>
                <th class="search">अंतिम तिथि</th>
                <th>लिंक</th>
            </tr>
        </thead>
        <tbody>
            @{
                int i = 0;
            }

            @if (Model != null)
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @{
                                i++;
                            }
                            @i
                        </td>
                        <td>
                            @Html.Raw(item.DatePosting)
                        </td>
                        <td>
                            @Html.Raw(item.AdvRefNumberHindi)
                        </td>
                        <td>
                            @Html.Raw(item.ClosingDate)
                        </td>
                        <td>
                            <a href="@config["FileBaseUrl"]/writereaddata/career/@item.FileName" target="_blank">
                                <img src="/assets/images/pdf.png" title=" अधिक विवरण के लिए यहा क्लिक करे">
                                अधिक विवरण के लिए यहा क्लिक करे 
                            </a>
                        </td>
                    </tr>
                }
            }

        </tbody>
        @*  <tfoot>
        <tr>
        <th>Sr.No.</th>
        <th class="search">DATE OF POSTING</th>
        <th class="search">ADVERTISEMENT REFERENCE NO</th>
        <th>LINK</th>
        </tr>
        </tfoot>*@
    </table>
</div>
