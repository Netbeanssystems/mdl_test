    <script>
        $(document).ready(function () {
            if (location.hash) {
                setTimeout(function () {
                    window.scrollTo(0, 0);
                    $('html,body').animate({
                        scrollTop: $(window.location.hash).offset().top - 170
                    });
                }, 1);
            }
        });

        $('#datasubmit').click(function () {
            var getinput = $('#search-input').val();
            if ($('#hdn_lang').val() == "eng") {
                if (getinput != null && getinput != "") {
                    window.location = '/English/Search?output=' + getinput;
                }
                else {
                    window.location = '/';
                }
            }
            else {
                if (getinput != null && getinput != "") {
                    window.location = '/Hindi/Search?output=' + getinput;
                }
                else {
                    window.location = '/';
                }
            }
        });

        $(document).on("keypress", "input", function (e) {
            if (e.which == 13) {
                var getinput = $('#output').val();
                if ($('#hdn_lang').val() == "eng") {
                    if (getinput != null && getinput != "") {
                        window.location = '/English/Search?output=' + getinput;
                    }
                    else {
                        window.location = '/';
                    }
                }
                else {
                    if (getinput != null && getinput != "") {
                        window.location = '/Hindi/Search?output=' + getinput;
                    }
                    else {
                        window.location = '/';
                    }
                }
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
