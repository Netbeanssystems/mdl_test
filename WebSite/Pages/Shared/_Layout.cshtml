            .owl-carousel, .slick-slider, .carousel, .slider, [class*="carousel"] {
                display: block !important;
                overflow: visible !important;
                position: static !important;
            }

            .owl-item, .slick-slide, .carousel-item, .slide, .item {
                display: block !important;
                position: static !important;
                opacity: 1 !important;
                visibility: visible !important;
                float: none !important;
                margin: 5px 0 !important;
            }

            /* === Show parallax content === */
            [data-parallax], .parallax, .parallax-window, .parallax-bg {
                background: none !important;
                position: static !important;
                overflow: visible !important;
            }

            /* === Show animation wrappers === */
            .wow, .animated, .fadeIn, .fadeUp, .fade-down, .reveal {
