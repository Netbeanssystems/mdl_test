            </title>
            <meta name="description" content="Stay informed about the latest events and updates at Mazagon Dock. Learn more about industry activities and achievements.">
            <meta name="keyword" content="Mazagon Dock Events, Industry Updates, Shipyard News, Maritime Events">
        }
    }
