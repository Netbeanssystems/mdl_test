@using Microsoft.AspNetCore.Http;

@{
    var lang = Context.Session.GetString("Lang");
     var currentTitle =  Html.Raw(ViewData["Title"]);
    var htmlLang = (string.IsNullOrEmpty(lang) || lang == "English") ? "en" : "hi";
}
<!DOCTYPE html>
<html lang="@htmlLang">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    
    @if (@ViewData["Title"] == "Career - Executives")
    {
    @if (Context.Session.GetString("Lang") == null || Context.Session.GetString("Lang") == "English")
    {
            <title>
                @ViewData["Title"] | Executive Career Openings at Mazagon Dock
            </title>
            <meta name="description" content="Advance your career with executive roles at Mazagon Dock, a leader in shipbuilding. Explore current openings and join the journey of innovation.">
        <meta name="keyword" content="Mazagon Dock Executive Jobs, Leadership Careers, Mazagon Dock Vacancies">
    }
    else
    {
            <title>@currentTitle | मझगांव डॉक में कार्यकारी कैरियर के उद्घाटन</title>
            <meta name="description" content="Advance your career with executive roles at Mazagon Dock, a leader in shipbuilding. Explore current openings and join the journey of innovation.">
            <meta name="keyword" content="Mazagon Dock Executive Jobs, Leadership Careers, Mazagon Dock Vacancies">
        }
    }
    else if (@ViewData["Title"] == "Career - Non-Executives")
    {
        @if (Context.Session.GetString("Lang") == null || Context.Session.GetString("Lang") == "English")
        {
            <title>
                @ViewData["Title"] | Apply for Non-Executive Careers at Mazagon Dock
            </title>
            <meta name="description" content="Discover non-executive job opportunities at Mazagon Dock Shipbuilders. Join India leading shipyard and grow your career with us.">
            <meta name="keyword" content="Mazagon Dock Careers, Non-Executive Jobs, Shipyard Jobs, Mazagon Dock Opportunities">
        }
        else
        {
            <title>
                @currentTitle | मझगांव डॉक में गैर-कार्यकारी कैरियर के लिए आवेदन करें
            </title>
            <meta name="description" content="Discover non-executive job opportunities at Mazagon Dock Shipbuilders. Join India leading shipyard and grow your career with us.">
            <meta name="keyword" content="Mazagon Dock Careers, Non-Executive Jobs, Shipyard Jobs, Mazagon Dock Opportunities">
        }
    }
    else if (@ViewData["Title"] == "Career - Apprentice")
    {
        @if (Context.Session.GetString("Lang") == null || Context.Session.GetString("Lang") == "English")
        {
            <title>
                @ViewData["Title"] | Apprenticeship Programs at Mazagon Dock
            </title>
            <meta name="description" content="Gain hands-on experience and professional growth through apprenticeship programs at Mazagon Dock. Build a strong foundation for your career.">
            <meta name="keyword" content="Career Apprentice">
        }
        else
        {
            <title>
                @currentTitle |
                मझगांव डॉक में प्रशिक्षुता कार्यक्रम
            </title>
            <meta name="description" content="Gain hands-on experience and professional growth through apprenticeship programs at Mazagon Dock. Build a strong foundation for your career.">
            <meta name="keyword" content="Career Apprentice">
        }
    }
