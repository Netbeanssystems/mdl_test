@model Application.Dtos.NotificationDTO
@using Microsoft.Extensions.Configuration
@using Microsoft.AspNetCore.Http;
@inject IConfiguration config

<div class="table-responsive">
    <table id="tbl_sbmp_notification" class="table table-bordered table-striped">
        <thead style="background-color: #192c64;color: white;">
            <tr>
                <th>क्रमांक</th>
                <th class="search">टेंडर नं</th>
                <th>कार्य विवरण</th>
                <th class="search">निविदा तिथि</th>
                <th class="search">निविदा समापन तिथि एवं समय</th>
                <th>निविदा शुल्क</th>
                <th>ईएमडी</th>
            </tr>
        </thead>
        <tbody>
            @{
                int i = 0;
            }

            @if (Model != null)
            {
                @if (Model.not != null)
                {
                    @foreach (var item in Model.not)
                    {
                        <tr>
                            <td>
                                @{
                                    i++;
                                }
                                @i
                            </td>
                            <td>
                                @Html.Raw(item.TenderNoHindi)
                                @if (item.TenderNumberMoreInfo != null || item.TenderNumberMoreInfo != "")
                                {
                                    <span class="text-danger">@Html.Raw(item.TenderNumberMoreInfo)</span>
                                }
                            </td>
                            <td>
                                @Html.Raw(item.DescriptionHindi)
                                @if (item.Updated_Work_Description != null)
                                {
                                    <span class="text-danger">@Html.Raw(item.Updated_Work_Description)</span>
                                }

                                @if (item.LinkURL != null)
                                {
                                    <a href="@item.LinkURL" target="_blank">
                                        @item.LinkName
                                    </a>
                                    <br />
                                }

                                @if (Model.docs != null)
                                {
                                    @foreach (var d in Model.docs)
                                    {
                                        @if (d.Tender_id == item.Tender_Id.ToString())
                                        {
                                            @if (Context.Session.GetString("Lang") == null || Context.Session.GetString("Lang") == "English")
                                            {
                                                <a href="@config["FileBaseUrl"]/writereaddata/tenders/@d.Document_PDF" target="_blank">
                                                    @* <i class="fa fa-file-pdf-o text-dark" data-toggle="tooltip" data-placement="top" title="Click here to view or download"></i> *@
                                                    <img src="/assets/images/PDF_file_icon.png" alt="pdf File">
                                                    @d.Document_Name
                                                </a>
                                                <br />
                                            }
                                            else
                                            {
                                                <a href="@config["FileBaseUrl"]/writereaddata/tenders/@d.Document_PDF" target="_blank">
                                                   @*  <i class="fa fa-file-pdf-o text-dark" data-toggle="tooltip" data-placement="top" title="देखने / डाउनलोड करने के ललए यहाीं क्ललक करें"></i> *@
                                                    <img src="/assets/images/PDF_file_icon.png" alt="pdf File">
                                                    @d.Document_Name
                                                </a>
                                            }
                                        }
                                    }
                                }
                            </td>
                            <td>@item.TenderDate</td>
                            <td>
                                @item.TenderCloseDate
                                @if (item.TenderClosingTime != null || item.TenderClosingTime != "")
                                {
                                    <span>@item.TenderClosingTimeHindi</span>
                                }
                                @if (item.UpdatedTenderClosingDate != null)
                                {
                                    <br />
                                    <span class="text-danger">@Html.Raw(item.UpdatedTenderClosingDate)</span>
                                }
                            </td>
                            <td>@item.TenderFee</td>
                            <td>@item.EMDHindi</td>
                        </tr>
                    }
                }
            }


        </tbody>
       @* <tfoot>
            <tr>
                <th>Sr.No.</th>
                <th class="search">TENDER NO</th>
                <th>WORK DESCRIPTION</th>
                <th class="search">TENDER DATE</th>
                <th class="search">TENDER CLOSING DATE & TIME</th>
                <th>TENDER FEE</th>
                <th>EMD</th>
            </tr>
        </tfoot>*@
    </table>
</div>

@{
    if (Model?.not != null && Model.not.Count > 0)
    {
        <span style="float: right; color: #00008B;">अंतिम अद्यतन तिथि: @Model.not.FirstOrDefault()?.Added_on</span>
    }
}
