@page "/{lang}/Pages/{OtherLinkHeading}"
@using Microsoft.AspNetCore.Http
@model WebSite.Pages.pagesModel
@{
    Layout = "_InternalPagesLayout";
}
@*<script src="https://kit.fontawesome.com/4b9ba14b0f.js" crossorigin="anonymous"></script>*@
<script src="https://kit.fontawesome.com/4b9ba14b0f.js" integrity="sha384-mmTDSIYkBlPVfobeXwV6sb5FV+F5sMw7Q1beX2eQrnHq6KHigK6ouO6rZ0/nCYbs" crossorigin="anonymous"></script>
 

@{
    if (HttpContext.Session.GetString("Lang") == null || HttpContext.Session.GetString("Lang") == "English")
    {
        @section meta
        {
        @if (Model.Menus?.Title != null)
            {
                <title>@Model.Menus.Title</title>
            }
            @if (Model.Menus?.Description != null)
            {
                <meta name="description" content="@Model.Menus.Description">
            }
            @if (Model.Menus?.Keyword != null)
            {
                <meta name="keywords" content="@Model.Menus.Keyword">
            }
    }
    }
    else
    {
        @section meta
        {
        @if (Model.Menus?.HindiTitle != null)
            {
                <title>@Html.Raw(@Model.Menus.HindiTitle)</title>
            }
            @if (Model.Menus?.DescriptionHindi != null)
            {
                <meta name="description" content="@Html.Raw(Model.Menus.DescriptionHindi)">
            }
            @if (Model.Menus?.KeywordHindi   != null)
            {
                <meta name="keywords" content="@Html.Raw(@Model.Menus.KeywordHindi)">
            }
    }
    }
}

@if (Model.ModelVM != null)
{
    ViewData["Title"] = Model.ModelVM.Heading;
    <partial name="_Description" model="Model.ModelVM" />
}
else
{
}

<!-- Modal -->
<div class="modal fade" id="FooterEnquiryModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="staticBackdropLabel">Enquiry Form</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" class="form-container">
                <div class="modal-body">
                    <span style="font-size:medium;">   <b> NOTE :</b> All special characters like (>, &#60;, =, $, ;, %, ^, :, &, *, ',', [, ], {, }, +, -, _ ) etc. are not allowed. By any way you try to save it will be removed and then saved.</span>
                    <br />
                    <label asp-for="@Model.contactusform.FirstName" for="contactusform_FirstName"><b>First Name</b></label>
                    <input onkeypress="return myKeyPress(event)" oninput="this.value = this.value.replace(/[^A-Za-z ]/g, '').replace(/(\..*?)\..*/g, '$1');" asp-for="@Model.contactusform.FirstName" placeholder="Enter First Name" required="">
                    <span asp-validation-for="@Model.contactusform.FirstName" class="text-danger"></span>
                    <br>
                    <label asp-for="@Model.contactusform.LastName" for="contactusform_LastName"><b>Last Name</b></label>
                    <input onkeypress="return myKeyPress(event)" oninput="this.value = this.value.replace(/[^A-Za-z ]/g, '').replace(/(\..*?)\..*/g, '$1');" asp-for="@Model.contactusform.LastName" placeholder="Enter Last Name" required="">
                    <span asp-validation-for="@Model.contactusform.LastName" class="text-danger"></span>
                    <br>
                    <label asp-for="@Model.contactusform.CompanyName" for="contactusform_CompanyName"><b>Company</b></label>
                    <input onkeypress="return myKeyPress(event)" oninput="this.value = this.value.replace(/[^A-Za-z ]/g, '').replace(/(\..*?)\..*/g, '$1');" asp-for="@Model.contactusform.CompanyName" placeholder="Enter Company Name" required="">
                    <span asp-validation-for="@Model.contactusform.CompanyName" class="text-danger"></span>
                    <br>
                    <label asp-for="@Model.contactusform.CountryName" for="contactusform_CountryName"><b>Country</b></label>
                    <input asp-for="@Model.contactusform.CountryName" oninput="this.value = this.value.replace(/[^A-Za-z ]/g, '').replace(/(\..*?)\..*/g, '$1');" onkeypress="return myKeyPress(event)" placeholder="Enter Country Name" required="">
                    <span asp-validation-for="@Model.contactusform.CountryName" class="text-danger"></span>
                    <br>
                    <label asp-for="@Model.contactusform.InterestedIn" for="cars"><b>Interested In:</b></label>
                    <select id="cars" asp-for="@Model.contactusform.InterestedIn" class="browser-default custom-select">
                        <option value="New Vessel">New Vessel</option>
                        <option value="Services">Services</option>
                        <option value="Other">Other</option>
                    </select>
                    <span asp-validation-for="@Model.contactusform.InterestedIn" class="text-danger"></span>
                    <br><br>

                    <label asp-for="@Model.contactusform.EmailId" for="contactusform_EmailId"><b>Email</b></label>
                    @* <input type="email" placeholder="Enter Email" oninput="this.value = this.value.replace(/[^A-Za-z0-9@@. ]/g, '').replace(/(\..*?)\..*/g, '$1');" asp-for="@Model.contactusform.EmailId" required=""> *@
                    <input type="email" placeholder="Enter Email" asp-for="@Model.contactusform.EmailId" required>
                    <span asp-validation-for="@Model.contactusform.EmailId" class="text-danger"></span>
                    <br>
                    <label asp-for="@Model.contactusform.Contact" for="contactusform_Contact"><b>Contact No.</b></label>
                    <input asp-for="@Model.contactusform.Contact" oninput="this.value = this.value.replace(/[^0-9.]/g, '').replace(/(\..*?)\..*/g, '$1');" type="text" placeholder="Enter Contact No." required="">
                    <span asp-validation-for="@Model.contactusform.Contact" class="text-danger"></span>
                    <br>
                    <label asp-for="@Model.contactusform.Message" for="contactusform_Message"><b>Your Enquiry</b></label>
                    <textarea class="form-control" rows="3" oninput="this.value = this.value.replace(/[^A-Za-z ]/g, '').replace(/(\..*?)\..*/g, '$1');" onkeypress="return myKeyPress(event)" asp-for="@Model.contactusform.Message" placeholder="Message" required=""></textarea>
                    <span asp-validation-for="@Model.contactusform.Message" class="text-danger"></span>

                </div>
                <div class="modal-footer form-container">
                    <button type="submit" class="btn">Submit</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </form>
        </div>
    </div>
</div>

