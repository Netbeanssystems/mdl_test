@page "/{lang}/Events/EventCategory"
@using Microsoft.AspNetCore.Http;
@model WebSite.Pages.Events.EventCategoryModel

@{
    Layout = "_InternalPagesLayout";
    ViewData["Title"] = "Event Category";
}

<style>
    .hero img {
        width: 100% !important;
    }
</style>

@if (HttpContext.Session.GetString("Lang") == null || HttpContext.Session.GetString("Lang") == "English")
{
    <div class="hero" style="position: relative;">
        <div class="item"><div class="heading">Event Gallery</div><img src="/assets/images/rti-banner.jpg" alt=""></div>
        <div class="strip"><span><a href="/">Home</a> > Event Gallery</span></div>
    </div>
}
else
{
    <div class="hero" style="position: relative;">
        <div class="item"><div class="heading">इवेंट गैलरी</div><img src="/assets/images/rti-banner.jpg" alt=""></div>
        <div class="strip"><span><a href="/">होम</a> > इवेंट गैलरी</span></div>
    </div>
}

<div class="mid-content">
    <div class="container">
        @if (HttpContext.Session.GetString("Lang") == null || HttpContext.Session.GetString("Lang") == "English")
        {
            <h3 class="inner-heading">Event Gallery</h3>
        }
        else
        {
            <h3 class="inner-heading">इवेंट गैलरी</h3>
        }
             @if (HttpContext.Session.GetString("Lang") == null || HttpContext.Session.GetString("Lang") == "English")
        {
        <label for="finyear">Select Year</label>
        }
        else
        {
            <h3 class="inner-heading">वर्ष चुनें</h3>
        }
        <div class="card border-0">
            <div class="card-body p-0">
                <select id="finyear" asp-for="@TempData["latestyear"]" onchange="GetBySelectedYear();" class="browser-default custom-select w-25" asp-items="ViewBag.years">
                    <option value="0">View All</option>
                </select>

                <div class="mt-3">
                    <div id="tbl_partial" class="row">
                        <partial name="_EventCategoryPartial" model="@Model.topEventsVMs" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Get Events on dropdown change
    function GetBySelectedYear() {
        //;
        ShowLoader();
        var year = $("#finyear").val();
        $.get('../Events/EventCategory?handler=BindSelectdata', { year: year })
            .done(function (data) {
                if (data) {
                    $("#tbl_partial").html('').html(data);
                    //BindDatatable();
                    HideLoader();
                }
            });
    }
</script>


