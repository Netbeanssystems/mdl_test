@page "/{lang}/Contracts/MDC-Contracts"
@using Microsoft.AspNetCore.Http;
@model WebSite.Pages.Contracts.MDC_ContractsModel
@{
    Layout = "_InternalPagesLayout";
    ViewData["Title"] = "MDC-Contracts";
}

<style>
    .hero img {
        width: 100% !important;
    }

    ul.pdf li {
        background: url('/img/icon-pdf.png') no-repeat;
        padding-left: 22px;
    }
</style>
<link rel="stylesheet" href="/css/jquery.datatables.min.css" />

@if (HttpContext.Session.GetString("Lang") == null || HttpContext.Session.GetString("Lang") == "English")
{
    <div class="hero" style="position: relative;">
        <div class="item"><div class="heading">MDC Summary of Contracts</div><img src="/assets/images/rti-banner.jpg" alt=""></div>
        <div class="strip"><span><a href="/">Home</a> > <a href="/English/procurement">Procurement</a> > <a href="/English/pages/Tenders">Tenders</a> > <a href="/English/pages/Management-Development-Center">Management Development Ceneter</a> > MDC Summary of Contracts</span></div>
    </div>
}
else
{
    <div class="hero" style="position: relative;">
        <div class="item"><div class="heading">MDC Summary of Contracts</div><img src="/assets/images/rti-banner.jpg" alt=""></div>
        <div class="strip"><span><a href="/">Home</a> > <a href="/Hindi/procurement">Procurement</a> > <a href="/Hindi/pages/Tenders">Tenders</a> > <a href="/Hindi/pages/Management-Development-Center">Management Development Ceneter</a> > MDC Summary of Contracts</span></div>
    </div>
}

<div class="mid-content">
    <div class="container">
        <div class="row">
            @if (HttpContext.Session.GetString("Lang") == null || HttpContext.Session.GetString("Lang") == "English")
            {
                <h3 class="inner-heading">MDC Summary of Contracts</h3>
            }
            else
            {
                <h3 class="inner-heading">MDC Summary of Contracts</h3>
            }

            <div class="card border-0">
                <div class="card-body p-0">
                    <div class="theinformatoryinfos">
                        @if (HttpContext.Session.GetString("Lang") == null || HttpContext.Session.GetString("Lang") == "English")
                        {
                            <p>
                                <strong>Important Information:</strong> All the advertisement Documents, are in PDF format. To view and print the same you need to have Adobe Acrobat Reader which can be freely downloaded from <a href="http://www.adobe.com/" onclick="return confirm('External site that opens in a new window.');" target="_blank">www.adobe.com</a>
                            </p>
                        }
                        else
                        {
                            <p>
                                <strong>Important Information:</strong> All the advertisement Documents, are in PDF format. To view and print the same you need to have Adobe Acrobat Reader which can be freely downloaded from <a href="http://www.adobe.com/" onclick="return confirm('बाहरी वेबसाइट जो एर् नई विंडो में खुलती है|');" target="_blank">www.adobe.com</a>
                            </p>
                        }

                        <div class="adobeholds text-center">
                            <a onclick="return confirm('External site that opens in a new window.');" href="https://get.adobe.com/reader/" target="_blank">Get Adobe Reader </a>
                            <div class="abds">
                                <a onclick="return confirm('External site that opens in a new window.');" href="https://get.adobe.com/reader/" target="_blank">
                                    <img src="/img/holdadbicon.jpg">
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="container">
                        <div class="row">
                            <div class="col">
                            </div>
                            <div class="col">
                            </div>
                            <div class="col text-right p-0">
                                <div class="form-group mt-3">
                                    <button id="btnSave" onclick="GetArchieved();" type="button" class="btn btn-primary">Click here for Archive</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div id="tbl_partial">
                        <partial name="_TenderContractPartial" model="@Model.cont" />
                    </div>
                </div>

            </div>

        </div>
    </div>
</div>

@section Scripts{
    <script>
        // Get debar lists on dropdown change
        function GetArchieved() {
            //debugger;
            ShowLoader();
            var status = "";

            if ($("#btnSave").text() == "Click here for Archive") {
                status = "archive";
                $("#btnSave").text("Back to Current")
            }
            else {
                status = "current";
                $("#btnSave").text("Click here for Archive")
            }
            $.get('../Contracts/MDC-Contracts?handler=BindSelectdata', { Status: status })
                .done(function (data) {
                    if (data) {
                        $("#tbl_partial").html('').html(data);
                        HideLoader();
                    }
                });
        }
    </script>
}