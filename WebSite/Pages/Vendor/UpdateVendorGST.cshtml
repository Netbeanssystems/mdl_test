@page "/{lang}/Vendor/UpdateVendorGST"
@using Microsoft.AspNetCore.Http;
@model WebSite.Pages.Vendor.UpdateVendorGSTModel
@{
    Layout = "_InternalPagesLayout";
    ViewData["Title"] = "Update Vendor GST";
}

<style>
    .hero img {
        width: 100% !important;
    }

    ul.pdf li {
        background: url('/img/icon-pdf.png') no-repeat;
        padding-left: 22px;
    }

    .container3 {
        padding: 23px 10px 10px 10px;
    }

    .container-inner {
        width: 90%;
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px 0;
    }

    .section-title {
        padding: 10px 7rem;
    }

    #list {
        color: #000;
        list-style: disc;
    }
</style>

@if (HttpContext.Session.GetString("Lang") == null || HttpContext.Session.GetString("Lang") == "English")
{
    <div class="hero" style="position: relative;">
        <div class="item"><div class="heading">Update GST for Vendor</div><img src="/assets/images/rti-banner.jpg" alt=""></div>
        <div class="strip"><span><a href="/">Home</a> > <a href="/English/procurement">Procurement</a> > <a href="/English/pages/vendor">Vendor</a> > Update GST for Vendor</span></div>
    </div>
}
else
{
    <div class="hero" style="position: relative;">
        <div class="item"><div class="heading">Update GST for Vendor</div><img src="/assets/images/rti-banner.jpg" alt=""></div>
        <div class="strip"><span><a href="/">Home</a> > <a href="/Hindi/procurement">Procurement</a> > <a href="/Hindi/pages/vendor">Vendor</a> > Update GST for Vendor</span></div>
    </div>
}

<div class="mid-content">
    <div class="container">
        <div class="row">
            @if (HttpContext.Session.GetString("Lang") == null || HttpContext.Session.GetString("Lang") == "English")
            {
                <h3 class="inner-heading">Update GST for Vendor</h3>    
            }
            else
            {
                <h3 class="inner-heading">Update GST for Vendor</h3>
            }
           
            <div class="col-md-12">

                <form method="post" class="row g-3">
                 
                    <div class="col-md-6 offset-md-3">
                        <p>(<b class="text-danger">*</b>) denotes mandatory fields</p>
                        <label for="inputEmail4" asp-for="vendor.VendorCode" class="form-label">Vendor Code<span class="astricks">*</span></label>
                        <input asp-for="vendor.VendorCode" oninput="this.value = this.value.replace(/[^0-9]/g, '').replace(/(\..*?)\..*/g, '$1');" onkeypress="return myKeyPress(event)" placeholder="Vendor Code" class="form-control" id="inputEmail4">
                        <span asp-validation-for="vendor.VendorCode" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 offset-md-3">
                        <label for="inputPassword4" asp-for="vendor.PANNo" class="form-label">PAN No<span class="astricks">*</span></label>
                        <input type="text" maxlength="10" onkeypress="return myKeyPress(event)" oninput="this.value = this.value.replace(/[^A-Za-z0-9]/g, '').replace(/(\..*?)\..*/g, '$1');" asp-for="vendor.PANNo" placeholder="PAN No" class="form-control" id="inputPassword4">
                        <span asp-validation-for="vendor.PANNo" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 offset-md-3">
                        <div class="form-group mt-3">
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <label for="vendor_CaptchaCode" class="sr-only"> capthe code</label>
                                    <img id="img-captcha" src="../Home/GetCaptchaImage" alt="captcha" />
                                </div>
                                <button onclick="speakCaptcha()" aria-label="Play Captcha">🔊</button>
                                <input type="text" class="form-control" oninput="this.value = this.value.replace(/[^A-Za-z0-9@@#$&]/g, '').replace(/(\..*?)\..*/g, '$1');" placeholder="Captcha Code" asp-for="vendor.CaptchaCode" />
                                <div class="input-group-append" title="Reresh Captcha" data-toggle="tooltip" data-placement="top">
                                    <div class="input-group-text" tabindex="0">
                                        <button id="captchaRefresh" class="fa fa-refresh" type="button" aria-label="Refresh CAPTCHA"></button>
                                    </div>
                                </div>
                            </div>
                            <span asp-validation-for="vendor.CaptchaCode" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-md-6 offset-md-3">
                        <button type="submit" class="btn btn-primary">Submit</button>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>

@*<script src="~/js/jquery.min.js" asp-append-version="true"></script>*@
<script src="~/js/jquery-3.6.4.min.js" asp-append-version="true"></script>
@*<script src="~/plugins/jquery-validate/jquery.validate.min.js" asp-append-version="true"></script>*@
<script src="~/plugins/jquery-validate/jquery.validate-1.19.5.min.js" asp-append-version="true"></script>
<script src="~/plugins/jquery-validate/jquery.validate.unobtrusive.min.js" asp-append-version="true"></script>

<script>
    $("#img-captcha,#captchaRefresh").click(function () {
        resetCaptchaImage();
    });
    function resetCaptchaImage() {
        var d = new Date();
        $("#img-captcha").attr("src", "../Home/GetCaptchaImage?" + d.getTime());
    }

    $.validator.setDefaults({
        onkeyup: false
    })
</script>

<script>
    function speakCaptcha() {
        fetch("../Home/GetCaptchaCode")
            .then(response => response.json())
            .then(data => {
                const captcha = data.captcha;

                if (!captcha || captcha.length === 0) {
                    alert("Captcha not loaded");
                    return;
                }

                const msg = new SpeechSynthesisUtterance(captcha);
                msg.lang = 'en-US';
                msg.rate = 0.5;
                window.speechSynthesis.speak(msg);
            })
            .catch(err => {
                console.error("Failed to get captcha", err);
                alert("Failed to get captcha.");
            });
    }
</script>