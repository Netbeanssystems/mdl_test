@page "/{lang}/Vendor/VendorDetails"
@using Microsoft.AspNetCore.Http;
@model WebSite.Pages.Vendor.VendorDetailsModel
@using Microsoft.Extensions.Configuration
@inject IConfiguration config
@{
    Layout = "_InternalPagesLayout";
    ViewData["Title"] = "Vendor Details";
}

<style>
    .hero img {
        width: 100% !important;
    }

    ul.pdf li {
        background: url('/img/icon-pdf.png') no-repeat;
        padding-left: 22px;
    }

    .container3 {
        padding: 23px 10px 10px 10px;
    }

    .container-inner {
        width: 90%;
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px 0;
    }

    .section-title {
        padding: 10px 7rem;
    }

    #list {
        color: #000;
        list-style: disc;
    }
</style>

@if (HttpContext.Session.GetString("Lang") == null || HttpContext.Session.GetString("Lang") == "English")
{
    <div class="hero" style="position: relative;">
        <div class="item"><div class="heading">Vendor GST Details</div><img src="/assets/images/rti-banner.jpg" alt=""></div>
        <div class="strip"><span><a href="/">Home</a> > <a href="/English/procurement">Procurement</a> > <a href="/English/pages/vendor">Vendor</a> > Vendor GST Details</span></div>
    </div>
}
else
{
    <div class="hero" style="position: relative;">
        <div class="item"><div class="heading">Vendor GST Details</div><img src="/assets/images/rti-banner.jpg" alt=""></div>
        <div class="strip"><span><a href="/">Home</a> > <a href="/Hindi/procurement">Procurement</a> > <a href="/Hindi/pages/vendor">Vendor</a> > Vendor GST Details</span></div>
    </div>
}

<div class="mid-content">
    <div class="container">
        <div class="row">
            @if (HttpContext.Session.GetString("Lang") == null || HttpContext.Session.GetString("Lang") == "English")
            {
                <h3 class="inner-heading">Update GST for Vendor</h3>
            }
            else
            {
                <h3 class="inner-heading">Update GST for Vendor</h3>
            }
            

            <div class="offset-md-2 col-md-8">
                <form method="post" class="row g-3" enctype="multipart/form-data">
                    <input type="hidden" asp-for="vendordata.Id" />
                    <table class="table">
                      <tbody>
                          <tr>
                                <td>Vendor Code</td>
                              <td>@Model.vendordata.VendorCode</td>      
                          </tr>
                            <tr>
                                <td>Vendor Name</td>
                                <td>@Model.vendordata.VenderName</td>
                            </tr>
                            <tr>
                                <td>Address</td>
                                <td>@Model.vendordata.VenderAddress</td>
                            </tr>
                            <tr>
                                <td>PAN No</td>
                                <td>@Model.vendordata.Permanent_Account_Number</td>
                            </tr>
                            <tr>
                                <td>Email ID</td>
                                <td>@Model.vendordata.Email_ID</td>
                            </tr>
                            <tr>
                                <td>GST Provisional ID Number</td>
                                <td>
                                    @if (@Model.vendordata.GST_Number == "")
                                    {
                                        <input class="form-control" asp-for="vendordata.GST_Number" placeholder="GST Number" />
                                    }
                                    else
                                    {
                                        <p>@Model.vendordata.GST_Number</p>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <td>Provisional GST Registration Certificate</td>
                                <td>
                                    @if (@Model.vendordata.GST_FileName == "")
                                    {
                                        <input class="form-control Attachment" asp-for="vendordata.GST_File" accept=".jpg, .jpeg, .png,.pdf,.doc,.PDF" />
                                    }
                                    else
                                    {
                                        <a target="_blank" href="@config["FileBaseUrl"]/writereaddata/VenderGST/@Model.vendordata.GST_FileName">Click to View</a>
                                    }
                                </td>
                            </tr>
                      </tbody>
                  </table>
                    @if (@Model.vendordata.GST_FileName == "")
                    {
                        <div class="col-md-6 offset-md-3">
                            <button type="submit" class="btn btn-primary">Submit</button>
                        </div>
                    }
                   
                </form>
            </div>

        </div>
    </div>
</div>