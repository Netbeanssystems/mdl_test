<section class="media">
    <div class="container">
        <div class="row">
            <div class="col-lg-7">
                <div class="media-left">
                    @if (HttpContext.Session.GetString("Lang") == null || HttpContext.Session.GetString("Lang") == "English")
                    {
                        <h2>Media</h2>
                    }
                    else
                    {
                        <h2>
                            मिडिया
                        </h2>
                    }

                    <div class="owl-carousel media-carousal">
                        <vc:media></vc:media>
                    </div>
                    <div class="owlCtrl owlCtrl-4">
                        <span class="play4 active"><i title="Play" role="button" aria-pressed="true" aria-label="Play" class="fa fa-play-circle-o" aria-hidden="true"></i></span>
                        <span class="stop4"><i title="Pause" role="button" aria-pressed="false" aria-label="Pause" class="fa fa-pause-circle-o" aria-hidden="true"></i></span>
                    </div>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="announce blue">
                    @if (HttpContext.Session.GetString("Lang") == null || HttpContext.Session.GetString("Lang") == "English")
                    {
                        <h3><span class="icon-icons4"></span> What's New</h3>
                    }
                    else
                    {
                        <h3><span class="icon-icons4"></span> नया क्या है</h3>
                    }

                    <div class="scroller-mid">
                        <div class="news newsScroll">
                            <vc:Whats-New></vc:Whats-New>
                        </div>
                    </div>
                    <div class="ctrlBtn">
                        <span class="bttest active"><i title="Play" aria-pressed="true" aria-label="Play" class="fa fa-play-circle-o" aria-hidden="true"></i></span>
                        <span class="bttest"><i title="Pause" aria-pressed="false" aria-label="Pause" class="fa fa-pause-circle-o" aria-hidden="true"></i></span>
                    </div>
                </div>
                <div class="announce yellow">
                    @if (HttpContext.Session.GetString("Lang") == null || HttpContext.Session.GetString("Lang") == "English")
                    {
                        <h3><span class="icon-icons9"></span> Announcements</h3>
                    }
                    else
                    {
                        <h3>
                            <span class="icon-icons9"></span>
                            घोषणाएं
                        </h3>
                    }

                    <div class="scroller-mid">
                        <div class="news2 newsScroll">
                            <ul>
                                <vc:announcement></vc:announcement>
                            </ul>
                        </div>
                    </div>
                    <div class="ctrlBtn">
                        <span class="bttest2 active"><i title="Play" aria-pressed="true" aria-label="Play" class="fa fa-play-circle-o" aria-hidden="true"></i></span>
                        <span class="bttest2"><i title="Pause" aria-pressed="false" aria-label="Pause" class="fa fa-pause-circle-o" aria-hidden="true"></i></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

