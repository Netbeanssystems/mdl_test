@page "/{lang}/Tenders/Indigenisation"
@using Microsoft.AspNetCore.Http;
@model WebSite.Pages.Tenders.IND_NotificationModel
@{
    Layout = "_InternalPagesLayout";
     @if (HttpContext.Session.GetString("Lang") == null || HttpContext.Session.GetString("Lang") == "English")
    {
        ViewData["Title"] = "Indigenisation";
    }
    else
    {

        ViewData["Title"] = "स्वदेशीकरण";
    }
}

<style>
    .hero img {
        width: 100% !important;
    }
</style>
<link rel="stylesheet" href="/css/jquery.datatables.min.css" />

@if (HttpContext.Session.GetString("Lang") == null || HttpContext.Session.GetString("Lang") == "English")
{
    <div class="hero" style="position: relative;">
        <div class="item">
            <div class="heading">Indigenisation</div>
            <img class="image1" src="/assets/images/rti-banner.jpg" alt="">
        </div>
        <div class="strip"><a href="/">Home</a> > <a href="/English/procurement">Procurement</a> > <a href="/English/pages/Tenders">Tenders</a> > Indigenisation</div>
    </div>
}
else
{
    <div class="hero" style="position: relative;">
        <div class="item">
            <div class="heading">
                स्वदेशीकरण
            </div>
            <img class="image1" src="/assets/images/rti-banner.jpg" alt="">
        </div>
        <div class="strip"><a href="/">मुख्य पृष्ठ</a> > <a href="/Hindi/procurement">प्रोक्योरमें</a> > <a href="/Hindi/pages/Tenders">निविदाओं</a> > स्वदेशीकरण</div>
    </div>
}

<div class="mid-content">
    <div class="container">
        <div class="row">
            @if (HttpContext.Session.GetString("Lang") == null || HttpContext.Session.GetString("Lang") == "English")
            {
                <h3 class="inner-heading">Indigenisation Notifications / EOI</h3>
            }
            else
            {
                <h3 class="inner-heading">
                    स्वदेशीकरण अधिसूचनाएं/ईओआई
                </h3>
            }

            <div class="card border-0">
                <div class="card-body p-0">
                    <div class="form-group text-right">
                       @if (HttpContext.Session.GetString("Lang") == null || HttpContext.Session.GetString("Lang") == "English")
            {
                            <button id="btnSave" type="button" onclick="GetArchieved();" class="btn btn-primary">Click here for Archive</button>
                        }
                        else
                        {
                            <button id="btnSave" type="button" onclick="GetArchievedHindi();" class="btn btn-primary">पुरालेख के लिए यहां क्लिक करें</button>
                        }
                    </div>
                    @if (HttpContext.Session.GetString("Lang") == null || HttpContext.Session.GetString("Lang") == "English") //AkashS
                    {
                        <div id="tbl_partial">
                            <partial name="_TenderNotificationWithFeePartial" model="@Model.notif" />
                        </div>
                    }
                    else
                    {
                        <div id="tbl_partial">
                            <partial name="_TenderNotificationWithFeePartialHindi" model="@Model.notif" />
                        </div>
                    }
                   @* <div id="tbl_partial">
                        <partial name="_TenderNotificationPartial" model="@Model.notif" />
                    </div>*@
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script>
        // Get lists on dropdown change
        function GetArchieved() {
            var status = "";

            if ($("#btnSave").text() == "Click here for Archive") {
                status = "archive";
                $("#btnSave").text("Back to Current")
            }
            else{
                status = "current";
                $("#btnSave").text("Click here for Archive")
            }

            ShowLoader();
            $.get('../Tenders/Indigenisation?handler=BindSelectdata', { Status: status })
                .done(function (data) {
                    if (data) {
                        $("#tbl_partial").html('').html(data);
                        BindDatatable();
                        HideLoader();
                    }
                });
        }
        function GetArchievedHindi() {
            //;
            ShowLoader();
            var status = "";

            if ($("#btnSave").text() == "पुरालेख के लिए यहां क्लिक करें") {
                status = "archive";
                $("#btnSave").text("वर्तमान पर वापस जाएँ")
            }
            else {
                status = "current";
                $("#btnSave").text("पुरालेख के लिए यहां क्लिक करें")
            }
            $.get('../Tenders/Indigenisation?handler=BindSelectdata', { Status: status })
                .done(function (data) {
                    if (data) {
                        $("#tbl_partial").html('').html(data);
                        BindDatatable();
                        HideLoader();
                    }
                });
        }
