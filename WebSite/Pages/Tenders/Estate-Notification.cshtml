@page "/{lang}/Tenders/Estate-Notification"
@using Microsoft.AspNetCore.Http;
@model WebSite.Pages.Tenders.Estate_NotificationModel
@{
    Layout = "_InternalPagesLayout";
    ViewData["Title"] = "Estate-Notifications";

         @if (HttpContext.Session.GetString("Lang") == null || HttpContext.Session.GetString("Lang") == "English")
    {
        ViewData["Title"] = "Estate-Notifications";
    }
    else
    {

        ViewData["Title"] = "संपदा अधिसूचनाएं";
    }
}

<style>
    .hero img {
        width: 100% !important;
    }
</style>
<link rel="stylesheet" href="/css/jquery.datatables.min.css" />

@if (HttpContext.Session.GetString("Lang") == null || HttpContext.Session.GetString("Lang") == "English")
{
    <div class="hero" style="position: relative;">
        <div class="item"><div class="heading">Estate Notifications / EOI</div><img src="/assets/images/rti-banner.jpg" alt=""></div>
        <div class="strip"><span><a href="/">Home</a> > <a href="/English/procurement">Procurement</a> > <a href="/English/pages/Tenders">Tenders</a> > <a href="/English/pages/Estate">Estate</a> > Estate Notifications / EOI</span></div>
    </div>
}
else
{
    <div class="hero" style="position: relative;">
        <div class="item">संपदा अधिसूचनाएं/ईओआई<div class="heading"></div><img src="/assets/images/rti-banner.jpg" alt=""></div>
        <div class="strip"><span><a href="/">मुख्य पृष्ठ</a> > <a href="/English/procurement">प्रोक्योरमें</a> > <a href="/English/pages/Tenders">निविदाओं</a> > <a href="/Hindi/pages/Estate">Estate</a> > संपदा अधिसूचनाएं/ईओआई</span></div>
    </div>
}

<div class="mid-content">
    <div class="container">
        <div class="row">
            @if (HttpContext.Session.GetString("Lang") == null || HttpContext.Session.GetString("Lang") == "English")
            {
                <h3 class="inner-heading">Estate Notifications / EOI</h3>
            }
            else
            {
                <h3 class="inner-heading">संपदा अधिसूचनाएं/ईओआई</h3>
            }
           
            <div class="card border-0">
                <div class="card-body p-0">
                    <div class="form-group text-right">
                        @if (HttpContext.Session.GetString("Lang") == null || HttpContext.Session.GetString("Lang") == "English")
                        {
                            <button id="btnSave" type="button" onclick="GetArchieved();" class="btn btn-primary">Click here for Archive</button>
                        }
                        else
                        {
                            <button id="btnSave" type="button" onclick="GetArchievedHindi();" class="btn btn-primary">पुरालेख के लिए यहां क्लिक करें</button>
                        }
                    </div>
                    @if (HttpContext.Session.GetString("Lang") == null || HttpContext.Session.GetString("Lang") == "English") //AkashS
                    {
                        <div id="tbl_partial">
                            <partial name="_TenderNotificationWithFeePartial" model="@Model.notif" />
                        </div>
                    }
                    else
                    {
                        <div id="tbl_partial">
                            <partial name="_TenderNotificationWithFeePartialHindi" model="@Model.notif" />
                        </div>
                    }

                   @* <div id="tbl_partial">
                        <partial name="_TenderNotificationWithFeePartial" model="@Model.notif" />
                    </div>*@
                </div>

            </div>

        </div>
    </div>
</div>

@section Scripts{
    <script>
        // Get debar lists on dropdown change
        function GetArchieved() {
            //;
            ShowLoader();
            var status = "";

            if ($("#btnSave").text() == "Click here for Archive") {
                status = "archive";
                $("#btnSave").text("Back to Current")
            }
            else {
                status = "current";
                $("#btnSave").text("Click here for Archive")
            }
            $.get('../Tenders/Estate-Notification?handler=BindSelectdata', { Status: status })
                .done(function (data) {
                    if (data) {
                        $("#tbl_partial").html('').html(data);
                        BindDatatable();
                        HideLoader();
                    }
                });
        }
        function GetArchievedHindi() {
            //;
            ShowLoader();
            var status = "";

            if ($("#btnSave").text() == "पुरालेख के लिए यहां क्लिक करें") {
                status = "archive";
                $("#btnSave").text("वर्तमान पर वापस जाएँ")
