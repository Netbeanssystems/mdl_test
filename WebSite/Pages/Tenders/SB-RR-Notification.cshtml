@* @page "/{lang}/Tenders/MDC-Notification" *@
@page "/{lang}/Tenders/SB-RR-Notification"
@using Microsoft.AspNetCore.Http;
@model WebSite.Pages.Tenders.SB_RR_NotificationModel
@{
     Layout = "_InternalPagesLayout";

      @if (HttpContext.Session.GetString("Lang") == null || HttpContext.Session.GetString("Lang") == "English")
    {
        ViewData["Title"] = "SB-RR-Notification";
    }
    else
    {

        ViewData["Title"] = "एसबी-मरम्मत और पुनःफिट अधिसूचनाएँ";
    }
}

<style>
    .hero img {
        width: 100% !important;
    }
</style>
<link rel="stylesheet" href="/css/jquery.datatables.min.css" />

@if (HttpContext.Session.GetString("Lang") == null || HttpContext.Session.GetString("Lang") == "English")
{
    <div class="hero" style="position: relative;">
        <div class="item"><div class="heading">SB -Repair and Refit Notifications</div><img src="/assets/images/rti-banner.jpg" alt=""></div>
        <div class="strip"><span><a href="/">Home</a> > <a href="/English/procurement">Procurement</a> > <a href="/English/pages/Tenders">Tenders</a> > <a href="/English/Pages/SB-Repair-and-Refit">SB-Repair and Refit</a> > SB -Repair and Refit Notifications</span></div>
    </div>
}
else
{
    <div class="hero" style="position: relative;">
        <div class="item"><div class="heading">एसबी-मरम्मत और पुनःफिट अधिसूचनाएँ</div><img src="/assets/images/rti-banner.jpg" alt=""></div>
        <div class="strip"><span><a href="/">मुख्य पृष्ठ</a> > <a href="/Hindi/procurement">प्रोक्योरमें</a> > <a href="/Hindi/pages/Tenders">निविदाओं</a> > <a href="/Hindi/pages/SB-Repair-and-Refit">एसबी-रिपेर और रिफ़िट </a> > एसबी-मरम्मत और पुनःफिट अधिसूचनाएँ</span></div>
    </div>
}

<div class="mid-content">
    <div class="container">
        <div class="row">
            @if (HttpContext.Session.GetString("Lang") == null || HttpContext.Session.GetString("Lang") == "English")
            {
                <h3 class="inner-heading">SB -Repair and Refit Notifications</h3>
            }
            else
            {
                <h3 class="inner-heading">एसबी-मरम्मत और पुनःफिट अधिसूचनाएँ</h3>
            }

            <div class="card border-0">
                <div class="card-body p-0">
                    <div class="form-group text-right">
                        @if (HttpContext.Session.GetString("Lang") == null || HttpContext.Session.GetString("Lang") == "English")
            {
                            <button id="btnSave" onclick="GetArchieved();" type="button" class="btn btn-primary">Click here for Archive</button>
                        }
                        else
                        {
                            <button id="btnSave" onclick="GetArchievedHindi();" type="button" class="btn btn-primary">पुरालेख के लिए यहां क्लिक करें</button>
                        }
                    </div>
                     @if (HttpContext.Session.GetString("Lang") == null || HttpContext.Session.GetString("Lang") == "English") //AkashS
                    {
                        <div id="tbl_partial">
                            <partial name="_TenderNotificationWithFeePartial" model="@Model.notif" />
                        </div>
                    }
                    else
                    {
                        <div id="tbl_partial">
                            <partial name="_TenderNotificationWithFeePartialHindi" model="@Model.notif" />
                        </div>
                    } 
                    @*<div id="tbl_partial">
                        <partial name="_TenderNotificationWithFeePartial" model="@Model.notif" />
                    </div>*@
                </div>

            </div>

        </div>
    </div>
</div>

@section Scripts{
    <script>
        // Get debar lists on dropdown change
        function GetArchieved() {
            //;
            ShowLoader();
            var status = "";

            if ($("#btnSave").text() == "Click here for Archive") {
                status = "archive";
                $("#btnSave").text("Back to Current")
            }
            else {
                status = "current";
                $("#btnSave").text("Click here for Archive")
            }
            $.get('../Tenders/SB-RR-Notification?handler=BindSelectdata', { Status: status })
                .done(function (data) {
                    if (data) {
                        $("#tbl_partial").html('').html(data);
                        BindDatatable();
                        HideLoader();
                    }
                });
        }
        function GetArchievedHindi() {
            //;
            ShowLoader();
            var status = "";

            if ($("#btnSave").text() == "पुरालेख के लिए यहां क्लिक करें") {
