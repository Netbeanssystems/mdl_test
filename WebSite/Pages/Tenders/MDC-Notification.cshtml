@page "/{lang}/Tenders/MDC-Notification"
@using Microsoft.AspNetCore.Http;
@model WebSite.Pages.Tenders.MDC_NotificationModel
@{
     Layout = "_InternalPagesLayout";
    ViewData["Title"] = "MDC-Notifications";
}

<style>
    .hero img {
        width: 100% !important;
    }
</style>
<link rel="stylesheet" href="/css/jquery.datatables.min.css" />

@if (HttpContext.Session.GetString("Lang") == null || HttpContext.Session.GetString("Lang") == "English")
{
    <div class="hero" style="position: relative;">
        <div class="item"><div class="heading">MDC Notifications / EOI</div><img src="/assets/images/rti-banner.jpg" alt=""></div>
        <div class="strip"><span><a href="/">Home</a> > <a href="/English/procurement">Procurement</a> > <a href="/English/pages/Tenders">Tenders</a> > <a href="/English/pages/Management-Development-Center">Management Development Ceneter</a> > MDC Notifications / EOI</span></div>
    </div>
}
else
{
    <div class="hero" style="position: relative;">
        <div class="item"><div class="heading">MDC Notifications / EOI</div><img src="/assets/images/rti-banner.jpg" alt=""></div>
        <div class="strip"><span><a href="/">Home</a> > <a href="/Hindi/procurement">Procurement</a> > <a href="/Hindi/pages/Tenders">Tenders</a> > <a href="/Hindi/pages/Management-Development-Center">Management Development Ceneter</a> > MDC Notifications / EOI</span></div>
    </div>
}

<div class="mid-content">
    <div class="container">
        <div class="row">
            @if (HttpContext.Session.GetString("Lang") == null || HttpContext.Session.GetString("Lang") == "English")
            {
                <h3 class="inner-heading">MDC Notifications / EOI</h3>
            }
            else
            {
                <h3 class="inner-heading">MDC Notifications / EOI</h3>
            }

            <div class="card border-0">
                <div class="card-body p-0">
                    <div class="form-group text-right">
                        <button id="btnSave" onclick="GetArchieved();" type="button" class="btn btn-primary">Click here for Archive</button>
                    </div>
                    <div id="tbl_partial">
                        <partial name="_TenderNotificationWithFeePartial" model="@Model.notif" />
                    </div>
                </div>

            </div>

        </div>
    </div>
</div>

@section Scripts{
    <script>
        // Get debar lists on dropdown change
        function GetArchieved() {
            //debugger;
            ShowLoader();
            var status = "";

            if ($("#btnSave").text() == "Click here for Archive") {
                status = "archive";
                $("#btnSave").text("Back to Current")
            }
            else {
                status = "current";
                $("#btnSave").text("Click here for Archive")
            }
            $.get('../Tenders/MDC-Notification?handler=BindSelectdata', { Status: status })
                .done(function (data) {
                    if (data) {
                        $("#tbl_partial").html('').html(data);
                        BindDatatable();
                        HideLoader();
                    }
                });
        }
        function BindDatatable() {
            $("#tbl_sbmp_notification").DataTable({
                initComplete: function () {
                    var r = $("#tbl_sbmp_notification tfoot tr");
                    r.find("th").each(function () {
                        if ($(this).hasClass("search")) {
                            $(this).css("padding", 5);
                            var title = $(this).text();
                            $(this).html('<input type="text" class="form-control" placeholder="' + title + '" />');
                        } else {
                            $(this).html("");
                        }
                    });
                    $("#tbl_sbmp_notification thead").prepend(r);
                    this.api().columns().every(function () {
                        var that = this;
                        $("input", this.footer()).on("keyup change clear",
                            function () {
                                if (that.search() !== this.value) {
                                    that.search(this.value).draw();
                                }
                            });
                    });
                }
            });
        }

        $("#tbl_sbmp_notification").DataTable({
            initComplete: function () {
                var r = $("#tbl_sbmp_notification tfoot tr");
                r.find("th").each(function () {
                    if ($(this).hasClass("search")) {
                        $(this).css("padding", 5);
                        var title = $(this).text();
                        $(this).html('<input type="text" class="form-control" placeholder="' + title + '" />');
                    } else {
                        $(this).html("");
                    }
                });
                $("#tbl_sbmp_notification thead").prepend(r);
                this.api().columns().every(function () {
                    var that = this;
                    $("input", this.footer()).on("keyup change clear",
                        function () {
                            if (that.search() !== this.value) {
                                that.search(this.value).draw();
                            }
                        });
                });
            }
        });
    </script>
}
