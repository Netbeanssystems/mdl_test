@page "/{lang}/Stacs/EY-COMM-STACS-Format"
@using Microsoft.AspNetCore.Http;
@using Microsoft.Extensions.Configuration
@inject IConfiguration config
@model WebSite.Pages.Stacs.Submarine_StacsModel
@{
     Layout = "_InternalPagesLayout";
    ViewData["Title"] = "";

           @if (HttpContext.Session.GetString("Lang") == null || HttpContext.Session.GetString("Lang") == "English")
    {
        ViewData["Title"] = "EY COMM STACS Format";
    }
    else
    {

        ViewData["Title"] = "ईवाई कॉम स्टैक्स प्रारूप";
    }
}

<style>
    .hero img {
        width: 100% !important;
    }

    ul.pdf li {
        background: url('/img/icon-pdf.png') no-repeat;
        padding-left: 22px;
    }
    .container3 {
        padding: 23px 10px 10px 10px;
    }

    .container-inner {
        width: 90%;
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px 0;
    }

    .section-title {
        padding: 10px 7rem;
    }

    #list {
        color: #000;
        list-style: disc;
    }

    /* Tab Accordian */


    a {
        color: #192c64;
        text-decoration: none;
        cursor: pointer;
    }

        a:hover {
            text-decoration: none;
            color: #e1ab06;
        }

    .tab-accordian ul {
        padding-left: 22px;
    }

    .tab-accordian p {
        margin-top: 0;
    }

    .tab-accordian {
        width: 100%;
        border-bottom: 2px solid #cecece;
        overflow: hidden;
    }

    .titleWrapper {
        padding: 20px;
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        align-items: center;
        -webkit-user-select: none;
        user-select: none;
        transition: background-color .8s linear;
    }
    /* .titleWrapper.active{
            background: #fff;
        } */
    .desWrapper {
        background: #fff;
        max-height: 500px;
        display: none;
        padding: 0 20px 20px;
        transition: max-height 1s ease-in;
    }

    /* Collapse Icon */

    .collapse-icon {
        position: relative;
    }

        .collapse-icon .acc-close {
            height: 20px;
            border-left: 2px solid #192c64;
            transition: all .5s ease-in-out;
            transform: rotate(-90deg);
            opacity: 1;
        }

        .collapse-icon .acc-open {
            width: 19px;
            position: absolute;
            border-top: 2px solid #192c64;
            transition: all .5s ease-in-out;
            transform: rotate(90deg);
            top: 43%;
            right: -8px;
        }

    .titleWrapper.active .collapse-icon {
        transition: all .5s ease-in-out;
        transform: rotate(180deg);
    }

    .titleWrapper.inactive .collapse-icon {
        transition: all .5s ease-in-out;
        transform: rotate(-180deg);
    }

    .titleWrapper.active .collapse-icon .acc-open {
        opacity: 0;
    }

</style>

@if (HttpContext.Session.GetString("Lang") == null || HttpContext.Session.GetString("Lang") == "English")
{
    <div class="hero" style="position: relative;">
        <div class="item"><div class="heading">EY COMM STACS Format</div><img src="/assets/images/rti-banner.jpg" alt=""></div>
        <div class="strip"><span><a href="/">Home</a> > <a href="/English/procurement">Procurement</a> > <a href="/English/pages/Tenders">Tenders</a> > <a href="/English/pages/EY-Submarine">EY Submarine</a> > EY COMM STACS Format</span></div>
    </div>
}
else
{
    <div class="hero" style="position: relative;">
        <div class="item"><div class="heading">ईवाई कॉम स्टैक्स प्रारूप</div><img src="/assets/images/rti-banner.jpg" alt=""></div>
        <div class="strip"><span><a href="/">मुख्य पृष्ठ</a> > <a href="/English/procurement">प्रोक्योरमें</a> > <a href="/English/pages/Tenders">निविदाओं</a> > <a href="/Hindi/pages/EY-Submarine">ईवाई पनडुब्बी</a> > ईवाई कॉम स्टैक्स प्रारूप</span></div>
    </div>
}

<div class="mid-content">
    <div class="container">
        <div class="row">
            @if (HttpContext.Session.GetString("Lang") == null || HttpContext.Session.GetString("Lang") == "English")
            {
                <h3 class="inner-heading">EY COMM STACS Format</h3>
            }
            else
            {
                <h3 class="inner-heading">ईवाई कॉम स्टैक्स प्रारूप</h3>
            }
            
            <div class="card border-0">
                <div class="card-body p-0">
                    <div class="theinformatoryinfos">
                        @if (HttpContext.Session.GetString("Lang") == null || HttpContext.Session.GetString("Lang") == "English")
                        {
                            <p style="color: #192c64;font-weight: bold;">
                                The STACS and FORMATS given above pertains to the list of tenders mentioned below. However the exact STACS and FORMATS to be used will be mentioned in the individual tender.
                            </p>
                            <p>
                                <strong>Important Information:</strong> All the advertisement Documents, are in PDF format. To view and print the same you need to have Adobe Acrobat Reader which can be freely downloaded from <a href="http://www.adobe.com/" onclick="return confirm('External site that opens in a new window.');" target="_blank">www.adobe.com</a>
                            </p>
                            <div class="adobeholds text-center">
                                <a onclick="return confirm('External site that opens in a new window.');" href="https://get.adobe.com/reader/" target="_blank">Get Adobe Reader </a>
                                <div class="abds">
                                    <a onclick="return confirm('External site that opens in a new window.');" href="https://get.adobe.com/reader/" target="_blank">
                                        <img src="/img/holdadbicon.jpg">
                                    </a>
                                </div>
                            </div>
                        }
                        else
                        {

                            <p style="color: #192c64;font-weight: bold;">

                                ऊपर दिए गए STACS और प्रारूप नीचे उल्लिखित निविदाओं की सूची से संबंधित हैं। हालाँकि उपयोग किए जाने वाले सटीक STACS और प्रारूप का उल्लेख व्यक्तिगत निविदा में किया जाएगा।
                            </p>
                            <p>
                                <strong>महत्वपूर्ण जानकारी:</strong> सभी विज्ञापन दस्तावेज़, पीडीएफ प्रारूप में हैं। इसे देखने और प्रिंट करने के लिए आपके पास Adobe Acrobat Reader होना चाहिए जिसे आसानी से डाउनलोड किया जा सकता है <a href="http://www.adobe.com/" onclick="return confirm('External site that opens in a new window.');" target="_blank">www.adobe.com</a>
                            </p>
                            <div class="adobeholds text-center">
                                <a onclick="return confirm('External site that opens in a new window.');" href="https://get.adobe.com/reader/" target="_blank">एडोब रीडर प्राप्त करें </a>
                                <div class="abds">
                                    <a onclick="return confirm('External site that opens in a new window.');" href="https://get.adobe.com/reader/" target="_blank">
                                        <img src="/img/holdadbicon.jpg">
                                    </a>
                                </div>
                            </div>
                        }
                    </div>

                    @if (Model.cont.stacs.Count > 0)
                    {
                        <div class="tab-accordian">

                            <div class="titleWrapper active">
                                <h5><b>Standard Terms & Conditions</b></h5>

                                <div class="collapse-icon">
                                    <div class="acc-close"></div>
                                    <div class="acc-open"></div>
                                </div>
                            </div>

                            <div id="descwrapper" class="desWrapper" style="display: block;">
                                <ul>
                                    @foreach (var item in Model.cont.stacs)
                                    {
                                        <li id="list">
                                            @*<a href="@config["FileBaseUrl"]/writereaddata/stacs/@item.DocumentPDF" target="_blank">
                                                @item.DocumentName
                                            </a>*@
                                            @if (HttpContext.Session.GetString("Lang") == null || HttpContext.Session.GetString("Lang") == "English")
                                            {
                                                <a href="@config["FileBaseUrl"]/writereaddata/stacs/@item.DocumentPDF" target="_blank">
                                                    <img src="/assets/images/pdf.png" title="Click here to view or download">
                                                    @item.DocumentName
                                                </a>
                                            }
                                            else
                                            {
                                                <a href="@config["FileBaseUrl"]/writereaddata/stacs/@item.DocumentPDF" target="_blank">
                                                    <img src="/assets/images/pdf.png" title="देखने / डाउनलोड करने के ललए यहाीं क्ललक करें">
                                                    @item.DocumentNameHindi
                                                </a>
                                            }
                                        </li>
                                    }
                                </ul>
                            </div>

                        </div>
                    }
                    else
                    {
                        @if (HttpContext.Session.GetString("Lang") == null || HttpContext.Session.GetString("Lang") == "English")
                        {

                            <table id="tbl-career" class="table table-bordered dataTable no-footer" aria-describedby="tbl-career_info" style="margin-top: 18px; ">
                                <tbody>
                                    <tr>
                                        <td colspan="7" class="text-center" style="padding: 20px; font-weight: bold; background-color: #f8f9fa;">
                                            Record not found
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        }
                        else
                        {

                            <table id="tbl-career" class="table table-bordered dataTable no-footer" aria-describedby="tbl-career_info" style="margin-top: 18px; ">
                                <tbody>
                                    <tr>
                                        <td colspan="7" class="text-center" style="padding: 20px; font-weight: bold; background-color: #f8f9fa;">
                                            रिकॉर्ड नहीं मिला
                                        </td>
                                    </tr>
                                </tbody>
                            </table>

                        }
                    }
                    @if (Model.cont.formats.Count > 0)
                    {
                        <div class="tab-accordian">

                            <div class="titleWrapper active">
                                <h5><b>Formats</b></h5>

                                <div class="collapse-icon">
                                    <div class="acc-close"></div>
                                    <div class="acc-open"></div>
                                </div>
                            </div>

                            <div id="descwrapper" class="desWrapper" style="display: block;">
                                <ul>
                                    @foreach (var item in Model.cont.formats)
                                    {
                                        <li id="list">
                                            @if (HttpContext.Session.GetString("Lang") == null || HttpContext.Session.GetString("Lang") == "English")
                                            {
                                                <a href="@config["FileBaseUrl"]/writereaddata/stacs/@item.DocumentPDF" target="_blank">
                                                    @item.DocumentName
                                                </a>
                                            }
                                            else
                                            {
                                                 <a href="@config["FileBaseUrl"]/writereaddata/stacs/@item.DocumentPDF" target="_blank">
                                                    @item.DocumentNameHindi
                                                </a>
                                            }
                                        </li>
                                    }
                                </ul>
                            </div>

                        </div>
                    }

                    @if (Model.cont.others.Count > 0)
                    {
                        <div class="tab-accordian">

                            <div class="titleWrapper active">
                                <h5><b>Others</b></h5>

                                <div class="collapse-icon">
                                    <div class="acc-close"></div>
                                    <div class="acc-open"></div>
                                </div>
                            </div>

                            <div id="descwrapper" class="desWrapper" style="display: block;">
                                <ul>
                                    @foreach (var item in Model.cont.others)
                                    {
                                        <li id="list">
                                            @if (HttpContext.Session.GetString("Lang") == null || HttpContext.Session.GetString("Lang") == "English")
                                            {
                                                <a href="@config["FileBaseUrl"]/writereaddata/stacs/@item.DocumentPDF" target="_blank">
                                                    @item.DocumentName
                                                </a>
                                            }
                                            else
                                            {
                                                <a href="@config["FileBaseUrl"]/writereaddata/stacs/@item.DocumentPDF" target="_blank">
                                                    @item.DocumentNameHindi
                                                </a>
                                            }
                                        </li>
                                    }
                                </ul>
                            </div>

                        </div>
                    }
                </div>
                @if (Model.cont.stacs.Count > 0)
                {
                    <div style="text-align:right;">
                    <span style=" color: #00008B;">Last Updated Date:</span> @Model.cont.stacs.FirstOrDefault().Added_on.ToString("dd-MM-yyyy hh:mm tt")
                    </div>
                }
            </div>

        </div>
    </div>
</div>

@section Scripts{
    <script>
        window.onload = function () {
            jQuery(document).ready(function () {
                jQuery('.titleWrapper').click(function () {
                    var toggle = jQuery(this).next('div#descwrapper');
                    jQuery(toggle).slideToggle("slow");
                });
                jQuery('.inactive').click(function () {
                    jQuery(this).toggleClass('inactive active');
                });
            });
        }
    </script>
}