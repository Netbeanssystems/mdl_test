@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot password";
    Layout = "_LoginLayout";
}
<div class="col-md-4 offset-md-4">
    <div class="card">
        <h5 class="card-header text-center">Forgot your password?</h5>
        <div class="card-body login-card-body">
            <p>Enter username to reset your password...</p>
            <form method="post" autocomplete="off">
                <div class="form-group">
                    <label asp-for="Username" class="col-form-label">Username*</label>
                    <div class="input-group">
                        <input class="form-control" placeholder="Username" asp-for="Username" autocomplete="off" />
                        <div class="input-group-append">
                            <div class="input-group-text">
                                <span class="fa fa-user"></span>
                            </div>
                        </div>
                    </div>
                    <span id="erroruser" asp-validation-for="Username" class="text-danger-sm"></span>
                    <span class="information">Your unique 'Username' with which you created your account with us</span>
                </div>
                <div class="form-group">
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <img id="img-captcha" src="/admin/Common/GetCaptchaImage" alt="captcha" />
                        </div>
                        <button onclick="speakCaptcha()">🔊</button>
                        <input type="text" class="form-control" placeholder="Captcha Code" asp-for="CaptchaCode" />
                        <div class="input-group-append" title="Reresh Captcha" data-toggle="tooltip" data-placement="top">
                            <div class="input-group-text">
                                <span id="captchaRefresh" class="fa fa-redo"></span>
                            </div>
                        </div>
                    </div>
                    <span asp-validation-for="CaptchaCode" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <button type="submit" class="btn btn-primary btn-block">Submit</button>
                </div>
            </form>
            <div class="form-group float-left">
                <a asp-page="ForgotUsername" class="text-center">Forgot Username?</a>
            </div>
            <div class="form-group float-right">
                <a asp-page="Login" class="text-center">Sign in</a>
            </div>
            <div class="clearfix"></div>
        </div>
    </div>
</div>
@section Scripts{

    <script>
        function speakCaptcha() {
             fetch("../../Common/GetCaptchaCode")
                .then(response => response.json())
                .then(data => {
                    const captcha = data.captcha;

                    if (!captcha || captcha.length === 0) {
                        alert("Captcha not loaded");
                        return;
                    }

                    const msg = new SpeechSynthesisUtterance(captcha);
                    msg.lang = 'en-US';
                    msg.rate = 0.5;
                    window.speechSynthesis.speak(msg);
                })
                .catch(err => {
                    console.error("Failed to get captcha", err);
                    alert("Failed to get captcha.");
                });
        }
    </script>
    <script type="text/javascript">
        $("#img-captcha,#captchaRefresh").click(function () {
            resetCaptchaImage();
            setTimeout(() => speakCaptcha(), 300);
        });
        function resetCaptchaImage() {
            var d = new Date();
            $("#img-captcha").attr("src", "/admin/Common/GetCaptchaImage?" + d.getTime());
        }

        $('#CaptchaCode').on('blur', function () {
            var capcha = $(this).val();
            if (capcha.length > 0) {
                $.get("/admin/Account/ForgotPassword?handler=Validatecapcha", { CaptchaCode: capcha })
                    .done(function (data) {

                        if (data != capcha) {
                            $("#divClientAlert").addClass("alert-danger");
                            $("#divClientAlert > p.m-0").text("Please Enter Valid Captcha");
                            $("#divClientAlert").show();
                            SetTimeOut($("#divClientAlert"));
                            resetCaptchaImage();
                            $("#CaptchaCode").val("");
                        }
                    });
            }
        });

        $(function () {
            $("#Username").keypress(function (e) {
                var keyCode = e.keyCode || e.which;

                $("#erroruser").html("");

                //Regex for Valid Characters i.e. Alphabets and Numbers.
                var regex = /^[ A-Za-z0-9_@@.-]*$/
                //Validate TextBox value against the Regex.
                var isValid = regex.test(String.fromCharCode(keyCode));
                if (!isValid) {
                    $("#erroruser").html("Invalid Input.");
                }

                return isValid;
            });
        });
    </script>
}