@model AcademicYearsDTO
<div class="modal fade" id="ManageModal" data-backdrop="static" tabindex="-1" role="dialog" aria-labelledby="ManageModalTitle" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <form method="post" asp-page-handler="Manage">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CreatedDate" />
            <input type="hidden" asp-for="CreatedBy" />
            <input type="hidden" asp-for="StartDate" />
            <input type="hidden" asp-for="EndDate" />
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="ManageModalTitle">Academic Year</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label asp-for="Year" class="col-form-label">Year<span class="required">*</span></label>
                        <input asp-for="Year" class="form-control" placeholder="Year" autocomplete="on" />
                        <span asp-validation-for="Year" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Description" class="col-form-label">Description<span class="required">*</span></label>
                        <input asp-for="Description" onkeypress="return myKeyPress(event)" class="form-control" placeholder="Description" autocomplete="on" />
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label for="StartDate0" class="col-form-label">Start Date<span class="required">*</span></label>
                        <input type="text" class="form-control bg-white" id="StartDate0" value="@(Model?.StartDate!=null ? $"{Model.StartDate:dd-MM-yyyy}":"")" placeholder="dd-mm-yyyy" readonly="readonly">
                        <span asp-validation-for="StartDate" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label for="EndDate0" class="col-form-label">End Date<span class="required">*</span></label>
                        <input type="text" class="form-control bg-white" id="EndDate0" value="@(Model?.EndDate!=null ? $"{Model.EndDate:dd-MM-yyyy}":"")" placeholder="dd-mm-yyyy" readonly="readonly">
                        <span asp-validation-for="EndDate" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <div class="custom-control custom-switch custom-switch-on-primary">
                            <input asp-for="IsActive" class="custom-control-input">
                            <label asp-for="IsActive" class="custom-control-label">Active</label>
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="custom-control custom-switch custom-switch-on-primary">
                            <input asp-for="FinancialYearActive" class="custom-control-input">
                            <label asp-for="FinancialYearActive" class="custom-control-label">Financial Year Active</label>
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="custom-control custom-switch custom-switch-on-primary">
                            <input asp-for="FundRequestAllowed" class="custom-control-input">
                            <label asp-for="FundRequestAllowed" class="custom-control-label">Fund Request Allowed</label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button id="btnSave" type="button" class="btn btn-primary">Save</button>
                    <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                </div>
            </div>
        </form>
    </div>
</div>