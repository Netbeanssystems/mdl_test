@model Application.ViewModels.PetrolPriceBuildupListVM
@if (Model?.Tempphotogallery?.Count > 0)
{
    <div class="table-responsive">
        <table id="tblTempNewProjects" class="table table-sm table-bordered table-striped">

            <thead>
                <tr>
                    <th>ID</th>
                    <th>Request Date</th>
                    <th>English Title</th>
                    <th>Hindi Title</th>
                    <th>English Image Path</th>
                    <th>Hindi Image Path</th>
                    <th>User</th>
                    <th>Role</th>
                    <th>Action</th>
                    <th>Status</th>
                    @if (Model.role == "SuperAdmin" || Model.role == "Admin" || Model.role == "Publisher")
                    {
                        <th>Action</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Tempphotogallery.Where(a => a.Active))
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@($"{item.ActionDate:dd/MM/yyyy hh:mm tt}")</td>
                        <td>@item.EnglishHeading</td>
                        <td>@item.HindiHeading</td>
                        <td><a target="_blank" href="/admin/img/UploadedFiles/EventPhotos/EnglishPhoto/@item.EnglishAttachment">Click to View</a> </td>
                        <td><a target="_blank" href="/admin/img/UploadedFiles/EventPhotos/HindiPhoto/@item.HindiAttachment">Click to View</a></td>
                        <td>@item.UserName</td>
                        <td>@item.RoleName</td>
                        <td>@item.Action</td>
                        <td>@item.Status</td>
                        <td>
                            @if ((Model.role == "SuperAdmin" || Model.role == "Admin" || Model.role == "Publisher") && item.Status != "Approved")
                            {
                                <a class="fa fa-edit text-danger" title="Approval" asp-page="Approve" asp-route-id="@item.Id"></a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <p>No records has been added yet. Click 'Create New' to start adding.</p>
}