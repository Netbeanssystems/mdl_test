@model Application.ViewModels.PetrolPriceBuildupListVM
@if (Model?.TempvdoVM?.Count > 0)
{
    <div class="table-responsive">
        <table id="tblTempNewProjects" class="table table-sm table-bordered table-striped">

            <thead>
                <tr>
                    <th>ID</th>
                    <th>Request Date</th>
                    <th>English Heading</th>
                    <th>Hindi Heading</th>
                    <th>English Category</th>
                    <th>Hindi Category</th>
                    <th>English Thumbnail Link</th>
                    <th>Hindi Thumbnail Link</th>
                    <th>User</th>
                    <th>Role</th>
                    <th>Action</th>
                    <th>Status</th>
                    @if (Model.role == "SuperAdmin" || Model.role == "Publisher")
                    {
                        <th>Action</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.TempvdoVM.Where(a => a.Active))
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@($"{item.ActionDate:dd/MM/yyyy hh:mm tt}")</td>
                        <td>@item.EnglishHeading</td>
                        <td>@item.HindiHeading</td>
                        <td>@item.EnglishCategory</td>
                        <td>@item.HindiCategory</td>
                        <td>@item.EnglishThumbnailLink</td>
                        <td>@item.HindThumbnailLink</td>
                        <td>@item.UserName</td>
                        <td>@item.RoleName</td>
                        <td>@item.Action</td>
                        <td>@item.Status</td>
                        <td>
                            @if ((Model.role == "SuperAdmin" || Model.role == "Publisher") && item.Status != "Approved")
                            {
                                <a class="fa fa-edit text-danger" title="Approval" asp-page="Approve" asp-route-id="@item.Id"></a>
                            }
                            @*@if (Model.role == "Editors" && item.RowId.HasValue && item.Status != "Approved")
                                {
                                    <a class="fa fa-edit text-danger" title="Edit" asp-page="Manage" asp-route-id="@(item.RowId)"></a>
                                }*@
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <p>No records has been added yet. Click 'Create New' to start adding.</p>
}