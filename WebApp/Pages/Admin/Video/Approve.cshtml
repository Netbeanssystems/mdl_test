@page "{id}"
@model WebApp.Pages.Admin.Video.ApproveModel
@{
    ViewData["Title"] = "Video Approve";
}

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title float-left">Approve Content</h3>
                    </div>
                    <div class="card-body">
                        <form method="post" enctype="multipart/form-data">
                            <input type="hidden" asp-for="TempDTO.Id" />
                            <input type="hidden" asp-for="TempDTO.ActionDate" />
                            <input type="hidden" asp-for="TempDTO.RowId" />
                            <input type="hidden" asp-for="TempDTO.EnglishHeading" />
                            <input type="hidden" asp-for="TempDTO.HindiHeading" />
                            <input type="hidden" asp-for="TempDTO.EnglishThumbnailLink" />
                            <input type="hidden" asp-for="TempDTO.HindThumbnailLink" />
                            <input type="hidden" asp-for="TempDTO.EnglishLink" />
                            <input type="hidden" asp-for="TempDTO.HindiLink" />
                            <input type="hidden" asp-for="TempDTO.EnglishCategory" />
                            <input type="hidden" asp-for="TempDTO.HindiCategory" />
                            <div class="form-group form-row">
                                <label class="col-md-3 col-lg-2 col-form-label">Pending For</label>
                                <div class="col-md-9 col-lg-10">
                                    <input asp-for="TempDTO.Action" class="form-control" readonly="readonly" />
                                    <span asp-validation-for="TempDTO.Action" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="form-group form-row">
                                <label class="col-md-3 col-lg-2 col-form-label">Requested On</label>
                                <div class="col-md-9 col-lg-10">
                                    <input value="@($"{Model.TempDTO.ActionDate.AddHours(5.5):dd/MM/yyyy hh:mm tt}")" class="form-control" readonly="readonly" />
                                    <span asp-validation-for="TempDTO.ActionDate" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="form-group form-row">
                                <label class="col-md-3 col-lg-2 col-form-label">Requested By</label>
                                <div class="col-md-4 col-lg-5">
                                    <input asp-for="TempDTO.RoleName" class="form-control" readonly="readonly" />
                                </div>
                                <div class="col-md-5 col-lg-5">
                                    <input asp-for="TempDTO.UserName" class="form-control" readonly="readonly" />
                                </div>
                                <span asp-validation-for="TempDTO.RoleName" class="text-danger"></span>
                                <span asp-validation-for="TempDTO.UserName" class="text-danger"></span>
                            </div>


                            <div class="form-group form-row">
                                <label asp-for="TempDTO.EnglishHeading" class="col-md-3 col-lg-2" style="margin-top: 6px;">English Heading<span class="required">*</span></label>
                                <div class="col-md-3 col-lg-3">
                                    <input asp-for="TempDTO.EnglishHeading" id="txtenglishname" class="form-control" placeholder="English Name" autocomplete="on" />
                                    <span asp-validation-for="TempDTO.EnglishHeading" class="text-danger"></span>
                                    <br />
                                </div>
                                <label asp-for="TempDTO.HindiHeading" class="col-md-3 col-lg-2" style="margin-top: 6px;">&nbsp;&nbsp;  Hindi Heading<span class="required">*</span></label>
                                <div class="col-md-3 col-lg-3">
                                    <input asp-for="TempDTO.HindiHeading" id="txthindiname" class="form-control" placeholder="Hindi Name" autocomplete="on" />
                                    <span asp-validation-for="TempDTO.HindiHeading" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="form-group form-row">
                                <label asp-for="TempDTO.EnglishCategory" class="col-md-3 col-lg-2" style="margin-top: 6px;"> English Caption<span class="required">*</span></label>
                                <div class="col-md-3 col-lg-3">
                                    <input asp-for="TempDTO.EnglishCategory" id="txtEnglishCategory" class="form-control" placeholder="English Category" autocomplete="on" />
                                    <span asp-validation-for="TempDTO.EnglishCategory" class="text-danger"></span>
                                    <br />
                                </div>
                                <label asp-for="TempDTO.HindiCategory" class="col-md-3 col-lg-2" style="margin-top: 6px;">&nbsp;&nbsp;  Hindi Caption<span class="required">*</span></label>
                                <div class="col-md-3 col-lg-3">
                                    <input asp-for="TempDTO.HindiCategory" id="txtHindiCategory" class="form-control" placeholder="Hindi Category" autocomplete="on" />
                                    <span asp-validation-for="TempDTO.HindiCategory" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="form-group form-row">
                                <label asp-for="TempDTO.EnglishLink" class="col-md-3 col-lg-2" style="margin-top: 6px;">English Link<span class="required">*</span></label>
                                <div class="col-md-3 col-lg-3">
                                    <input asp-for="TempDTO.EnglishLink" id="txtEnglishLink" class="form-control" placeholder="English Name" autocomplete="on" />
                                    <span asp-validation-for="TempDTO.EnglishLink" class="text-danger"></span>
                                    <br />
                                </div>
                                <label asp-for="TempDTO.HindiLink" class="col-md-3 col-lg-2" style="margin-top: 6px;">&nbsp;&nbsp;  Hindi Link<span class="required">*</span></label>
                                <div class="col-md-3 col-lg-3">
                                    <input asp-for="TempDTO.HindiLink" id="txtHindiLink" class="form-control" placeholder="Hindi Name" autocomplete="on" />
                                    <span asp-validation-for="TempDTO.HindiLink" class="text-danger"></span>
                                </div>
                            </div>


                            <div class="form-group form-row">
                                <label asp-for="TempDTO.EnglishThumbnailLink" class="col-md-3 col-lg-2" style="margin-top: 6px;">English Thumbnail Link<span class="required">*</span></label>
                                <div class="col-md-3 col-lg-3">
                                    <input asp-for="TempDTO.EnglishThumbnailLink" id="txtEnglishThumbnailLink" class="form-control" placeholder="English Name" autocomplete="on" />
                                    <span asp-validation-for="TempDTO.EnglishThumbnailLink" class="text-danger"></span>
                                    <br />
                                </div>
                                <label asp-for="TempDTO.HindThumbnailLink" class="col-md-3 col-lg-2" style="margin-top: 6px;">&nbsp;&nbsp;Hindi Thumbnail Link<span class="required">*</span></label>
                                <div class="col-md-3 col-lg-3">
                                    <input asp-for="TempDTO.HindThumbnailLink" id="txtHindThumbnailLink" class="form-control" placeholder="Hindi Name" autocomplete="on" />
                                    <span asp-validation-for="TempDTO.HindThumbnailLink" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-9 offset-md-3 col-lg-10 offset-lg-2">
                                    <div class="custom-control custom-checkbox">
                                        <input asp-for="TempDTO.Active" class="custom-control-input" checked>
                                        <label asp-for="TempDTO.Active" class="custom-control-label">Show</label>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group offset-md-3 offset-lg-2">
                                <div class="btn-group">
                                    <input type="submit" class="btn btn-success" asp-page-handler="Approve" value="Approve" />
                                    <input type="submit" asp-page-handler="Reject" class="btn btn-danger" value="Reject" />
                                    <a class="btn btn-secondary" asp-page="Index">Back</a>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            @*@if (!Model.IsNew)
                {
                    <form method="post" asp-page-handler="Delete">
                        <input type="hidden" asp-for="TempNewProject.Id" />
                        <partial name="_ConfirmationModalPartial" model=@("Are you sure you want to delete this item? This can not be undone.") />
                    </form>
                }*@
        </div>
    </div>
</section>

@section Scripts{
    <script type="text/javascript" asp-append-version="true">

        $(document).ready(function () {
            //< !--Allow only alphanumeric-- >
            $('#txtenglishname').on('keypress', function (e) {
                var regex = new RegExp("^[a-zA-Z0-9(),./-]+$");
                var key = String.fromCharCode(!event.charCode ? event.which : event.charCode);
                if (!regex.test(key) && event.charCode != '8' && event.charCode != '32') {
                    event.preventDefault();
                    return false;
                }
            });

            $('#txthindiname').on('keypress', function (e) {
