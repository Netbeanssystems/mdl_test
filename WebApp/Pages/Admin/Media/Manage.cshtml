@page "{id?}"
@model WebApp.Pages.Admin.PressRelease.ManageModel
@{
    ViewData["Title"] = "Manage Press Release";
}

@section Styles
    {
    <link href="~/plugins/summernote/summernote-bs4.css" rel="stylesheet" asp-append-version="true" />
}
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12">
                <div class="card">
                    <div class="card-header">
                        @if (!Model.IsNew)
                        {
                            <h3 class="card-title float-left">Edit Media</h3>
                            <div class="btn-group btn-group-sm float-right">
                                <button class="btn btn-sm btn-danger" data-toggle="modal" data-target="#confirmationModal"><i class="fa fa-times"></i> Delete</button>
                                <a class="btn btn-sm btn-secondary" asp-page="Index"><i class="fa fa-arrow-left"></i> Back</a>
                            </div>
                            <div class="clearfix"></div>
                        }
                        else
                        {
                            <h3 class="card-title float-left">Add Media</h3>
                            <a class="btn btn-sm btn-secondary float-right" asp-page="Index"><i class="fa fa-arrow-left"></i> Back</a>
                            <div class="clearfix"></div>
                        }
                    </div>
                    <div class="card-body">
                        <form method="post" enctype="multipart/form-data">
                            <input type="hidden" asp-for="modelDTO.Id" />
                            <input type="hidden" asp-for="modelDTO.EnglishImage" />
                            <input type="hidden" asp-for="modelDTO.HindiImage" />
                            <input type="hidden" asp-for="modelDTO.EnglishFile" />
                            <input type="hidden" asp-for="modelDTO.HindiFile" />


                            <div class="form-group form-row">
                                <label asp-for="modelDTO.EnglishHeading" class="col-md-3 col-lg-2" style="margin-top: 6px;">English Heading<span class="required">*</span></label>
                                <div class="col-md-3 col-lg-3">
                                    <input asp-for="modelDTO.EnglishHeading" id="txtenglishname" class="form-control" placeholder="English Name" autocomplete="on" />
                                    <span asp-validation-for="modelDTO.EnglishHeading" class="text-danger"></span>
                                    <br />
                                </div>
                                <label asp-for="modelDTO.HindiHeading" class="col-md-3 col-lg-2" style="margin-top: 6px;">&nbsp;&nbsp;  Hindi Heading<span class="required">*</span></label>
                                <div class="col-md-3 col-lg-3">
                                    <input asp-for="modelDTO.HindiHeading" id="txthindiname" class="form-control" placeholder="Hindi Name" autocomplete="on" />
                                    <span asp-validation-for="modelDTO.HindiHeading" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="form-group form-row">
                                <label asp-for="modelDTO.Tag" class="col-md-3 col-lg-2" style="margin-top: 6px;">English Tag<span class="required">*</span></label>
                                <div class="col-md-3 col-lg-3">
                                    <input asp-for="modelDTO.Tag" id="txttag" class="form-control" placeholder="English Name" autocomplete="on" />
                                    <span asp-validation-for="modelDTO.Tag" class="text-danger"></span>
                                    <br />
                                </div>
                                <label asp-for="modelDTO.HindiTag" class="col-md-3 col-lg-2" style="margin-top: 6px;">&nbsp;&nbsp;  Hindi Tag<span class="required">*</span></label>
                                <div class="col-md-3 col-lg-3">
                                    <input asp-for="modelDTO.HindiTag" id="txthindi" class="form-control" placeholder="Hindi Name" autocomplete="on" />
                                    <span asp-validation-for="modelDTO.HindiTag" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="form-group form-row">
                                <label asp-for="modelDTO.EnglishHeading" class="col-md-3 col-lg-2" style="margin-top: 6px;">Date<span class="required">*</span></label>
                                <div class="col-md-3 col-lg-3">
                                    <input type="text" id="NewsDate" asp-for="modelDTO.UploadedDate" class="form-control bg-white" placeholder="dd-mm-yyyy" />
                                    <span asp-validation-for="modelDTO.UploadedDate " class="text-danger"></span>
                                    <input type="hidden" asp-for="modelDTO.UploadedDate" />
                                </div>
                            </div>

                            @*@if (!Model.IsNew)
                            {
                                <div class="form-group form-row">
                                    <label asp-for="modelDTO.EnglishHeading" class="col-md-3 col-lg-2" style="margin-top: 6px;">Date<span class="required">*</span></label>
                                    <div class="col-md-3 col-lg-3">
                                        <input type="text" id="NewsDateEdit" asp-for="modelDTO.UploadedDate" class="form-control bg-white" placeholder="dd-mm-yyyy" />
                                        <span asp-validation-for="modelDTO.UploadedDate " class="text-danger"></span>
                                        <input type="hidden" asp-for="modelDTO.UploadedDate" />
                                    </div>
                                </div>

                            }
                            else
                            {*@
                                @*<div class="form-group form-row">
                                    <label asp-for="modelDTO.EnglishHeading" class="col-md-3 col-lg-2" style="margin-top: 6px;">Date<span class="required">*</span></label>
                                    <div class="col-md-3 col-lg-3">
                                        <input type="text" id="NewsDate" class="form-control bg-white" placeholder="dd-mm-yyyy" />
                                        <span asp-validation-for="modelDTO.UploadedDate " class="text-danger"></span>
                                        <input type="hidden" asp-for="modelDTO.UploadedDate" />
                                    </div>
                                </div>*@
                           @* }*@

                            <div class="nav nav-tabs" id="nav-tab" style="background-color: lavender;" role="tablist">
                                <a class="nav-item nav-link active" id="nav-UploadFile-tab" data-toggle="tab" href="#nav-UploadFile" role="tab" aria-controls="nav-profile" aria-selected="false">Upload File </a>
                                <a class="nav-item nav-link" id="nav-Content-tab" data-toggle="tab" href="#nav-Content" role="tab" aria-controls="nav-profile" aria-selected="false">Content</a>
                            </div>

                            <div class="tab-pane fade show active" id="nav-UploadFile" role="tabpanel" aria-labelledby="nav-UploadFile-tab">

                                @if (!Model.IsNew)
                                {
                                    <div class="form-group form-row mt-3">
                                        <label class="col-md-3 col-lg-2 col-form-label">View English Image</label>
                                        <div class="col-md-5 col-lg-5"><span class="FD"></span><a href="~/img/UploadedFiles/Videos/PhotoGalleryImage/@Model.modelDTO.EnglishImage" target="_blank" class="btn btn-success">File</a></div>
                                        <br />
                                    </div>

                                    <div id="nav-UploadFile" role="tabpanel" aria-labelledby="nav-UploadFile-tab">
                                        <div class="row">
                                            <div class="col-md-4"><span class="FD">Upload English Image</span><br /><input class="form-control Attachment" asp-for="modelDTO.FileEnglish" /></div>
                                        </div>
                                    </div>

                                    <div class="form-group form-row mt-3">
                                        <label class="col-md-3 col-lg-2 col-form-label">View Hindi Image</label>
                                        <div class="col-md-5 col-lg-5"><span class="FD"></span><a href="~/img/UploadedFiles/Videos/PhotoGalleryImage/@Model.modelDTO.HindiImage" target="_blank" class="btn btn-success">File</a></div>
                                        <br />
                                    </div>

                                    <div id="nav-UploadFile" role="tabpanel" aria-labelledby="nav-UploadFile-tab">
                                        <div class="row">
                                            <div class="col-md-4"><span class="FD">Upload Hindi Image</span><br /><input class="form-control Attachment" asp-for="modelDTO.FileHindi" /></div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="row">
                                        <div class="col-md-4"><span class="FD">English Image</span><br /><input class="form-control Attachment" asp-for="modelDTO.FileEnglish" /></div>
                                        <div class="col-md-4"><span class="FD">Hindi Image</span><br /><input class="form-controlAttachment" asp-for="modelDTO.FileHindi" /></div>
                                    </div>
                                }

                            </div>

                            <div class="tab-pane fade" id="nav-Content" role="tabpanel" aria-labelledby="nav-Contact-tab">
                                <div class="row">
                                    <div class="col-md-10">
                                        <span class="FD">English Content</span>
                                        <textarea class="form-control" asp-for="modelDTO.EnglishContent" cols="30" rows="3" id="EnglishContentDesc"></textarea>
                                    </div>
                                    <br />
                                    <div class="col-md-10">
                                        <span class="FD">Hindi Content</span>
                                        <textarea class="form-control" cols="30" rows="3" asp-for="modelDTO.HindiContent" id="HindiContentDesc"></textarea>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group form-row">
                                <label class="col-md-3 col-lg-2"></label>
                                <div class="col-md-9 col-lg-10">
                                    <div class="custom-control custom-checkbox mr-sm-2">
                                        <input asp-for="modelDTO.Show" class="custom-control-input">
                                        <label asp-for="modelDTO.Show" class="custom-control-label">Active</label>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group offset-md-3 offset-lg-2">
                                <div class="btn-group">
                                    <button type="submit" class="btn btn-success"><i class="fa fa-save"></i> Save Heading</button>&nbsp;
                                    <a class="btn btn-secondary" asp-page="Index"><i class="fa fa-arrow-left"></i> Back</a>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            @if (!Model.IsNew)
            {
                <form method="post" asp-page-handler="Delete">
                    <input type="hidden" asp-for="modelDTO.Id" />
                    <partial name="_ConfirmationModalPartial" model=@("Are you sure you want to delete this item? This can not be undone.") />
                </form>
            }
        </div>
    </div>
</section>

@section Scripts
    {
    <script src="~/plugins/summernote/summernote-bs4.min.js" asp-append-version="true"></script>
    @* <script src="~/plugins/Tinymce/tinymce.min.js"></script>*@
    @* <script src="~/js/custom/MenuTextEditor.js"></script>*@

    <script type="text/javascript" asp-append-version="true">

        //Initalize daterange
        var today = new Date();
        $('#NewsDate').daterangepicker({
            "showDropdowns": true, //to show dropdowns for Month and year
            "singleDatePicker": true, //to show single date picker not range
            "locale": {
                //"format": "MM/DD/YYYY",
                "format": "DD/MM/YYYY",
                "separator": " - "
            },
            //"minDate": today,
        },
            function (start, end, label) {
                $('#modelDTO_UploadedDate').val(start.format('YYYY-MM-DD'));
                $('#NewsDate').val(start.format('DD/MM/YYYY'));
                //$('#NewsDate').val(start.format('MM/DD/YYYY'));
            });


        $("#EnglishContentDesc").summernote({
            height: 300,                 // set editor height
            minHeight: null,             // set minimum height of editor
            maxHeight: null             // set maximum height of editor
        });
        $("#HindiContentDesc").summernote({
            height: 300,                 // set editor height
            minHeight: null,             // set minimum height of editor
            maxHeight: null             // set maximum height of editor
        });


        $(document).ready(function () {
            //< !--Allow only alphanumeric-- >
            $('#txtenglishname').on('keypress', function (e) {
                var regex = new RegExp("^[a-zA-Z0-9(),./-]+$");
                var key = String.fromCharCode(!event.charCode ? event.which : event.charCode);
                if (!regex.test(key) && event.charCode != '8' && event.charCode != '32') {
                    event.preventDefault();
                    return false;
                }
            });

            $('#txthindiname').on('keypress', function (e) {
                var regex = new RegExp("^[a-zA-Z0-9(),./-]+$");
                var key = String.fromCharCode(!event.charCode ? event.which : event.charCode);
                if (!regex.test(key) && event.charCode != '8' && event.charCode != '32') {
                    event.preventDefault();
                    return false;
                }
            });
            $('#txttag').on('keypress', function (e) {
                var regex = new RegExp("^[a-zA-Z0-9(),./-]+$");
                var key = String.fromCharCode(!event.charCode ? event.which : event.charCode);
                if (!regex.test(key) && event.charCode != '8' && event.charCode != '32') {
                    event.preventDefault();
                    return false;
                }
            });

            $('#txthindi').on('keypress', function (e) {
                var regex = new RegExp("^[a-zA-Z0-9(),./-]+$");
                var key = String.fromCharCode(!event.charCode ? event.which : event.charCode);
                if (!regex.test(key) && event.charCode != '8' && event.charCode != '32') {
                    event.preventDefault();
                    return false;
                }
            });
        });
    </script>

}