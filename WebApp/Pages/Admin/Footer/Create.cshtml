@page
@model WebApp.Pages.Admin.Footer.CreateModel
@{
    ViewData["Title"] = "New Footer Content";
}

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title float-left">Create Footer Content</h3>
                        <a class="btn btn-sm btn-secondary float-right" asp-page="Index"><i class="fa fa-arrow-left"></i> Back</a>
                        <div class="clearfix"></div>
                    </div>
                    <div class="card-body">
                        <form method="post" enctype="multipart/form-data">
                            <input type="hidden" asp-for="footer.Id" />

                            <div class="form-group form-row">
                                <label asp-for="footer.EnglishTitle" class="col-md-3 col-lg-2">English Heading<span class="required">*</span></label>
                                <div class="col-md-3 col-lg-3">
                                    <input asp-for="footer.EnglishTitle" id="txtenglishname" class="form-control" placeholder="English Name" autocomplete="on" />
                                    <span asp-validation-for="footer.EnglishTitle" class="text-danger"></span>

                                </div>
                                <label asp-for="footer.HindiTitle" class="col-md-3 col-lg-2">&nbsp;&nbsp;  Hindi Heading<span class="required">*</span></label>
                                <div class="col-md-3 col-lg-3">
                                    <input asp-for="footer.HindiTitle" id="txthindiname" class="form-control" placeholder="Hindi Name" autocomplete="on" />
                                    <span asp-validation-for="footer.HindiTitle" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="form-group form-row">
                                <label asp-for="footer.EnglishPageLink" class="col-md-3 col-lg-2">English Title<span class="required">*</span></label>
                                <div class="col-md-3 col-lg-3">
                                    <input asp-for="footer.EnglishPageLink" id="txtTitle" class="form-control" placeholder="English Name" autocomplete="on" />
                                    <span asp-validation-for="footer.EnglishPageLink" class="text-danger"></span>

                                </div>
                                <label asp-for="footer.HindiPageLink" class="col-md-3 col-lg-2">Hindi Title<span class="required">*</span></label>
                                <div class="col-md-3 col-lg-3">
                                    <input asp-for="footer.HindiPageLink" id="txtHindiTitle" class="form-control" placeholder="Hindi Title" autocomplete="on" />
                                    <span asp-validation-for="footer.HindiPageLink" class="text-danger"></span>

                                </div>
                            </div>
