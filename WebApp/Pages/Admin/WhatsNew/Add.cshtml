    @page "{pid:int?}"
@model WebApp.Pages.Admin.WhatsNew.AddModel
@{
    ViewData["Title"] = "Add News";
}

@section Styles
    {
    <link href="~/plugins/summernote/summernote-bs4.css" rel="stylesheet" asp-append-version="true" />
}

    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title float-left">Create What's New Headings</h3>
                            <a class="btn btn-sm btn-secondary float-right" asp-page="Index"><i class="fa fa-arrow-left"></i> Back</a>
                            <div class="clearfix"></div>
                        </div>
                        <div class="card-body">
                            <form method="post" enctype="multipart/form-data">
                                <input type="hidden" asp-for="Whats.Id" />
                                <input type="hidden" asp-for="Whats.ParentId" value="@Model.pid" />

                                <div class="form-group form-row">
                                    <label asp-for="Whats.EnglishHeadingName" class="col-md-3 col-lg-2" style="margin-top: 6px;color:#925959;font-weight:500">English Heading<span class="required">*</span></label>
                                    <div class="col-md-3 col-lg-3">
                                        <input asp-for="Whats.EnglishHeadingName" id="txtenglishname" class="form-control" placeholder="English Name" autocomplete="on" />
                                        <span asp-validation-for="Whats.EnglishHeadingName" class="text-danger"></span>
                                        <br />
                                    </div>
                                    <label asp-for="Whats.HindiHeadingName" class="col-md-3 col-lg-2" style="margin-top: 6px;color:#925959;font-weight:500">&nbsp;&nbsp;  Hindi Heading<span class="required">*</span></label>
                                    <div class="col-md-3 col-lg-3">
                                        <input asp-for="Whats.HindiHeadingName" id="txthindiname" class="form-control" placeholder="Hindi Name" autocomplete="on" />
                                        <span asp-validation-for="Whats.HindiHeadingName" class="text-danger"></span>
                                    </div>
                                </div>


                                <nav>
                                    <div class="nav nav-tabs" id="nav-tab" style="background-color: lavender;" role="tablist">
                                        <a class="nav-item nav-link active" id="nav-PageLink-tab" data-toggle="tab" href="#nav-PageLink" role="tab" aria-controls="nav-home" aria-selected="true">Page Link</a>
                                        <a class="nav-item nav-link" id="nav-UploadFile-tab" data-toggle="tab" href="#nav-UploadFile" role="tab" aria-controls="nav-profile" aria-selected="false">Upload File</a>
                                        <a class="nav-item nav-link" id="nav-Content-tab" data-toggle="tab" href="#nav-Content" role="tab" aria-controls="nav-profile" aria-selected="false">Content</a>

                                        <label for="NewsDate" class="col-md-3 col-lg-2" style="margin-top: 6px;color:cornflowerblue;font-weight:500">Publishing Date</label>
                                        <div class="col-md-3 col-lg-3">
                                            <input type="text" id="NewsDate" class="form-control bg-white" placeholder="dd-mm-yyyy" readonly="readonly" />
                                            <span asp-validation-for="Whats.PublishDate " class="text-danger"></span>
                                            <input type="hidden" asp-for="Whats.PublishDate" />
                                        </div>
                                    </div>
                                </nav>
                                <div class="tab-content" id="nav-tabContent" style="background-color: #f4f5f7; padding: 10px;">
                                    <input type="hidden" id="LastSelectedId" />
                                    <div class="tab-pane fade show active" id="nav-PageLink" role="tabpanel" aria-labelledby="nav-PageLink-tab">
                                        <div class="row">
                                            <div class="col-md-4">
                                                <span class="FD">English Link</span><input class="form-control" asp-for="Whats.EnglishPageLink" />
                                                <span asp-validation-for="Whats.EnglishPageLink" class="text-danger"></span>
                                            </div>
                                            <div class="col-md-4">
                                                <span class="FD">Hindi Link</span><input class="form-control" asp-for="Whats.HindiPageLink" />
                                                <span asp-validation-for="Whats.HindiPageLink" class="text-danger"></span>
                                            </div>
                                            <br />
                                        </div>
                                    </div>
                                    <div class="tab-pane fade" id="nav-UploadFile" role="tabpanel" aria-labelledby="nav-UploadFile-tab">
                                        <div class="row">
                                            <div class="col-md-4"><span class="FD">English File</span><input class="form-control Attachment" accept=".pdf,.PDF" asp-for="Whats.EnglishFile" /></div>
                                            <div class="col-md-4"><span class="FD">Hindi File</span><input class="form-control Attachment" accept=".pdf,.PDF" asp-for="Whats.HindiFile" /></div>
                                            <br />
                                        </div>
                                    </div>
                                    <div class="tab-pane fade" id="nav-Content" role="tabpanel" aria-labelledby="nav-Contact-tab">
                                        <div class="row">
                                            <div class="col-md-10">
                                                <span class="FD">English Content</span>
                                                <textarea class="form-control" asp-for="Whats.EnglishContentDesc" cols="30" rows="3" id="EnglishContentDesc"></textarea>
                                            </div>
                                            <br />
                                            <div class="col-md-10">
                                                <span class="FD">Hindi Content</span>
                                                <textarea class="form-control" cols="30" rows="3" asp-for="Whats.HindiContentDesc" id="HindiContentDesc"></textarea>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="form-group form-row">
                                    <label class="col-md-3 col-lg-2"></label>
                                    <div class="col-md-9 col-lg-10">
                                        <div class="custom-control custom-checkbox mr-sm-2">
                                            <input asp-for="Whats.Show" class="custom-control-input">
                                            <label asp-for="Whats.Show" class="custom-control-label">Active</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group offset-md-3 offset-lg-2">
                                    <div class="btn-group">
                                        <button type="submit" class="btn btn-success"><i class="fa fa-save"></i> Save Heading</button>&nbsp;
                                        <a class="btn btn-secondary" asp-page="Index"><i class="fa fa-arrow-left"></i> Back</a>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    @section Scripts
    {
    <script src="~/plugins/summernote/summernote-bs4.min.js" asp-append-version="true"></script>
    <script type="text/javascript" asp-append-version="true">

        var today = new Date();
        $('#NewsDate').daterangepicker({
            "showDropdowns": true, //to show dropdowns for Month and year
            "singleDatePicker": true, //to show single date picker not range
            "locale": {
                "format": "DD-MM-YYYY",
                "separator": " - "
            },
            //"minDate": today,
        },
            function (start, end, label) {
                //$('#modelDTO_NewsDate').val(start.format('YYYY-MM-DDThh:mm'));
                //$('#Whats_PublishDate').val(start.format('YYYY-MM-DDThh:mm'));
                $('#Whats_PublishDate').val(start.format('YYYY-MM-DD'));
                $('#NewsDate').val(start.format('DD/MM/YYYY'));
            });

        //Initialize wysihtml
        $("#EnglishContentDesc").summernote({
            height: 300,                 // set editor height
            minHeight: null,             // set minimum height of editor
            maxHeight: null             // set maximum height of editor
        });
        $("#HindiContentDesc").summernote({
            height: 300,                 // set editor height
            minHeight: null,             // set minimum height of editor
            maxHeight: null             // set maximum height of editor
        });

        $(document).ready(function () {
            //< !--Allow only alphanumeric-- >
            $('#txtenglishname').on('keypress', function (e) {
                var regex = new RegExp("^[a-zA-Z0-9(),./-]+$");
                var key = String.fromCharCode(!event.charCode ? event.which : event.charCode);
                if (!regex.test(key) && event.charCode != '8' && event.charCode != '32') {
                    event.preventDefault();
                    return false;
                }
            });

            $('#txthindiname').on('keypress', function (e) {
                var regex = new RegExp("^[a-zA-Z0-9(),./-]+$");
                var key = String.fromCharCode(!event.charCode ? event.which : event.charCode);
                if (!regex.test(key) && event.charCode != '8' && event.charCode != '32') {
                    event.preventDefault();
                    return false;
                }
            });
        });
    </script>
}