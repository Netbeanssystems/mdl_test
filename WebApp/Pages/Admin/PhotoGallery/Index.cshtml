@page
@model WebApp.Pages.Admin.PhotoGallery.IndexModel
@{
    ViewData["Title"] = "PhotoGallery Update";
}


<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12">
                <div class="card">
                    <div class="card-header">
                        <h3>
                            <span class="float-left">Event Gallery</span>
                            <span class="float-right"><a class="btn btn-sm btn-primary ml-2" asp-page="Events/Index"><i class="fa fa-save"></i> Add Events</a></span>
                            <span class="float-right"><a class="btn btn-sm btn-primary" asp-page="Manage"><i class="fa fa-save"></i> Add Photos</a></span>
                            <span class="clearfix"></span>
                        </h3>
                    </div>
                    @Html.AntiForgeryToken()

                    <div class="card-body">
                        @if (Model.ModelVMs != null && Model.ModelVMs.Count > 0)
                        {
                            <div class="table-responsive">
                                <table id="tblpressrelease" class="table table-sm table-bordered table-striped">
                                    <thead>
                                        <tr>
                                            <th>Event</th>
                                            <th>English Heading</th>
                                            <th>Hindi Heading</th>
                                           @* <th>English Image</th>
                                            <th>Hindi Image</th>*@
                                            <th class="text-center">Show</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.ModelVMs)
                                        {
                                            <tr>
                                                <td>@item.EventName</td>
                                                <td>@item.EnglishHeading</td>
                                                <td>@item.HindiHeading</td>
                                                @*<td><img height="20%" width="20%" src="/admin/img/UploadedFiles/EventPhotos/EnglishPhoto/@item.EnglishAttachment" /></td>
                                                <td><img height="20%" width="20%" src="/admin/img/UploadedFiles/EventPhotos/HindiPhoto/@item.HindiAttachment" /></td>*@
                                                <td class="text-center">@Html.Raw(item.Active ? "<i class=\"fa fa-check-circle text-success\"></i>" : "<i class=\"fa fa-times-circle text-danger\"></i>")</td>
                                                <td><a class="fa fa-edit text-danger" title="Edit" asp-page="Manage" asp-route-id="@item.Id"></a></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p>No records has been added yet. Click 'Create New' to start adding.</p>
                        }
                    </div>


                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts{
    <script type="text/javascript" asp-append-version="true">
        $('#tblpressrelease').DataTable({
            "paging": true,
            "lengthChange": true,
            "searching": true,
            "ordering": true,
            "info": true,
            "autoWidth": false,
            "rowReorder": {
                "selector": 'td:nth-child(2)'
            },
            "responsive": true,
            "order": [[0, "desc"]]
        });
    </script>
}
