@page "{id?}"
@model WebApp.Pages.Admin.PhotoGallery.ManageModel
@{
    ViewData["Title"] = "Manage Event Gallery";
}

@section Styles
    {
    <link href="~/plugins/summernote/summernote-bs4.css" rel="stylesheet" asp-append-version="true" />
}

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12">
                <div class="card">
                    <div class="card-header">
                        @if (!Model.IsNew)
                        {
                            <h3 class="card-title float-left">Edit Event Photos</h3>
                            <div class="btn-group btn-group-sm float-right">
                                <button class="btn btn-sm btn-danger" data-toggle="modal" data-target="#confirmationModal"><i class="fa fa-times"></i> Delete</button>
                                <a class="btn btn-sm btn-secondary" asp-page="Index"><i class="fa fa-arrow-left"></i> Back</a>
                            </div>
                            <div class="clearfix"></div>
                        }
                        else
                        {
                            <h3 class="card-title float-left">Create Event Photos</h3>
                            <a class="btn btn-sm btn-secondary float-right" asp-page="Index"><i class="fa fa-arrow-left"></i> Back</a>
                            <div class="clearfix"></div>
                        }
                    </div>
                    <div class="card-body">
                        <form method="post" enctype="multipart/form-data">

                            <input type="hidden" asp-for="modelDTO.Id" />
                            <input type="hidden" asp-for="modelDTO.ShowEnglishImage" />
                            <input type="hidden" asp-for="modelDTO.ShowHindiImage" />
                            <input type="hidden" asp-for="modelDTO.EnglishAttachment" />
                            <input type="hidden" asp-for="modelDTO.HindiAttachment" />

                            <div class="form-group  form-row">
                                <label asp-for="modelDTO.EventId" class="w-100 mb-0">Event<span class="required">*</span></label>
                                <select asp-for="modelDTO.EventId" asp-items="ViewBag.events" class="browser-default custom-select" id="ddlPriorty" class="w-100 mb-0">
                                    <option value="0">--Select One--</option>
                                </select>
                            </div>
                            <div class="form-group form-row">
                                <label asp-for="modelDTO.EnglishHeading" class="col-md-3 col-lg-2" style="margin-top: 6px;">English Title<span class="required">*</span></label>
                                <div class="col-md-3 col-lg-3">
                                    <input asp-for="modelDTO.EnglishHeading" id="txtenglishname" class="form-control" placeholder="English Name" autocomplete="on" />
                                    <span asp-validation-for="modelDTO.EnglishHeading" class="text-danger"></span>
                                    <br />
                                </div>
                                <label asp-for="modelDTO.HindiHeading" class="col-md-3 col-lg-2" style="margin-top: 6px;">&nbsp;&nbsp;  Hindi Title<span class="required">*</span></label>
                                <div class="col-md-3 col-lg-3">
                                    <input asp-for="modelDTO.HindiHeading" class="form-control" placeholder="Hindi Name" autocomplete="on" />
                                    <span asp-validation-for="modelDTO.HindiHeading" class="text-danger"></span>
                                </div>
                            </div>

                            @if (!Model.IsNew)
                            {
                                <div class="row">
                                    <label class="col-md-3 col-lg-2 col-form-label">View English Attachment</label>
                                    <div class="col-md-5 col-lg-5"><span class="FD"></span><a href="~/img/UploadedFiles/EventPhotos/EnglishPhoto/@Model.modelDTO.EnglishAttachment" target="_blank" class="btn btn-success">File</a></div>
                                    <br />
                                </div>

                                <div id="nav-UploadFile" role="tabpanel" aria-labelledby="nav-UploadFile-tab">
                                    <div class="row">
                                        <div class="col-md-4"><span class="FD">Upload English Attachment</span><br /><input class="form-control Attachment" asp-for="modelDTO.EnglishAttachmentfile" /></div>
                                    </div>
                                </div>

                                <div class="row">
                                    <label class="col-md-3 col-lg-2 col-form-label">View Hindi Attachment</label>
                                    <div class="col-md-5 col-lg-5"><span class="FD"></span><a href="~/img/UploadedFiles/EventPhotos/HindiPhoto/@Model.modelDTO.HindiAttachment" target="_blank" class="btn btn-success">File</a></div>
                                    <br />
                                </div>

                                <div id="nav-UploadFile" role="tabpanel" aria-labelledby="nav-UploadFile-tab">
                                    <div class="row">
                                        <div class="col-md-4"><span class="FD">Upload Hindi Attachment</span><br /><input class="form-control Attachment" asp-for="modelDTO.HindiAttachmentfile" /></div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div id="nav-UploadFile" role="tabpanel" aria-labelledby="nav-UploadFile-tab">
                                    <div class="row">
                                        <div class="col-md-4"><span class="FD">Upload English Photo</span><br /><input class="form-control Attachment" asp-for="modelDTO.EnglishAttachmentfile" /></div>

                                        <div class="col-md-4"><span class="FD">Upload Hindi Photo</span><br /><input class="form-control Attachment" asp-for="modelDTO.HindiAttachmentfile" /></div>

                                    </div>
                                </div>
                            }

                            <div class="col-md-10 mt-3">
                                <span class="FD">English Description</span><span class="required">*</span>
                                <textarea class="form-control" asp-for="modelDTO.EnglishDescp" cols="30" rows="3" id="EnglishContentDesc"></textarea>
                            </div>

                            <div class="col-md-10">
                                <span class="FD">Hindi Description</span><span class="required">*</span>
                                <textarea class="form-control" asp-for="modelDTO.HindiDescp" cols="30" rows="3" id="HindiContentDesc"></textarea>
                            </div>

                            <div class="form-group form-row">
                                <label class="col-md-3 col-lg-2"></label>
                                <div class="col-md-9 col-lg-10">
                                    <div class="custom-control custom-checkbox mr-sm-2">
                                        <input asp-for="modelDTO.Active" class="custom-control-input">
                                        <label asp-for="modelDTO.Active" class="custom-control-label">Active</label>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group offset-md-3 offset-lg-2">
                                <div class="btn-group">
                                    <button type="submit" class="btn btn-success"><i class="fa fa-save"></i> Save Heading</button>&nbsp;
                                    <a class="btn btn-secondary" asp-page="Index"><i class="fa fa-arrow-left"></i> Back</a>
                                </div>
                            </div>

                        </form>
                    </div>
                </div>
            </div>

            @if (!Model.IsNew)
            {
                <form method="post" asp-page-handler="Delete">
                    <input type="hidden" asp-for="modelDTO.Id" />
                    <partial name="_ConfirmationModalPartial" model=@("Are you sure you want to delete this item? This can not be undone.") />
                </form>
            }
        </div>
    </div>
</section>


@section Scripts
    {
    <script src="~/plugins/summernote/summernote-bs4.min.js" asp-append-version="true"></script>
    <script type="text/javascript" asp-append-version="true">
        //Initialize wysihtml
        $("#EnglishContentDesc").summernote({
            height: 300,                 // set editor height
            minHeight: null,             // set minimum height of editor
            maxHeight: null             // set maximum height of editor
        });
        $("#HindiContentDesc").summernote({
            height: 300,                 // set editor height
            minHeight: null,             // set minimum height of editor
            maxHeight: null             // set maximum height of editor
        });

        $(document).ready(function () {
            $("#divaward").hide();
            $('#ddlPriorty').on('change', function () {
                if (this.value === '2') {
                    $("#divaward").show();
                } else {
                    $("#divaward").hide();
                }
            });


            //< !--Allow only alphanumeric-- >

            $('#txtenglishname').on('keypress', function (e) {
                var regex = new RegExp("^[a-zA-Z0-9(),./-&']+$");
                var key = String.fromCharCode(!event.charCode ? event.which : event.charCode);
                if (!regex.test(key) && event.charCode != '8' && event.charCode != '32') {
                    event.preventDefault();
                    return false;
                }
            });

            //$('#txthindiname').on('keypress', function (e) {
            //    var regex = new RegExp("^[a-zA-Z0-9(),./-&']+$");
            //    var key = String.fromCharCode(!event.charCode ? event.which : event.charCode);
            //    if (!regex.test(key) && event.charCode != '8' && event.charCode != '32') {
            //        event.preventDefault();
            //        return false;
            //    }
            //});

            $('#txtEnglishCategory').on('keypress', function (e) {
                var regex = new RegExp("^[a-zA-Z0-9(),./-&']+$");
                var key = String.fromCharCode(!event.charCode ? event.which : event.charCode);
                if (!regex.test(key) && event.charCode != '8' && event.charCode != '32') {
                    event.preventDefault();
                    return false;
                }
            });

            $('#txtHindiCategory').on('keypress', function (e) {
                var regex = new RegExp("^[a-zA-Z0-9(),./-&']+$");
                var key = String.fromCharCode(!event.charCode ? event.which : event.charCode);
                if (!regex.test(key) && event.charCode != '8' && event.charCode != '32') {
                    event.preventDefault();
                    return false;
                }
            });
        });
    </script>
}
