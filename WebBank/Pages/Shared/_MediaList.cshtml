@model Application.ViewModels.PetrolPriceBuildupListVM


@if (Model?.tempmedia != null && Model.tempmedia.Count > 0)
{
    <div class="table-responsive">
        <table id="tblTempNewProjects" class="table table-sm table-bordered table-striped">

            <thead>
                <tr>
                    <th>ID</th>
                    <th>Request Date</th>
                    <th>English Heading</th>
                    <th>Hindi Heading</th>
                    <th>English Image</th>
                    <th>Hindi Image</th>
                    <th>User</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Row Id</th>
                    @if (Model.role == "Administrators" || Model.role == "SuperAdmin" || Model.role == "Publisher")
                    {
                        <th>Action</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.tempmedia.Where(a => a.Show))
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@($"{item.ActionDate:dd-MMM-yyyy}")</td>
                        <td>@item.EnglishHeading</td>
                        <td>@item.HindiHeading</td>
                        <td>@item.EnglishFile</td>
                        <td>@item.HindiFile</td>
                        <td>@item.UserName</td>
                        <td>@item.RoleName</td>
                        <td>@item.Status</td>
                        <td>@item.RowId</td>
                        <td>
                            @if ((Model.role == "Administrators" || Model.role == "SuperAdmin" || Model.role == "Publisher") && item.Status != "Approved")
                            {
                                <a class="fa fa-edit text-danger" title="Approve" asp-page="Approve" asp-route-id="@item.Id"></a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <p>No records has been added yet. Click 'Create New' to start adding.</p>
}