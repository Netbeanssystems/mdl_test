@page
@model WebBank.Pages.Admin.OpeningInvestmentWindow.IndexModel
@{
    ViewData["Title"] = "Manage Investment Windows";
}
@section Scripts
{
    @* Generate Anti-Forgery token to validate incoming HTTP requests context securely *@
    @Html.AntiForgeryToken()

    <script type="text/javascript" asp-append-version="true">
        $(document).ready(function () {
        let selectedCheckbox = null;
        let targetValue = false;

        // Handle checkbox state changing event
        $('.chk-window-visibility').on('change', function (e) {
        // Prevent normal instant state changes until verified
        e.preventDefault();
                        
        selectedCheckbox = $(this);
                        
        // Read current checked state BEFORE the click handler changes the visual DOM representation
        targetValue = selectedCheckbox.is(':checked');
                        
        // Instantly flip it back visually while we show the confirmation popup modal
        selectedCheckbox.prop('checked', !targetValue);
                        
        // Explicitly trigger the Bootstrap modal popup view
        $('#confirmVisibilityModal').modal('show');
        });

        // If user confirms change intent
        $('#btnConfirmVisibility').click(function () {
        if (!selectedCheckbox) return;

        const windowId = parseInt(selectedCheckbox.attr('data-id'));
        if (isNaN(windowId)) {
        alert("Invalid target window element identifier.");
        return;
        }

        // Setup array payload matching your API endpoint's expected List<ClosedWindowsDTO>
        const payload = [{
        id: windowId,
        isShow: targetValue
        }];

        // Setup visual processing loading state within confirm button
        const confirmBtn = $(this);
        const originalHtml = confirmBtn.html();
        confirmBtn.prop('disabled', true).html('<i class="fas fa-circle-notch fa-spin mr-1"></i> Saving...');
        $('#btnCancelVisibility, #btnModalCloseCross').prop('disabled', true);

        $.ajax({
        url: '/api/Documents/UpdateMultipleVisibility',
        type: 'PUT',
        contentType: 'application/json',
        data: JSON.stringify(payload),
        headers: {
        "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
        },
        success: function (response) {
        // Success: Keep the new checked state visually and close modal layout safely
        selectedCheckbox.prop('checked', targetValue);
        $('#confirmVisibilityModal').modal('hide');
                                
        // Force a fresh reload to sync UI state tracking completely with database realities
        location.reload();
        },
        error: function (xhr) {
        alert("An error occurred while updating backend row entities: " + xhr.responseText);
        // Revert visual state on explicit failure state transitions
        selectedCheckbox.prop('checked', !targetValue);
        $('#confirmVisibilityModal').modal('hide');
        },
        complete: function () {
        // Reset structural elements processing configurations
        confirmBtn.prop('disabled', false).html(originalHtml);
        $('#btnCancelVisibility, #btnModalCloseCross').prop('disabled', false);
        selectedCheckbox = null;
        }
        });
        });

        // Revert references cleanly if modal gets closed out via cancel actions
        $('#confirmVisibilityModal').on('hidden.bs.modal', function () {
        selectedCheckbox = null;
        });
        });
    </script>

    <script type="text/javascript" asp-append-version="true">
        document.addEventListener("DOMContentLoaded", function () {
            
        // ==========================================
        // 1. LIVE SEARCH LOGIC
        // ==========================================
        const searchInput = document.getElementById("txtSearchWindows");
        const table = document.getElementById("tblInvestmentWindows");
            
        if (searchInput && table) {
        const rows = table.querySelectorAll("tbody tr");
                
        searchInput.addEventListener("input", function () {
        const filter = this.value.toLowerCase().trim();
                    
        rows.forEach(row => {
        // Check match against Description (col index 1) and Opened By (col index 2)
        const descText = row.cells[1]?.textContent.toLowerCase() || "";
        const userText = row.cells[2]?.textContent.toLowerCase() || "";
                        
        if (descText.includes(filter) || userText.includes(filter)) {
        row.style.display = "";
        } else {
        row.style.display = "none";
        }
        });
        });
        }

        // ==========================================
        // 2. DOUBLE-CLICK SORT LOGIC
        // ==========================================
        if (table) {
        const headers = table.querySelectorAll("thead th");
        const tbody = table.querySelector("tbody");
        let currentIsAsc = true;

        headers.forEach((header, index) => {
        // Skip the action if it's the IsShow column toggle layout switch
        if (index === 4) return;

        header.addEventListener("dblclick", function () {
        const type = this.getAttribute("data-type");
        const rowsArray = Array.from(tbody.querySelectorAll("tr"));
                        
        // Toggle ascending / descending order state
        currentIsAsc = !currentIsAsc;

        // Sort operations
        rowsArray.sort((rowA, rowB) => {
        let cellA = rowA.cells[index];
        let cellB = rowB.cells[index];

        // Check if a dedicated data sorting value exists (used for Dates and sequence IDs)
        let valA = cellA.hasAttribute("data-sort-val") ? cellA.getAttribute("data-sort-val") : cellA.textContent.trim();
        let valB = cellB.hasAttribute("data-sort-val") ? cellB.getAttribute("data-sort-val") : cellB.textContent.trim();

        if (type === "number") {
        return currentIsAsc ? parseFloat(valA) - parseFloat(valB) : parseFloat(valB) - parseFloat(valA);
        } else if (type === "date") {
        return currentIsAsc ? new Date(valA) - new Date(valB) : new Date(valB) - new Date(valA);
        } else {
        // Default string comparison behavior
        return currentIsAsc ? valA.localeCompare(valB) : valB.localeCompare(valA);
        }
        });

        // Re-append sorted rows into DOM architecture safely
        rowsArray.forEach(row => tbody.appendChild(row));

        // Dynamic FontAwesome dynamic icon visual feedback updates
        headers.forEach(h => {
        const icon = h.querySelector("i");
        if (icon) icon.className = "fas fa-sort text-muted ml-1 small";
        });
        const currentIcon = this.querySelector("i");
        if (currentIcon) {
        currentIcon.className = currentIsAsc ? "fas fa-sort-up text-dark ml-1" : "fas fa-sort-down text-dark ml-1";
        }
        });
        });
        }
        });
    </script>
}
<section class="content pt-4">
    <div class="container-fluid">
        <div class="card">
            <!-- Added Search Box to the right side of the card header -->
            <div class="card-header bg-white d-flex align-items-center justify-content-between flex-wrap gap-2">
                <h3 class="card-title font-weight-bold text-dark mb-0">
                    Closed Investment Window
                </h3>
                <div class="search-box-container" style="max-width: 300px; width: 100%;">
                    <div class="input-group input-group-sm">
                        <div class="input-group-prepend">
                            <span class=" border-right-0"> Search: &nbsp;
                        </div>
                        <input type="text" id="txtSearchWindows" class="form-control " placeholder="Search windows..." autocomplete="off" />
                    </div>
                </div>
            </div>
            
            <div class="card-body bg-light">
                @if (Model.ClosedWindowsVM != null && Model.ClosedWindowsVM.Any())
                {
                    <div class="table-responsive shadow-sm rounded">
                        <table class="table table-sm table-hover table-bordered bg-white mb-0" id="tblInvestmentWindows">
                            <thead class="thead-light">
                                <!-- Added non-selectable styles and instruction hints via titles -->
                                <tr style="user-select: none;-webkit-user-select: none;">
                                    <th class="text-center cursor-pointer" style="width: 80px;" title="Double click to sort" data-type="number">ID <i class="fas fa-sort text-muted ml-1 small"></i></th>
                                    <th class="cursor-pointer" title="Double click to sort" data-type="string">Window Description <i class="fas fa-sort text-muted ml-1 small"></i></th>
                                    <th class="text-center cursor-pointer" title="Double click to sort" data-type="string">Window Opened By <i class="fas fa-sort text-muted ml-1 small"></i></th>
                                    <th class="text-center cursor-pointer" title="Double click to sort" data-type="date">Window Opening Date <i class="fas fa-sort text-muted ml-1 small"></i></th>
                                    <th class="text-center" style="width: 140px;">IsShow</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var index = 0;
                                }
                                @foreach (var window in Model.ClosedWindowsVM)
                                {
                                    index++;
                                    <tr>
                                        <td class="text-center font-weight-bold align-middle" data-sort-val="@index">@index</td>
                                        <td class="align-middle">@window.Description</td>
                                        <td class="text-center align-middle text-muted">@window.CreatedBy</td>
                                        <!-- Added data-sort-val with raw ISO date format string for precise date chronologies -->
                                        <td class="text-center align-middle text-muted" data-sort-val="@window.CreatedDate.ToString("yyyy-MM-ddTHH:mm:ss")">
                                            @window.CreatedDate.ToString("dd/MM/yyyy HH:mm")
                                        </td>
                                        <td class="text-center align-middle">
                                            <div class="custom-control custom-switch">
                                                <input type="checkbox" class="custom-control-input chk-window-visibility"
                                                       id="switch_@window.Id" data-id="@window.Id" @(window.IsShow ? "checked" : "") />
                                                <label class="custom-control-label cursor-pointer" for="switch_@window.Id"></label>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-4 border bg-white rounded">
                        <i class="fas fa-folder-open text-muted fa-2x mb-2"></i>
                        <p class="text-muted mb-0">No investment window tracks were recovered from the database infrastructure.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<!-- Reusable Bootstrap Confirmation Modal -->
<div class="modal fade" id="confirmVisibilityModal" tabindex="-1" role="dialog" aria-labelledby="confirmModalLabel" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title font-weight-bold" id="confirmModalLabel">
                    <i class="fas fa-exclamation-triangle mr-2"></i> Confirm Action
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close" id="btnModalCloseCross">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body text-dark font-weight-normal py-4">
                Are you sure you want to change the visibility status for this investment window tracking entity?
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary shadow-sm" data-dismiss="modal" id="btnCancelVisibility">Cancel</button>
                <button type="button" class="btn btn-warning font-weight-bold shadow-sm" id="btnConfirmVisibility">
                    <i class="fas fa-check mr-1"></i> Yes, Update
                </button>
            </div>
        </div>
    </div>
</div>




