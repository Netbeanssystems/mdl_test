@page "{id?}"
@model WebBank.Pages.Admin.Video.ManageModel
@{
    ViewData["Title"] = "Manage Video";
}

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12">
                <div class="card">
                    <div class="card-header">
                        @if (!Model.IsNew)
                        {
                            <h3 class="card-title float-left">Edit Heading</h3>
                            <div class="btn-group btn-group-sm float-right">
                                <button class="btn btn-sm btn-danger" data-toggle="modal" data-target="#confirmationModal"><i class="fa fa-times"></i> Delete</button>
                                <a class="btn btn-sm btn-secondary" asp-page="Index"><i class="fa fa-arrow-left"></i> Back</a>
                            </div>
                            <div class="clearfix"></div>
                        }
                        else
                        {
                            <h3 class="card-title float-left">Create Heading</h3>
                            <a class="btn btn-sm btn-secondary float-right" asp-page="Index"><i class="fa fa-arrow-left"></i> Back</a>
                            <div class="clearfix"></div>
                        }
                    </div>
                    <div class="card-body">
                        <form method="post" enctype="multipart/form-data">
                            @if (Model.modelDTO != null)
                            {

                                <input type="hidden" asp-for="modelDTO.Id" />

                            }


                            <div class="form-group form-row">
                                <label asp-for="modelDTO.EnglishHeading" class="col-md-3 col-lg-2" style="margin-top: 6px;">English Heading<span class="required">*</span></label>
                                <div class="col-md-3 col-lg-3">
                                    <input asp-for="modelDTO.EnglishHeading" id="txtenglishname" class="form-control" placeholder="English Name" autocomplete="on" />
                                    <span asp-validation-for="modelDTO.EnglishHeading" class="text-danger"></span>
                                    <br />
                                </div>
                                <label asp-for="modelDTO.HindiHeading" class="col-md-3 col-lg-2" style="margin-top: 6px;">&nbsp;&nbsp;  Hindi Heading<span class="required">*</span></label>
                                <div class="col-md-3 col-lg-3">
                                    <input asp-for="modelDTO.HindiHeading" id="txthindiname" class="form-control" placeholder="Hindi Heading" autocomplete="on" />
                                    <span asp-validation-for="modelDTO.HindiHeading" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="form-group form-row">
                                <label asp-for="modelDTO.EnglishCategory" class="col-md-3 col-lg-2" style="margin-top: 6px;">English Caption<span class="required">*</span></label>
                                <div class="col-md-3 col-lg-3">
                                    <input asp-for="modelDTO.EnglishCategory" id="txtEnglishCategory" class="form-control" placeholder="English Category" autocomplete="on" />
                                    <span asp-validation-for="modelDTO.EnglishCategory" class="text-danger"></span>
                                    <br />
                                </div>
                                <label asp-for="modelDTO.HindiCategory" class="col-md-3 col-lg-2" style="margin-top: 6px;">&nbsp;&nbsp;  Hindi Caption<span class="required">*</span></label>
                                <div class="col-md-3 col-lg-3">
                                    <input asp-for="modelDTO.HindiCategory" id="txtHindiCategory" class="form-control" placeholder="Hindi Category" autocomplete="on" />
                                    <span asp-validation-for="modelDTO.HindiCategory" class="text-danger"></span>
                                </div>
                            </div>



                            <div class="form-group form-row">
                                <label asp-for="modelDTO.EnglishLink" class="col-md-3 col-lg-2 col-form-label">English Link<span class="required">*</span></label>
                                <div class="col-md-9">
                                    <input asp-for="modelDTO.EnglishLink" id="txtEnglishLink" class="form-control" placeholder="Please enter english link !" autocomplete="on" />
                                    <span asp-validation-for="modelDTO.EnglishLink" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="form-group form-row">
                                <label asp-for="modelDTO.HindiLink" class="col-md-3 col-lg-2 col-form-label">Hindi Link<span class="required">*</span></label>
                                <div class="col-md-9">
                                    <input asp-for="modelDTO.HindiLink"  id="txtHindiLink" class="form-control" placeholder="Please enter hindi link !" autocomplete="on" />
                                    <span asp-validation-for="modelDTO.HindiLink" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="form-group form-row">
                                <label asp-for="modelDTO.EnglishThumbnailLink" class="col-md-3 col-lg-2 col-form-label">English Thumbnail Link<span class="required">*</span></label>
                                <div class="col-md-9">
                                    <input asp-for="modelDTO.EnglishThumbnailLink" id="txtEnglishThumbnailLink" class="form-control" placeholder="Please enter english link !" autocomplete="on" />
                                    <span asp-validation-for="modelDTO.EnglishThumbnailLink" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="form-group form-row">
                                <label asp-for="modelDTO.HindThumbnailLink" class="col-md-3 col-lg-2 col-form-label">Hindi Thumbnail Link<span class="required">*</span></label>
                                <div class="col-md-9">
                                    <input asp-for="modelDTO.HindThumbnailLink" id="txtHindThumbnailLink" class="form-control" placeholder="Please enter hindi link !" autocomplete="on" />
                                    <span asp-validation-for="modelDTO.HindThumbnailLink" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="form-group form-row">
                                <label class="col-md-3 col-lg-2"></label>
                                <div class="col-md-9 col-lg-10">
                                    <div class="custom-control custom-checkbox mr-sm-2">
                                        <input asp-for="modelDTO.Active" class="custom-control-input">
                                        <label asp-for="modelDTO.Active" class="custom-control-label">Active</label>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group offset-md-3 offset-lg-2">
                                <div class="btn-group">
                                    <button type="submit" class="btn btn-success"><i class="fa fa-save"></i> Save Heading</button>&nbsp;
                                    <a class="btn btn-secondary" asp-page="Index"><i class="fa fa-arrow-left"></i> Back</a>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            @if (!Model.IsNew)
            {
                <form method="post" asp-page-handler="Delete">
                    <input type="hidden" asp-for="modelDTO.Id" />
                    <partial name="_ConfirmationModalPartial" model=@("Are you sure you want to delete this item? This can not be undone.") />
                </form>
            }
        </div>
    </div>
</section>

@section Scripts{
    <script type="text/javascript" asp-append-version="true">

        $(document).ready(function () {
            //< !--Allow only alphanumeric-- >
            $('#txtenglishname').on('keypress', function (e) {
                var regex = new RegExp("^[a-zA-Z0-9(),./-]+$");
                var key = String.fromCharCode(!event.charCode ? event.which : event.charCode);
                if (!regex.test(key) && event.charCode != '8' && event.charCode != '32') {
                    event.preventDefault();
                    return false;
                }
            });

            $('#txthindiname').on('keypress', function (e) {
                var regex = new RegExp("^[a-zA-Z0-9(),./-]+$");
                var key = String.fromCharCode(!event.charCode ? event.which : event.charCode);
                if (!regex.test(key) && event.charCode != '8' && event.charCode != '32') {
                    event.preventDefault();
                    return false;
                }
            });

            $('#txtEnglishCategory').on('keypress', function (e) {
                var regex = new RegExp("^[a-zA-Z0-9(),./-]+$");
                var key = String.fromCharCode(!event.charCode ? event.which : event.charCode);
                if (!regex.test(key) && event.charCode != '8' && event.charCode != '32') {
                    event.preventDefault();
                    return false;
                }
            });

            $('#txtHindiCategory').on('keypress', function (e) {
                var regex = new RegExp("^[a-zA-Z0-9(),./-]+$");
                var key = String.fromCharCode(!event.charCode ? event.which : event.charCode);
                if (!regex.test(key) && event.charCode != '8' && event.charCode != '32') {
                    event.preventDefault();
                    return false;
                }
            });

            $('#txtEnglishLink').on('keypress', function (e) {
                var regex = new RegExp("^[a-zA-Z0-9(),./-]+$");
                var key = String.fromCharCode(!event.charCode ? event.which : event.charCode);
                if (!regex.test(key) && event.charCode != '8' && event.charCode != '32') {
                    event.preventDefault();
                    return false;
                }
            });

            $('#txtHindiLink').on('keypress', function (e) {
                var regex = new RegExp("^[a-zA-Z0-9(),./-]+$");
                var key = String.fromCharCode(!event.charCode ? event.which : event.charCode);
                if (!regex.test(key) && event.charCode != '8' && event.charCode != '32') {
                    event.preventDefault();
                    return false;
                }
            });

            $('#txtEnglishThumbnailLink').on('keypress', function (e) {
                var regex = new RegExp("^[a-zA-Z0-9(),./-]+$");
                var key = String.fromCharCode(!event.charCode ? event.which : event.charCode);
                if (!regex.test(key) && event.charCode != '8' && event.charCode != '32') {
                    event.preventDefault();
                    return false;
                }
            });

            $('#txtHindThumbnailLink').on('keypress', function (e) {
                var regex = new RegExp("^[a-zA-Z0-9(),./-]+$");
                var key = String.fromCharCode(!event.charCode ? event.which : event.charCode);
                if (!regex.test(key) && event.charCode != '8' && event.charCode != '32') {
                    event.preventDefault();
                    return false;
                }
            });
        });
    </script>
}
