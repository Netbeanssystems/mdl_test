@page "{pid:int?}"
@model WebBank.Pages.Admin.OtherLinkHeading.AddModel
@{
    ViewData["Title"] = "Add";
}

@section Styles
{
    <link href="~/plugins/summernote/summernote-bs4.css" rel="stylesheet" asp-append-version="true" />
}

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title float-left">Create Menu Heading</h3>
                        <a class="btn btn-sm btn-secondary float-right" asp-page="Index"><i class="fa fa-arrow-left"></i> Back</a>
                        <div class="clearfix"></div>
                    </div>
                    <div class="card-body">
                        <form method="post" enctype="multipart/form-data">
                            @if (Model.otherlinkdto != null)
                            {

                                <input type="hidden" asp-for="otherlinkdto.Id" />

                            }
                            <input type="hidden" asp-for="otherlinkdto.ParentId" value="@Model.pid" />

                            <div class="form-group form-row">
                                <label asp-for="otherlinkdto.EnglishHeadingName" class="col-md-3 col-lg-2">English Heading<span class="required">*</span></label>
                                <div class="col-md-3 col-lg-3">
                                    <input asp-for="otherlinkdto.EnglishHeadingName" class="form-control" id="txtenglishname" placeholder="English Name" autocomplete="on" />
                                    <span asp-validation-for="otherlinkdto.EnglishHeadingName" class="text-danger"></span>
                                    
                                </div>
                                <label asp-for="otherlinkdto.HindiHeadingName" class="col-md-3 col-lg-2">&nbsp;&nbsp;  Hindi Heading<span class="required">*</span></label>
                                <div class="col-md-3 col-lg-3">
                                    <input asp-for="otherlinkdto.HindiHeadingName" id="txthindiname" class="form-control" placeholder="Hindi Name" autocomplete="on" />
                                    <span asp-validation-for="otherlinkdto.HindiHeadingName" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="form-group form-row">
                                <label asp-for="otherlinkdto.Title" class="col-md-3 col-lg-2">English Title<span class="required">*</span></label>
                                <div class="col-md-3 col-lg-3">
                                    <input asp-for="otherlinkdto.Title" id="txtTitle" class="form-control" placeholder="English Name" autocomplete="on" />
                                    <span asp-validation-for="otherlinkdto.Title" class="text-danger"></span>
                                    
                                </div>
                                <label asp-for="otherlinkdto.HindiTitle" class="col-md-3 col-lg-2">Hindi Title<span class="required">*</span></label>
                                <div class="col-md-3 col-lg-3">
                                    <input asp-for="otherlinkdto.HindiTitle" id="txtHindiTitle" class="form-control" placeholder="Hindi Title" autocomplete="on" />
                                    <span asp-validation-for="otherlinkdto.HindiTitle" class="text-danger"></span>
                                    
                                </div>
                            </div>
                            <div class="form-group form-row">
                                <label asp-for="otherlinkdto.Keyword" class="col-md-3 col-lg-2">Keyword<span class="required">*</span></label>
                                <div class="col-md-3 col-lg-3">
                                    <input asp-for="otherlinkdto.Keyword" id="txtKeyword" class="form-control" placeholder="Keyword" autocomplete="on" />
                                    <span asp-validation-for="otherlinkdto.Keyword" class="text-danger"></span>
                                    
                                </div>
                                <label asp-for="otherlinkdto.Description" class="col-md-3 col-lg-2">Description<span class="required">*</span></label>
                                <div class="col-md-3 col-lg-3">
                                    <input asp-for="otherlinkdto.Description" id="txtDescription" class="form-control" placeholder="Description" autocomplete="on" />
                                    <span asp-validation-for="otherlinkdto.Description" class="text-danger"></span>
                                </div>
                            </div>
                            <nav>
                                <div class="nav nav-tabs" id="nav-tab" role="tablist">
                                    <a class="nav-item nav-link active" id="nav-PageLink-tab" data-toggle="tab" href="#nav-PageLink" role="tab" aria-controls="nav-home" aria-selected="true">Page Link</a>
                                    <a class="nav-item nav-link" id="nav-UploadFile-tab" data-toggle="tab" href="#nav-UploadFile" role="tab" aria-controls="nav-profile" aria-selected="false">Upload File</a>
                                    <a class="nav-item nav-link" id="nav-Content-tab" data-toggle="tab" href="#nav-Content" role="tab" aria-controls="nav-profile" aria-selected="false">Content</a>
                                </div>
                            </nav>
                            <div class="tab-content p-3 border" id="nav-tabContent">
                                <input type="hidden" id="LastSelectedId" />
                                <div class="tab-pane fade show active" id="nav-PageLink" role="tabpanel" aria-labelledby="nav-PageLink-tab">
                                    <div class="row">
                                        <div class="col-md-4">
                                            <span class="FD">English Link</span><input class="form-control" asp-for="otherlinkdto.EnglishPageLink" />
                                            <span asp-validation-for="otherlinkdto.EnglishPageLink" class="text-danger"></span>
                                        </div>
                                        <div class="col-md-4">
                                            <span class="FD">Hindi Link</span><input class="form-control" asp-for="otherlinkdto.HindiPageLink" />
                                            <span asp-validation-for="otherlinkdto.HindiPageLink" class="text-danger"></span>
                                        </div>
                                        
                                    </div>
                                </div>
                                <div class="tab-pane fade" id="nav-UploadFile" role="tabpanel" aria-labelledby="nav-UploadFile-tab">
                                    <div class="row">
                                        <div class="col-md-4"><span class="FD">English File</span><input class="form-control Attachment" asp-for="otherlinkdto.EnglishFile" /></div>
                                        <div class="col-md-4"><span class="FD">Hindi File</span><input class="form-control Attachment" asp-for="otherlinkdto.HindiFile" /></div>
                                        
                                    </div>
                                </div>
                                <div class="tab-pane fade" id="nav-Content" role="tabpanel" aria-labelledby="nav-Contact-tab">
                                    <div class="row">
                                        <div class="col-md-10">
                                            <span class="FD">English Content</span>
                                            <textarea class="form-control" asp-for="otherlinkdto.EnglishContentDesc" cols="30" rows="3" id="EnglishContentDesc"></textarea>
                                        </div>
                                        
                                        <div class="col-md-10">
                                            <span class="FD">Hindi Content</span>
                                            <textarea class="form-control" cols="30" rows="3" asp-for="otherlinkdto.HindiContentDesc" id="HindiContentDesc"></textarea>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group form-row">
                                <label class="col-md-3 col-lg-2"></label>
                                <div class="col-md-9 col-lg-10">
                                    <div class="custom-control custom-checkbox mr-sm-2">
                                        <input asp-for="otherlinkdto.Show" class="custom-control-input">
                                        <label asp-for="otherlinkdto.Show" class="custom-control-label">Active</label>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group offset-md-3 offset-lg-2">
                                <div class="btn-group">
                                    <button type="submit" class="btn btn-success"><i class="fa fa-save"></i> Save Heading</button>&nbsp;
                                    <a class="btn btn-secondary" asp-page="Index"><i class="fa fa-arrow-left"></i> Back</a>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


@section Scripts
    {
    <script src="~/plugins/summernote/summernote-bs4.min.js" asp-append-version="true"></script>
    <script type="text/javascript" asp-append-version="true">
        //Initialize wysihtml
        $("#EnglishContentDesc").summernote({
            height: 300,                 // set editor height
            minHeight: null,             // set minimum height of editor
            maxHeight: null             // set maximum height of editor
        });
        $("#HindiContentDesc").summernote({
            height: 300,                 // set editor height
            minHeight: null,             // set minimum height of editor
            maxHeight: null             // set maximum height of editor
        });
        $(document).ready(function () {
            //< !--Allow only alphanumeric-- >
           
            $('#txtenglishname').on('keypress', function (e) {
                var regex = new RegExp("^[a-zA-Z0-9(),./-]+$");
                var key = String.fromCharCode(!event.charCode ? event.which : event.charCode);
                if (!regex.test(key) && event.charCode != '8' && event.charCode != '32') {
                    event.preventDefault();
                    return false;
                }
            });

            $('#txthindiname').on('keypress', function (e) {
                var regex = new RegExp("^[a-zA-Z0-9(),./-]+$");
                var key = String.fromCharCode(!event.charCode ? event.which : event.charCode);
                if (!regex.test(key) && event.charCode != '8' && event.charCode != '32') {
                    event.preventDefault();
                    return false;
                }
            });
          
        });
    </script>
}

