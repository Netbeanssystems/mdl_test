@page
@model WebBank.Pages.Admin.URlsTiming.AddModel
@{
    ViewData["Title"] = "Add URLs Timing";
}
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title float-left">Enable Upload Link</h3>
                        <a class="btn btn-sm btn-secondary float-right d-none" asp-page="Index"><i class="fa fa-arrow-left"></i> Back</a>
                        <div class="clearfix"></div>
                    </div>
                    <div class="card-body">
                        <form method="post" enctype="multipart/form-data">
                            <input type="hidden" asp-for="URLsTimingDTO.Id" />

                            <div class="form-group form-row">
                                <label asp-for="URLsTimingDTO.Description" class="col-md-3 col-lg-2" style="margin-top: 6px;">Description<span class="required">*</span></label>
                                <div class="col-md-9 col-lg-10">
                                    <input type="text" asp-for="URLsTimingDTO.Description" class="form-control" placeholder="Enter upload window description (e.g., Q1 2026 Bid Submission)" />
                                    <span asp-validation-for="URLsTimingDTO.Description" class="text-danger"></span>
                                </div>
                            </div>
                            
                            <div class="form-group form-row">
                                <label asp-for="URLsTimingDTO.FromTimeStr" class="col-md-3 col-lg-2" style="margin-top: 6px;">From Date<span class="required">*</span></label>
                                <div class="col-md-3 col-lg-3">
                                    <input type="text" id="FromTime" asp-for="URLsTimingDTO.FromTimeStr" class="form-control bg-white" placeholder="MM/dd/yyyy HH:mm" readonly />
                                    <span asp-validation-for="URLsTimingDTO.FromTimeStr" class="text-danger"></span>
                                    <input type="hidden" asp-for="URLsTimingDTO.FromTime" />
                                </div>

                                <label asp-for="URLsTimingDTO.ToTimeStr" class="col-md-3 col-lg-2" style="margin-top: 6px;">To Date<span class="required">*</span></label>
                                <div class="col-md-3 col-lg-3">
                                    <input type="text" id="ToTime" asp-for="URLsTimingDTO.ToTimeStr" class="form-control bg-white" placeholder="MM/dd/yyyy HH:mm" readonly />
                                    <span asp-validation-for="URLsTimingDTO.ToTimeStr" class="text-danger"></span>
                                    <input type="hidden" asp-for="URLsTimingDTO.ToTime" />
                                </div>
                            </div>
                            <div class="form-group offset-md-3 offset-lg-2">
                                <div class="btn-group">
                                    <button type="submit" class="btn btn-success"><i class="fa fa-save"></i> Save Heading</button>&nbsp;
                                    <a class="btn btn-secondary" asp-page="Index"><i class="fa fa-arrow-left"></i> Back</a>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12">
                <div class="card">
                    <div class="card-body">
                        @if (Model.URLsTimingVM?.Count > 0)
                        {

                            <div class="table-responsive">
                                <table id="tblDataTable" class="table table-sm table-bordered table-striped">
                                    <thead>
                                        <tr>
                                            <th class="text-center">Sr. No</th>
                                            <th class="text-center noExport noSort">Description</th>
                                            <th class="text-center hidden">From Date</th>
                                            <th class="search hidden">To Date</th>
                                            <th class="search">Enabled By</th>
                                            <th class="search">Enabled Date and Time</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (int i = 0; i < Model.URLsTimingVM.Count; i++)
                                        {
                                            var item = Model.URLsTimingVM[i];
                                            <tr>
                                                <td class="text-center">@(i + 1)</td>
                                                <td>@item.Description</td>
                                                <td class="text-center hidden">@item.FromTime.ToString("dd/MM/yyyy HH:mm")</td>
                                                <td class="hidden">@item.ToTime.ToString("dd/MM/yyyy HH:mm")</td>
                                                <td>@item.CreatedBy</td>
                                                <td class="text-right">@item.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p>No records has been added yet.</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
