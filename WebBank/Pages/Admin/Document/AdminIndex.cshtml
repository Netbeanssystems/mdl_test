@page
@using System.Net
@model WebBank.Pages.Admin.Document.AdminIndexModel
@{
}

<section class="content">
    <div class="card">
        <div class="card-header">
            <h1 class="card-title float-left font-weight-bold">List of Documents</h1>
            <div class="clearfix"></div>
        </div>
        <div class="card-body">
            @* Section 1: OPEN Windows - Show COUNT only *@
            @if (Model.IsAnyWindowOpen)
            {
                var openDocs = ViewData["OpenWindowDocs"] as List<Application.ViewModels.DocumentsVM>;
                var openWindows = ViewData["OpenURLsTimingList"] as List<Application.ViewModels.URLsTimingVM>;
                
                @if (openWindows != null && openWindows.Any())
                {
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle"></i> Upload window(s) are currently OPEN. Showing document count for open windows.
                    </div>
                    <div class="card mb-3">
                        <div class="card-header bg-success text-white">
                            <h5 class="mb-0"><i class="fas fa-lock-open"></i> Currently Open Upload Windows</h5>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-sm table-bordered table-striped">
                                    <thead>
                                        <tr>
                                            <th class="text-center">Sr. No</th>
                                            <th class="search">Upload Window Description</th>
                                            <th class="text-center">From Date</th>
                                            <th class="text-center">To Date</th>
                                            <th class="text-center">Document Count</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            var openIndex = 0;
                                        }
                                        @foreach (var window in openWindows)
                                        {
                                            openIndex++;
                                            var docCount = openDocs?.Where(x => x.URLsTimingId == window.Id).Count() ?? 0;
                                            <tr>
                                                <td class="text-center">@openIndex</td>
                                                <td>@window.Description</td>
                                                <td class="text-center">@window.FromTime.ToString("dd/MM/yyyy HH:mm")</td>
                                                <td class="text-center">@window.ToTime.ToString("dd/MM/yyyy HH:mm")</td>
                                                <td class="text-center"><span class="badge badge-success">@docCount</span></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }
            }

            <div class="alert alert-warning">
                <i class="fas fa-exclamation-triangle"></i> Closed Upload Windows Documents
            </div>
            
            <form method="get" class="mb-4">
                <div class="row align-items-end">
                    <div class="col-md-3">
                        <div class="form-group mb-0">
                            <label>From Date</label>
                            <input type="date" name="fromDate" id="fromDate" class="form-control"
                                   asp-for="SelectedFromDate" max="@DateTime.Now.ToString("yyyy-MM-dd")" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group mb-0">
                            <label>To Date</label>
                            <input type="date" name="toDate" id="toDate" class="form-control"
                                   asp-for="SelectedToDate" max="@DateTime.Now.ToString("yyyy-MM-dd")" />
                        </div>
                    </div>
                    <div class="col-md-1 text-center">
                        <button type="submit" class="btn btn-primary">Apply Date</button>
                    </div>

                    <div class="col-md-1 text-center">
                        <h5 class="font-weight-bold mb-2">OR</h5>
                    </div>

                    <div class="col-md-3">
                        <div class="form-group mb-0">
                            <label>Filter by Upload Window</label>
                            @* CHANGED: name mapping attribute adjusted to windowDescription; bound via string tracking data value property *@
                            <select name="urlsTimingId" class="form-control" onchange="this.form.submit()">
                                <option value="">-- All Closed Windows --</option>
                               @*  @if (Model.ClosedDocuments != null)
                                {
                                        // 1. Group by description to find unique text entries
                                        var currentTime = DateTime.Now;
                                    var groupedWindows = Model.ClosedDocuments
                                        .Where(item => !(item.FromTime <= currentTime && item.ToTime >= currentTime) && !string.IsNullOrEmpty(item.Description) )
                                         .GroupBy(item => item.Description.Trim())
                                        .ToList();

                                    @foreach (var group in groupedWindows)
                                    {
                                        // 2. Extract exactly ONE representative URLsTiming ID from this group
                                        var singleUrlTimingId = group.First().URLsTimingId;
            
                                        // 3. Convert it to a string to match against your page model's active filter property
                                        var idValueString = singleUrlTimingId.ToString();
                    
                                        // 4. Keep the option visually highlighted if it matches the active route payload
                                        if (Model.SelectedURLsTimingIdString == idValueString)
                                        {
                                            <option value="@idValueString" selected="selected">@group.Key</option>
                                        }
                                        else
                                        {
                                            <option value="@idValueString">@group.Key</option>
                                        }
                                    }
                                } *@
                                @if (Model.ClosedDocuments != null)
                                {
                                    // 1. Group by the Description property directly available on URLsTimingVM
                                    var currentTime = DateTime.Now;
                                    var groupedWindows = Model.ClosedDocuments
                                        .Where(item => !(item.FromTime <= currentTime && item.ToTime >= currentTime) &&
                                                       !string.IsNullOrEmpty(item.Description))
                                        .GroupBy(item => item.Description.Trim())
                                        .ToList();

                                    @foreach (var group in groupedWindows)
                                    {
                                        // 2. Extract exactly ONE representative ID from this group
                                        var singleUrlTimingId = group.First().Id;
        
                                        // 3. Convert it to a string to match against your page model's active filter property
                                        var idValueString = singleUrlTimingId.ToString();
        
                                        // 4. Keep the option visually highlighted if it matches the active route payload
                                        if (Model.SelectedURLsTimingIdString == idValueString)
                                        {
                                            <option value="@idValueString" selected="selected">@group.Key</option>
                                        }
                                        else
                                        {
                                            <option value="@idValueString">@group.Key</option>
                                        }
                                    }
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </form>
            
            @if (Model.ModelVms != null && Model.ModelVms.Count > 0)
            {
                <div class="table-responsive">
                    <table id="tblDataTable" class="table table-sm table-bordered table-striped">
                        <thead>
                            <tr>
                                <th class="text-center">Sr. No</th>
                                <th class="search">Bank Name</th>
                                <th class="search">Branch Name</th>
                                <th class="search">Upload Window</th>
                                <th>Document</th>
                                <th class="search">Uploaded By</th>
                                <th class="search">Uploaded Date and Time</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int srNo = 1;
                            }
                            @foreach (var item in Model.ModelVms)
                            {
                                <tr>
                                    <td class="text-center">@srNo</td>
                                    <td>@item.BankName</td>
                                    <td>@item.BranchName</td>
                                    <td>@(item.URLsTiming?.Description ?? "N/A")</td>
                                   @*  <td><a href="/bank/file/download?name=@WebUtility.UrlEncode(item.DocumentName)">@Html.Encode(item.DocumentNameDecrypted)</a></td> *@
                                    <td>
                                        <a href="/bank/file/download?name=@WebUtility.UrlEncode(item.DocumentName)"
                                               class="lnk-download-track"
                                               data-docname="@item.DocumentNameDecrypted">
                                            @Html.Encode(item.DocumentNameDecrypted)
                                        </a>
                                    </td>
                                    <td>@item.CreatedBy</td>
                                    <td>@item.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
                                </tr>
                                srNo++;
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i> Apply filters above to view documents from closed upload windows.
                </div>
            }
        </div>
    </div>
</section>

@section Scripts
{
    <script>
                $(document).ready(function () {
            $('.lnk-download-track').on('click', function () {
                const documentName = $(this).attr('data-docname');

                // Fire-and-forget tracking log notification payload back to the server
                $.ajax({
                    url: '/api/Documents/LogDownload',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ documentName: documentName }),
                    headers: {
                        // Secure handling via request verification tokens
                        "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                    },
                    error: function(err) {
                        console.error("Audit log synchronization pipeline failed:", err);
                    }
                });
            });
        });

    </script>

    <script type="text/javascript" asp-append-version="true">
        $('#tblDataTable').DataTable();
    </script>
    <script type="text/javascript" asp-append-version="true">
        $('form').keypress((e) => {
        if (e.which === 13) {
        return true;
        }
        });
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            let inputs = document.querySelectorAll("input, textarea");
            inputs.forEach(function (input) {
                input.addEventListener('paste', function (e) { e.preventDefault(); });
                input.addEventListener('copy', function (e) { e.preventDefault(); });
                input.addEventListener('cut', function (e) { e.preventDefault(); });
            });
        });
    </script>
    <script>
        $(document).ready(function () {
            const today = new Date().toISOString().split('T')[0];
            $('#fromDate, #toDate').attr('max', today);

            $('#fromDate').change(function () {
                $('#toDate').attr('min', $(this).val());
            });
        });
    </script>
}