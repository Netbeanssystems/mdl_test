@page
@model WebBank.Pages.Admin.Document.AddModel
@{
    ViewData["Title"] = "Add";
}
@section Styles
{
    <link href="~/plugins/summernote/summernote-bs4.css" rel="stylesheet" asp-append-version="true" />
}
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12">
                <div class="card">
                    <div class="card-header">
                        <h1 class="card-title float-left">Add</h1>
                        <a class="btn btn-sm btn-secondary float-right d-none" asp-page="Index"><i class="fa fa-arrow-left"></i> Back</a>
                        <div class="clearfix"></div>
                    </div>
                    <div class="card-body">
                        @if(Model.IsInTime)
                        {
                            <form method="post" enctype="multipart/form-data">
                                <div class="row flex-column">
                                    <div class="col-md-4"><label for="DocumentsDTO_DocumentFile" class="FD">Upload File</label><input class="form-control Attachment" accept=".pdf" asp-for="DocumentsDTO.DocumentFile" aria-describedby="fileInstructions" /></div>
                                    <small id="fileInstructions" class="text-danger">Only PDF file is allowed to upload. File must be password protected and less than 2 MB.</small>
                                </div>

                                <div class="form-group offset-md-3 offset-lg-4" style="margin-top: 15px;">
                                    <div class="btn-group">
                                        <button type="submit" class="btn btn-success"><i class="fa fa-save"></i> Save</button>&nbsp;
                                        <a class="btn btn-secondary" asp-page="Index"><i class="fa fa-arrow-left"></i> Back</a>
                                    </div>
                                </div>

                            </form>
                        }
                        else { 
                         <p class="text-center">File upload functionality is currently disabled.</p>   
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts
{
    <script type="text/javascript" asp-append-version="true">

        $('form').keypress((e) => {
            if (e.which === 13) {
                SubmitForm(e);
                return true;
            }
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            let inputs = document.querySelectorAll("input, textarea");
            inputs.forEach(function (input) {
                input.addEventListener('paste', function (e) {
                    e.preventDefault();
                });
                input.addEventListener('copy', function (e) {
                    e.preventDefault();
                });
                input.addEventListener('cut', function (e) {
                    e.preventDefault();
                });
            });
        });
    </script>
}