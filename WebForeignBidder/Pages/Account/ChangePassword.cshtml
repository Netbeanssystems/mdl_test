@page
@using Microsoft.AspNetCore.Http
@model ChangePasswordModel
@{
    ViewData["Title"] = "Change Password";
}
@section Styles{
    <link href="~/plugins/password-requirement/css/jquery.passwordRequirements.css" rel="stylesheet" />
}
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-6 col-md-6 col-sm-12 offset-lg-3 offset-md-3">
                <div class="card">
                    <h5 class="card-header">Change Password</h5>
                    <div class="card-body">
                        <form asp-route-returnUrl="@Model.ReturnUrl" method="post">
                            <input type="hidden" asp-for="Input.EncPassword" />
                            <input type="hidden" asp-for="Input.EncNewPassword" />
                            <input type="hidden" asp-for="Input.EncConfirmPassword" />

                            <input asp-for="Input.Username" type="hidden" value="@User.Identity?.Name" />
                            <div class="form-group">
                                <label asp-for="Input.Password" class="col-form-label">Password*</label>
                                <div class="input-group">
                                    <input asp-for="Input.Password" class="form-control" placeholder="Current Password">
                                    <div class="input-group-append">
                                        <div class="input-group-text">
                                            <span class="toggle_pwd fa fa-eye" title="Show/Hide Password" data-toggle="tooltip" data-placement="top"></span>
                                        </div>
                                    </div>
                                </div>
                                <span asp-validation-for="Input.Password" class="text-danger-sm"></span>
                                <span class="information">Your current password</span>
                            </div>
                            <div class="form-group">
                                <label asp-for="Input.NewPassword" class="col-form-label">New Password*</label>
                                <div class="input-group">
                                    <input class="form-control pr-password" placeholder="New Password" asp-for="Input.NewPassword" />
                                    <div class="input-group-append">
                                        <div class="input-group-text">
                                            <span class="toggle_pwd fa fa-eye" title="Show/Hide Password" data-toggle="tooltip" data-placement="top"></span>
                                        </div>
                                    </div>
                                </div>
                                <span asp-validation-for="Input.NewPassword" class="text-danger-sm"></span>
                                <span class="information">8 to 32 characters including 1 lower-case, 1 upper-case, 1 special character and a digit</span>
                            </div>
                            <div class="form-group">
                                <label asp-for="Input.ConfirmPassword" class="col-form-label">Confirm Password*</label>
                                <div class="input-group">
                                    <input class="form-control" placeholder="Confirm Password" asp-for="Input.ConfirmPassword" />
                                    <div class="input-group-append">
                                        <div class="input-group-text">
                                            <span class="toggle_pwd fa fa-eye" title="Show/Hide Password" data-toggle="tooltip" data-placement="top"></span>
                                        </div>
                                    </div>
                                </div>
                                <span asp-validation-for="Input.ConfirmPassword" data-glass="@HttpContext.Session.GetString("Glass")" class="text-danger-sm remMe"></span>
                                <span class="information">Must match with your new password</span>
                            </div>
                            <div class="form-group">
                                <div class="col-sm-4 offset-sm-4">
                                    @* <button type="submit" class="pr-submit-btn btn btn-primary btn-block">Submit</button>*@
                                    <button id="btnSubmit" type="button" class="pr-submit-btn btn btn-primary btn-block">Submit</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
@section Scripts{
    <script src="~/plugins/password-requirement/js/jquery.passwordRequirements.js" asp-append-version="true"></script>
    <script type="text/javascript">
        $(".pr-password").passwordRequirements();
        $(".toggle_pwd").click(function () {
            $(this).toggleClass("fa-eye fa-eye-slash");
            var type = $(this).hasClass("fa-eye-slash") ? "text" : "password";
            $(this).parent().parent().prev('input').attr("type", type);
        });

        function SubmitForm(event) {
            var ctrlOldHtml = $('#btnSubmit').html();
            var theForm = $('#btnSubmit').parents('form:first');
            if (theForm.valid()) {
                var txtPassword = $('#Input_Password').val();
                var txtNewPassword = $('#Input_NewPassword').val();
                var txtConfirmPassword = $('#Input_ConfirmPassword').val();

                if (txtPassword === "") {
                    $("#divClientAlert").addClass("alert-danger");
                    $("#divClientAlert > p.m-0").text("Password is required");
                    $("#divClientAlert").show();
                    SetTimeOut($("#divClientAlert"));
                    return false;
                }
                else if (txtNewPassword === "") {
                    $("#divClientAlert").addClass("alert-danger");
                    $("#divClientAlert > p.m-0").text("New Password is required");
                    $("#divClientAlert").show();
                    SetTimeOut($("#divClientAlert"));
                    return false;
                }
                else if (txtConfirmPassword === "") {
                    $("#divClientAlert").addClass("alert-danger");
                    $("#divClientAlert > p.m-0").text("Confirm Password is required");
                    $("#divClientAlert").show();
                    SetTimeOut($("#divClientAlert"));
                    return false;
                }
                else {
                    $('#Input_EncPassword').val(Encrypt(txtPassword));
                    $('#Input_EncNewPassword').val(Encrypt(txtNewPassword));
                    $('#Input_EncConfirmPassword').val(Encrypt(txtConfirmPassword));
                    $('#Input_Password').val('Pa$$w0rdPa$$w0rd');
                    $('#Input_NewPassword').val('Pa$$w0rdPa$$w0rd');
                    $('#Input_ConfirmPassword').val('Pa$$w0rdPa$$w0rd');
                    $('#btnSubmit').attr('disabled', true);
                    $('#btnSubmit').html('<i class="fa fa-spinner fa-spin"></i> Please wait');
                    theForm.submit();
                    return true;
                }
            } else {
                event.preventDefault();
                $('#btnSubmit').attr('disabled', false);
                $('#btnSubmit').html(ctrlOldHtml);
                return false;
            }
        };

        $('#btnSubmit').click(function (event) {
            SubmitForm(event);
        });

        $('form').keypress((e) => {
            if (e.which === 13) {
                SubmitForm(e);
                return true;
            }
        });

