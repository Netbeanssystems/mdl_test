@using Domain.Models
@model List<ProjectResponse>

@if (Model?.Count > 0)
{
    <div class="table-responsive">
        @foreach (var item in Model.Select((value, index) => new { value, index }))
        {
            var fillId = $"storageFill_{item.index}";
            var textId = $"storageText_{item.index}";
            var totalQuotaMB = item.value.TotalQuota * 1024; // Convert GB to MB in C#
            <div class="storage-slider-container">
                @item.value.ProjectName
                <div class="storage-slider">
                    <div class="storage-slider-fill" id="@fillId"></div>
                </div>
                <div class="storage-text" id="@textId">Loading...</div>
            </div>
            <script>
                document.addEventListener('DOMContentLoaded', function() {
                    updateStorage('@fillId', '@textId', @item.value.OccupiedQuota, @totalQuotaMB);
                });
            </script>
        }
    </div>
}