@using Domain.Models
@model List<ProjectResponse>
@if (Model?.Count > 0)
{
    <div class="table-responsive">
        <table id="tblDataTable" class="table table-sm table-bordered table-striped">
            <thead>
                <tr>
                    <th class="text-center noExport noSort">Sr No.</th>
                    <th class="search">Project</th>
                    <th class="search">Yard</th>
                    <th class="search">Remarks</th>
                    <th class="search">Created By</th>
                    <th class="text-center noSort">Created Date & Time</th>
                    <th class="text-center noExport noSort">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Select((value, index) => new { value, index }))
                {
                    <tr>
                        <td class="text-center">@(item.index + 1)</td>
                        <td>@(!string.IsNullOrEmpty(item.value.ProjectName) ? item.value.ProjectName : "NA")</td>
                        <td>@item.value.Yard</td>
                        <td class="text-right">@item.value.Remarks</td>
                        <td class="text-center">
                            @if (item.value.ModifiedDate != null)
                            {
                                @item.value.ModifiedBy
                            }
                            else
                            {
                                @item.value.CreatedBy
                            }
                        </td>
                        <td class="text-center">
                            @if (item.value.ModifiedDate != null)
                            {
                                @item.value.ModifiedDate
                            }
                            else
                            {
                                @item.value.CreatedDate
                            }
                        </td>
                        <td class="text-center fit">
                            <a asp-page="Manage" asp-route-id="@item.value.Id" class="mr-1" data-toggle="tooltip" data-placement="top" title="Edit">
                                <i class="fa fa-edit text-dark"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th class="text-center noExport noSort">Sr No.</th>
                    <th class="search">Project</th>
                    <th class="search">Yard</th>
                    <th class="search">Remarks</th>
                    <th class="search">Created By</th>
                    <th class="text-center noSort">Created Date & Time</th>
                    <th class="text-center noExport noSort">Action</th>
                </tr>
            </tfoot>
        </table>
    </div>
}
else
{
    <p>No records has been added yet. Click 'Create New' to start adding.</p>
}