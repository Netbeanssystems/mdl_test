@page
@model IndexModel
@{
    ViewData["Title"] = "Storage Quota";
}
@section Styles {
    <style>
        .storage-slider-container {
            width: 400px;
            background-color: #f0f0f0;
            border-radius: 10px;
            padding: 10px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            margin: 15px auto;
        }

        .storage-slider {
            position: relative;
            width: 100%;
            height: 20px;
            background-color: #e0e0e0;
            border-radius: 10px;
            overflow: hidden;
        }

        .storage-slider-fill {
            height: 100%;
            background: linear-gradient(90deg, #4caf50, #81c784);
            width: 0%;
            border-radius: 10px 0 0 10px;
            transition: width 0.4s ease, background 0.4s ease;
        }

        .storage-text {
            text-align: center;
            margin-top: 10px;
            font-size: 14px;
            color: #333;
        }
    </style>
}
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12 col-sm-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title float-left font-weight-bold">Storage Quota</h3>
                    </div>
                    <div class="card-body">
                        <div id="divUsersList">
                            <partial name="_StorageQuotaPartial" model="@Model.Projects" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
@section Scripts {
    <script>
        function updateStorage(fillId, textId, usedMB, totalMB) {
            var fill = document.getElementById(fillId);
            var text = document.getElementById(textId);

            var percentage = (usedMB / totalMB) * 100;
            fill.style.width = percentage + '%';

            if (percentage >= 90) {
                fill.style.background = 'linear-gradient(90deg, #f44336, #e57373)'; // red shades
            } else {
                fill.style.background = 'linear-gradient(90deg, #4caf50, #81c784)'; // green shades
            }

            text.innerText = `${usedMB} MB of ${totalMB} MB used`;
        }

        function DrawDataTable() {
            $('#tblDataTable').DataTable({
                initComplete: function () {
                    var r = $('#tblDataTable tfoot tr');
                    r.find('th').each(function () {
                        if ($(this).hasClass('search')) {
                            $(this).css('padding', 5);
                            var title = $(this).text();
                            $(this).html('<input type="text" class="form-control" placeholder="' + title + '" />');
                        } else {
                            $(this).html('');
                        }
                    });
                    $('#tblDataTable thead').prepend(r);
                    this.api().columns().every(function () {
                        var that = this;
                        $('input', this.footer()).on('keyup change clear',
                            function () {
                                if (that.search() !== this.value) {
                                    that
                                        .search(this.value)
                                        .draw();
                                }
                            });
                    });
                }
            });
        }
        DrawDataTable();
    </script>
}