@page
@model IndexModel
@{
    ViewData["Title"] = "List of Projects";
}
<section class="content">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title float-left font-weight-bold">List of Projects</h3>
            <a class="float-right" asp-page="Manage">
                <i class="fa fa-plus text-dark" data-toggle="tooltip" data-placement="top" title="Create"></i>
            </a>
            <div class="clearfix"></div>
        </div>
        <div class="card-body">
            <div id="divUsersList">
                <partial name="_ProjectsPartial" model="@Model.Projects" />
            </div>
        </div>
    </div>
</section>
@section Scripts{
    <script type="text/javascript" asp-append-version="true">
        function DrawDataTable() {
            $('#tblDataTable').DataTable({
                initComplete: function () {
                    var r = $('#tblDataTable tfoot tr');
                    r.find('th').each(function () {
                        if ($(this).hasClass('search')) {
                            $(this).css('padding', 5);
                            var title = $(this).text();
                            $(this).html('<input type="text" class="form-control" placeholder="' + title + '" />');
                        } else {
                            $(this).html('');
                        }
                    });
                    $('#tblDataTable thead').prepend(r);
                    this.api().columns().every(function () {
                        var that = this;
                        $('input', this.footer()).on('keyup change clear',
                            function () {
                                if (that.search() !== this.value) {
                                    that
                                        .search(this.value)
                                        .draw();
                                }
                            });
                    });
                }
            });
        }
        DrawDataTable();
    </script>
}