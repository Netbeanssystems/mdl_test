@page
@model WebForeignBidder.Pages.Admin.Bidder.ListOfTenderModel
@{
    ViewData["Title"] = "List Of Tenders";
    int serialNumber = 0;
}
<section class="content">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title float-left font-weight-bold">List Of Tenders</h3>
            <div class="clearfix"></div>
        </div>
        <div class="card-body">
            @if (Model.ModelVms?.Count > 0)
            {
                <div class="table-responsive">
                    <table id="tblDataTable" class="table table-sm table-bordered table-striped">
                        <thead>
                            <tr>
                                <th class="search">Id</th>
                                @if (Model.IsAdminOrExecutive)
                                {
                                    <th>Project</th>
                                    <th>Yard</th>
                                }
                                <th>Tender/Reference No.</th>
                                <th>Tender Description</th>
                                <th>Tender Document</th>
                                @if (Model.IsAdminOrExecutive)
                                {
                                    <th>Selected Bidders</th>
                                }
                                <th>Tender Start Date</th>
                                <th>Closing Date</th>
                                <th>Tender Opening Date</th>
                                @if (Model.IsAdminOrExecutive)
                                {
                                    <th>Uploaded By</th>
                                    <th>Upload Date & Time</th>
                                }
                                <th>Extended Tender Closing Date</th>
                                @if (Model.IsAdminOrExecutive)
                                {
                                <th>Edited By</th>
                                <th>Date Edit</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.ModelVms)
                            {
                                int corSerial = 1;
                                <tr>
                                    <td>@(++serialNumber)</td>
                                    @if (Model.IsAdminOrExecutive)
                                    {
                                        <td>@item.ProjectName</td>
                                        <td>@item.YardId</td>
                                    }
                                    <td>@item.TenderNo</td>
                                    <td>@item.TenderDescription</td>
                                    <td>
                                        @if (item.TenderDocuments != null && item.TenderDocuments.Count > 0)
                                        {
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <span class="font-weight-bold text-dark">Tender Documents:</span>
                                              
                                            </div>
                                            <table class="table table-sm table-bordered mb-3 bg-white">
                                                <thead class="thead-light">
                                                    <tr>
                                                        <th style="width: 50px;" class="text-center">Sr No.</th>
                                                        <th>Document Name</th>
                                                        <th style="width: 130px;" class="text-center">Action</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @{ int tDocSr = 1; }
                                                    @foreach (var doc in item.TenderDocuments)
                                                    {
                                                        var docFileName = !string.IsNullOrEmpty(doc.EncryptedFileName) ? doc.EncryptedFileName : doc.OriginalFileName;
                                                        var docDisplayName = !string.IsNullOrEmpty(doc.OriginalFileName) ? doc.OriginalFileName : $"Document_{tDocSr}";
                                                        <tr>
                                                            <td class="text-center font-weight-bold">@(tDocSr++)</td>
                                                            <td>@docDisplayName</td>
                                                            <td class="text-center">
                                                                <button type="button" 
                                                                        class="btn btn-sm btn-outline-success download-direct-file" 
                                                                        data-tender="@item.TenderNo" 
                                                                        data-project="@item.ProjectId" 
                                                                        data-file="@docFileName" 
                                                                        data-name="@docDisplayName"
                                                                        title="Download @docDisplayName">
                                                                    <i class="fa fa-download"></i> Download
                                                                </button>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        }
                                        else if (!string.IsNullOrEmpty(item.TenderDocDecrypted))
                                        {
                                            var singleFileName = item.TenderDoc;
                                            var singleDisplayName = !string.IsNullOrEmpty(item.TenderDocDecrypted) ? item.TenderDocDecrypted : "Tender_Document";
                                            <table class="table table-sm table-bordered mb-3 bg-white">
                                                <thead class="thead-light">
                                                    <tr>
                                                        <th style="width: 50px;" class="text-center">Sr No.</th>
                                                        <th>Document Name</th>
                                                        <th style="width: 130px;" class="text-center">Action</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr>
                                                        <td class="text-center font-weight-bold">1</td>
                                                        <td>@singleDisplayName</td>
                                                        <td class="text-center">
                                                            <button type="button" 
                                                                    class="btn btn-sm btn-outline-success download-direct-file" 
                                                                    data-tender="@item.TenderNo" 
                                                                    data-project="@item.ProjectId" 
                                                                    data-file="@singleFileName" 
                                                                    data-name="@singleDisplayName"
                                                                    title="Download @singleDisplayName">
                                                                <i class="fa fa-download"></i> Download
                                                            </button>
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        }

                                        @if (item.TenderCorrigendums != null && item.TenderCorrigendums.Count > 0)
                                        {
                                            <div class="mb-2 font-weight-bold text-dark">Corrigendum Documents:</div>
                                            <table class="table table-sm table-bordered bg-white">
                                                <thead class="thead-light">
                                                    <tr>
                                                        <th style="width: 50px;" class="text-center">Sr No.</th>
                                                        <th>Document Name</th>
                                                        <th style="width: 130px;" class="text-center">Action</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @{ int cDocSr = 1; }
                                                    @foreach (var cor in item.TenderCorrigendums)
                                                    {
                                                        var corFileNames = (!string.IsNullOrEmpty(cor.HashedFileName) ? cor.HashedFileName : cor.CorrigendumDoc)?.Split(',', StringSplitOptions.RemoveEmptyEntries).Select(s => s.Trim()).ToList() ?? new List<string>();
                                                        var corDisplayNames = (!string.IsNullOrEmpty(cor.OriginalFileName) ? cor.OriginalFileName : cor.CorrigendumDocDecrypted)?.Split(',', StringSplitOptions.RemoveEmptyEntries).Select(s => s.Trim()).ToList() ?? new List<string>();

                                                        if (corFileNames.Count > 0)
                                                        {
                                                            for (int cIndex = 0; cIndex < corFileNames.Count; cIndex++)
                                                            {
                                                                var corFile = corFileNames[cIndex];
                                                                var corName = (cIndex < corDisplayNames.Count && !string.IsNullOrWhiteSpace(corDisplayNames[cIndex]))
                                                                    ? corDisplayNames[cIndex]
                                                                    : $"Corrigendum Doc {cDocSr}";
                                                                <tr>
                                                                    <td class="text-center font-weight-bold">@(cDocSr++)</td>
                                                                    <td>@corName</td>
                                                                    <td class="text-center">
                                                                        <button type="button" 
                                                                                class="btn btn-sm btn-outline-primary download-direct-file" 
                                                                                data-tender="@item.TenderNo" 
                                                                                data-project="@item.ProjectId" 
                                                                                data-file="@corFile" 
                                                                                data-name="@corName"
                                                                                title="Download @corName">
                                                                            <i class="fa fa-download"></i> Download
                                                                        </button>
                                                                    </td>
                                                                </tr>
                                                            }
                                                        }
                                                        else if (!string.IsNullOrEmpty(cor.CorrigendumDocDecrypted))
                                                        {
                                                            var corFile = !string.IsNullOrEmpty(cor.HashedFileName) ? cor.HashedFileName : cor.CorrigendumDoc;
                                                            var corName = !string.IsNullOrEmpty(cor.OriginalFileName) ? cor.OriginalFileName : cor.CorrigendumDocDecrypted;
                                                            <tr>
                                                                <td class="text-center font-weight-bold">@(cDocSr++)</td>
                                                                <td>@corName</td>
                                                                <td class="text-center">
                                                                    <button type="button" 
                                                                            class="btn btn-sm btn-outline-primary download-direct-file" 
                                                                            data-tender="@item.TenderNo" 
                                                                            data-project="@item.ProjectId" 
                                                                            data-file="@corFile" 
                                                                            data-name="@corName"
                                                                            title="Download @corName">
                                                                        <i class="fa fa-download"></i> Download
                                                                    </button>
                                                                </td>
                                                            </tr>
                                                        }
                                                    }
                                                </tbody>
                                            </table>
                                        }
                                    </td>
                                    @if (Model.IsAdminOrExecutive)
                                    {
                                        <td>
                                            <button type="button" 
                                                    class="btn btn-sm btn-success download-bidders-csv mb-1" 
                                                    data-id="@item.EncryptedId"
                                                    data-rawid="@item.Id"
                                                    data-tender="@item.TenderNo"
                                                    data-desc="@item.TenderDescription"
                                                    data-bidders="@item.ForeignBidderId"
                                                    title="Download Allowed Bidders as CSV">
                                                 <i class="fa fa-download mr-1"></i> Download CSV
                                            </button>
                                            <!-- <a href="/Admin/Bidder/ListOfUploadedDocs?tenderNo=@item.TenderNo" class="btn btn-sm btn-outline-info d-block">
                                                 <i class="fa fa-folder-open"></i> View Uploaded Docs
                                            </a> -->
                                        </td>
                                    }
                                    <td>@item.TenderStartDate</td>
                                    <td>@item.TenderClosingDate</td>
                                    <td>@item.TenderOpeningDate</td>
                                    @if (Model.IsAdminOrExecutive)
                                    {
                                    <td>@item.CreatedBy</td>
                                    <td>@item.CreatedDate</td>
                                    }
                                    <td>@item.LatestExtendedDate</td>
                                    @if (Model.IsAdminOrExecutive)
                                    {
                                    <td>@item.ModifiedBy</td>
                                    <td>@item.ModifiedDate</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p>No records has been added yet. Click 'Create New' to start adding.</p>
            }
        </div>
    </div>
</section>
@Html.AntiForgeryToken()
@section Scripts
{
    <script type="text/javascript" asp-append-version="true">
        $(document).on('click', '.download-direct-file', function (e) {
            e.preventDefault();

            var tenderNo = $(this).data('tender');
            var projectId = $(this).data('project');
            var fileName = $(this).data('file');
            var displayName = $(this).data('name');
            var $btn = $(this);
            var origHtml = $btn.html();

            $btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Downloading...');

            $.ajax({
                type: 'POST',
                url: "?handler=DownloadFileAjax",
                beforeSend: function (xhr) {
                    xhr.setRequestHeader("XSRF-TOKEN", $('input:hidden[name="__RequestVerificationToken"]').val());
                },
                data: {
                    tenderNo: tenderNo,
                    projectId: projectId,
                    fileName: fileName,
                    displayName: displayName
                },
                success: function (data) {
                    $btn.prop('disabled', false).html(origHtml);
                    if (data != null && data.success !== false) {
                        var filename = data.filename;
                        var bytes = Base64ToBytes(data.encdata);
                        var blob = new Blob([bytes], { type: "application/octet-stream" });

                        var isIE = false || !!document.documentMode;
                        if (isIE) {
                            window.navigator.msSaveBlob(blob, filename);
                        } else {
                            var url = window.URL || window.webkitURL;
                            var link = url.createObjectURL(blob);
                            var a = $("<a />");
                            a.attr("download", filename);
                            a.attr("href", link);
                            $("body").append(a);
                            a[0].click();
                            a.remove();
                            setTimeout(function () { url.revokeObjectURL(link); }, 1000);
                        }
                    } else {
                        var errMsg = (data && data.message) ? data.message : 'Invalid details or file not found !';
                        alert(errMsg);
                    }
                },
                error: function (xhr, status, error) {
                    $btn.prop('disabled', false).html(origHtml);
                    console.error('Download failed: ' + error);
                    alert('An error occurred while downloading the document.');
                }
            });
        });

        $(document).on('click', '.download-tender-zip, .genfile', function (e) {
            e.preventDefault();

            var Id = $(this).data('id');
            var $btn = $(this);
            var origHtml = $btn.html();

            $btn.addClass('disabled').html('<i class="fa fa-spinner fa-spin"></i> Downloading...');

            $.ajax({
                type: 'POST',
                url: "?handler=DownloadGenFile",
                beforeSend: function (xhr) {
                    xhr.setRequestHeader("XSRF-TOKEN", $('input:hidden[name="__RequestVerificationToken"]').val());
                },
                data: { Id: Id },
                success: function (data) {
                    $btn.removeClass('disabled').html(origHtml);
                    if (data != null && data.success !== false) {
                        var filename = data.filename;
                        var bytes = Base64ToBytes(data.encdata);
                        var blob = new Blob([bytes], { type: "application/octet-stream" });

                        var isIE = false || !!document.documentMode;
                        if (isIE) {
                            window.navigator.msSaveBlob(blob, filename);
                        } else {
                            var url = window.URL || window.webkitURL;
                            var link = url.createObjectURL(blob);
                            var a = $("<a />");
                            a.attr("download", filename);
                            a.attr("href", link);
                            $("body").append(a);
                            a[0].click();
                            a.remove();
                            setTimeout(function () { url.revokeObjectURL(link); }, 1000);
                        }
                    } else {
                        var errMsg = (data && data.message) ? data.message : 'Invalid details or file not found !';
                        alert(errMsg);
                    }
                },
                error: function (xhr, status, error) {
                    $btn.removeClass('disabled').html(origHtml);
                    console.error('Download failed: ' + error);
                    alert('An error occurred while preparing the download.');
                }
            });
        });

        $(document).on('click', '.download-bidders-csv', function (e) {
            e.preventDefault();
            var Id = $(this).attr('data-id');
            var rawId = $(this).data('rawid');
            var tenderNo = $(this).data('tender');
            var tenderDesc = $(this).data('desc');
            var bidders = $(this).data('bidders');
            var $btn = $(this);
            var origHtml = $btn.html();

            $btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Downloading...');

            $.ajax({
                type: 'POST',
                url: "?handler=DownloadBiddersCsv",
                beforeSend: function (xhr) {
                    xhr.setRequestHeader("XSRF-TOKEN", $('input:hidden[name="__RequestVerificationToken"]').val());
                },
                data: { 
                    Id: Id,
                    rawId: rawId,
                    tenderNo: tenderNo,
                    tenderDesc: tenderDesc,
                    bidders: bidders
                },
                success: function (data) {
                    $btn.prop('disabled', false).html(origHtml);
                    if (data != null && data.success !== false) {
                        var filename = data.filename;
                        var bytes = Base64ToBytes(data.encdata);
                        var blob = new Blob([bytes], { type: "text/csv;charset=utf-8;" });

                        var isIE = false || !!document.documentMode;
                        if (isIE) {
                            window.navigator.msSaveBlob(blob, filename);
                        } else {
                            var url = window.URL || window.webkitURL;
                            var link = url.createObjectURL(blob);
                            var a = $("<a />");
                            a.attr("download", filename);
                            a.attr("href", link);
                            $("body").append(a);
                            a[0].click();
                            a.remove();
                            setTimeout(function () { url.revokeObjectURL(link); }, 1000);
                        }
                    } else {
                        alert('Failed to download CSV: ' + (data ? data.message : 'Unknown error'));
                    }
                },
                error: function (xhr, status, error) {
                    $btn.prop('disabled', false).html(origHtml);
                    console.error('Download failed: ' + error);
                    alert('An error occurred while downloading the CSV.');
                }
            });
        });

        $('#tblDataTable').DataTable();

        function Base64ToBytes(base64) {
            var binary_string = window.atob(base64);
            var len = binary_string.length;
            var bytes = new Uint8Array(len);
            for (var i = 0; i < len; i++) {
                bytes[i] = binary_string.charCodeAt(i);
            }
            return bytes;
        }
    </script>
}