@page
@model WebForeignBidder.Pages.Admin.Bidder.AddTenderDocModel
@{
    ViewData["Title"] = "List Of Tenders";
    int serialNumber = 0;
}
@section Styles{
    <style>
        .card-title
        {
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
        }
    </style>
}
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12 col-sm-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title float-left font-weight-bold">Submision of Bids documents</h3>
                    </div>
                    <div class="card-body">
                        <div class="form-group col-md-4">
                            <label asp-for="ModelDto.TenderNo" class="col-form-label font-weight-bold">Select Tender/Reference No<span class="required">*</span></label>
                            <select asp-for="ModelDto.TenderNo" class="form-control" asp-items="ViewBag.TenderNos">
                                <option value="">-select-</option>
                            </select>
                            <span asp-validation-for="ModelDto.TenderNo" class="text-danger"></span>
                        </div>

                        <div class="alert alert-info py-2 mt-2">
                            <i class="fa fa-info-circle"></i> For <strong>Price Bid</strong>, only <strong>password-protected .pdf, .xls, .xlsx</strong> files are allowed.
                            For other document types, <strong>.zip, .rar, .pdf, .xlsx, .xls</strong> files are allowed (max 30MB per row). Max total rows: <strong>12</strong>.
                        </div>

                        <div class="card card-outline card-primary mt-3">
                            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                                <h5 class="card-title mb-0 text-white font-weight-bold">Upload Bid Documents</h5>
                                <div>
                                    <span id="docCountInfo" class="badge badge-light mr-2">Rows: 0 / 12</span>
                                    <button id="btnAddDocRow" type="button" class="btn btn-sm btn-success" data-toggle="tooltip" title="Add Row">
                                        <i class="fa fa-plus"></i> Add Row
                                    </button>
                                </div>
                            </div>
                            <div class="card-body p-3">
                                <form id="formTenderDocs" method="post" enctype="multipart/form-data">
                                    <table class="table table-bordered table-sm" id="tblTenderDocs">
                                        <thead class="thead-light">
                                            <tr>
                                                <th style="width: 60px;" class="text-center">Sr. No.</th>
                                                <th style="width: 25%;">Document Title<span class="text-danger">*</span></th>
                                                <th style="width: 20%;">Doc Type<span class="text-danger">*</span></th>
                                                <th style="width: 25%;">Document File<span class="text-danger">*</span></th>
                                                <th>Remarks</th>
                                                <th style="width: 70px;" class="text-center">Action</th>
                                            </tr>
                                        </thead>
                                        <tbody id="tenderDocsBody">
                                            <!-- Dynamic rows added via JS -->
                                        </tbody>
                                    </table>

                                    <div class="text-right mt-3">
                                        <button type="button" id="btnSubmitTenderDocs" class="btn btn-primary px-4 font-weight-bold">
                                            <i class="fa fa-upload"></i> Submit Bids Documents
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>

                        <!-- Uploaded Documents History Section -->
                        <div class="card card-outline card-secondary mt-4" id="uploadedDocsContainer" style="display:none;">
                            <div class="card-header">
                                <h5 class="card-title mb-0 font-weight-bold text-secondary">
                                    <i class="fa fa-folder-open"></i> Uploaded Documents History
                                </h5>
                            </div>
                            <div class="card-body p-2 table-responsive">
                                <table class="table table-striped table-bordered table-sm w-100" id="tblUploadedHistory">
                                    <thead class="thead-light">
                                        <tr>
                                            <th style="width: 60px;" class="text-center">Sr No.</th>
                                            <th>Document Title</th>
                                            <th>Doc Type</th>
                                            <th>File Name</th>
                                            <th>Remarks</th>
                                            <th>Uploaded Date</th>
                                            <th style="width: 130px;" class="text-center">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody id="uploadedHistoryBody">
                                        <!-- Populated via AJAX -->
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Toast Container -->
<div class="toast-container position-fixed top-0 end-0 p-3" id="toastContainer">
    <div id="validationToast" class="toast align-items-center text-white bg-danger border-0" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="10000">
        <div class="d-flex">
            <div class="toast-body">
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>
@Html.AntiForgeryToken()
@section Scripts
{
    <script type="text/javascript" src="~/js/custom/AddTenderDoc.js" asp-append-version="true"></script>
}