@section Styles{
    <style>
        .card-title
        {
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
        }
    </style>
}
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12 col-sm-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title float-left font-weight-bold">Submision of Bids documents</h3>
                    </div>
                    <div class="card-body">
                        <div class="form-group col-md-3">
                            <label asp-for="ModelDto.TenderNo" class="col-form-label">Select Tender/Reference No<span class="required">*</span></label>
                            <select asp-for="ModelDto.TenderNo" class="form-control" asp-items="ViewBag.TenderNos">
                                <option>-select-</option>
                            </select>
                            <span asp-validation-for="ModelDto.TenderNo" class="text-danger"></span>
                        </div>



                        <span class="text-warning pb-2 mt-2 ml-3">Each CV file should not exceed 20MB, except for Excel files, which can be up to 70MB. Allowed file formats: PDF and Excel. </span>
                        <div class="card-header" style="background-color: #ee3c3c;">
                            <h4 class="card-title float-left" style="color:white;">
                                <span>Upload CV Documents</span>
                                <button id="btnAddResCVFiles" type="button" class="btn btn-sm btn-primary btn-circle pull-right mt-2" data-toggle="tooltip" data-placement="top" title="Add New" style="float: right;">
                                    <i class="fa fa-plus"></i>
                                </button>
                            </h4>
                        </div>
                        <div class="body mt-3 p-3">

