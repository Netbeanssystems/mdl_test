                                <div class="col-md-1">
                                    <label class="w-100 mb-0">Sr. No.</label>
                                </div>
                                <div class="col-md-3">
                                    <label class="w-100 mb-0">Document Title</label>
                                </div>
                                <div class="col-md-2">
                                    <label class="w-100 mb-0">
                                        Document File
                                    </label>
                                </div>
                                <div class="col-md-3">
                                    <label class="w-100 mb-0">
                                        Remarks
                                    </label>
                                </div>
                                <div class="col-md-2">
                                    <label class="w-100 mb-0">
                                        Doc Type
                                    </label>
                                </div>
                                <div class="col-md-1 text-right">
                                    <label class="w-100 mb-0">Action</label>
                                </div>
                            </div>
